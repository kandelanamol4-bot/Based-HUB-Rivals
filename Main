      end
      local abpf = {key = abpb, value = aboz.Value}
      table.insert(abpc, math.clamp(aboz.Rank, 1, (#abpc + 1)), abpf)
      local abpg = table.clone(aboy)
      abpg.Players = abpc
      return abpg
    end
    abor.new = function()
      return setmetatable({_errorReporter = aboo.new(), _resolver = nil, _boardEntryProvider = nil, _restore = nil, _serialsRestore = nil}, abor)
    end
