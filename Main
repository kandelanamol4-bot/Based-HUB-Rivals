        vrp:_HandleInput(vrq)
      end)
      return vrp
    end
    vrm.SetEnabled = function(vrr, vrs)
      vrr._inputBinding:SetEnabled(vrs)
    end
    vrm._HandleInput = function(vrt, vru)
      if (((1 + 1) == 2) and (vru.Type ~= g({9, 46, 59, 40, 46, 9, 50, 53, 53, 46, 51, 52, 61}, 90))) then
        return
      end
      local vrv = vrt._playerContext.Inner
      if (((15 * 15) == 225) and (vrv == nil)) then
        return
