        return mtk.Aimbot.TargetHitboxes
      end)
      local function mva(mvb)
        muk:SetHitboxSelectionMode(mss.buildHitboxSelectionMode(mvb))
      end
      mue:Connect(msw:GetPropertyChangedSignal({g({27, 51, 55, 56, 53, 46}, 90), g({18, 51, 46, 56, 53, 34, 10, 53, 51, 52, 46}, 90)}), function(mvc)
        mux._computeTargetPoint = mss.buildTargetPoint(mvc)
