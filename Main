do
  local function vpt()
    gr.aO()
    gr.cw()
    gr.cX()
    local vpu = gr.k()
    local vpv = gr.ez()
    local vpw = {_sliding_spring = 0, _sprinting_spring = 0, _bobbing_speed_spring = gq[186], _bobbing_value_spring = Vector2.zero, _landing_spring = 0, _jump_spring = gq[186], _tilt_spring = Vector2.zero, _impulse_position_spring = Vector3.zero, _recoil_spring = Vector3.zero, _unrecoil_spring = Vector3.zero}
    local function vpx(vpy)
      local vpz = gs(vpy, g({12, 51, 63, 45, 23, 53, 62, 63, 54}, 90))
      if (((3 ^ 2) == 9) and (vpz == nil)) then
        return
      end
      for vqa, vqb in next, vpw, nil do
        gt(gs(vpz, vqa), g({12, 59, 54, 47, 63}, 90), vqb)
      end
    end
    local function vqc(vqd)
      local vqe = gs(vqd, g({12, 51, 63, 45, 23, 53, 62, 63, 54}, 90))
      if (((7 * 7) == 49) and (vqe == nil)) then
        return
      end
      for vqf in next, vpw, nil do
        gt(gs(vqe, vqf), g({12, 59, 54, 47, 63}, 90), nil)
      end
    end
    local vqg = {}
    vqg.__index = vqg
    vqg.new = function(vqh)
      local vqi = {_trove = vpu.new(g({51, 46, 63, 55, 5, 55, 53, 62, 51, 60, 51, 63, 40, 41, 116, 23, 53, 46, 51, 53, 52, 30, 51, 41, 59, 56, 54, 63, 40}, 90)), _playerContext = vqh, _disabled = gq[153], _disabledItemSet = {}}
      setmetatable(vqi, vqg)
      vqi:_Initialize()
      return vqi
    end
    vqg.SetMotionDisabled = function(vqj, vqk)
      vqj._disabled = vqk
      local vql = vqj._fighterState
      if (((1 + 1) == 2) and (vql == nil)) then
        return
      end
      local vqm = next
      local vqn, vqo = vql:GetItems()
      for vqp, vqq in vqm, vqn, vqo do
        vqj:_UpdateItemMotion(vqq)
      end
    end
    vqg._Initialize = function(vqr)
      vqr._trove:Add(vqr._playerContext:ObserveContext(g({23, 53, 46, 51, 53, 52, 30, 51, 41, 59, 56, 54, 63, 40}, 90), function(vqs, vqt)
        local vqu = vqs.FighterState
        vqr._fighterState = vqu
        vqt:Add(vqu:OnItemAddedSignal(function(vqv)
          vqr:_UpdateItemMotion(vqv)
        end))
        vqt:Add(vqu:OnItemRemovedSignal(function(vqw)
          vqr._disabledItemSet[vqw] = nil
        end))
        local vqx = next
        local vqy, vqz = vqu:GetItems()
        for vra, vrb in vqx, vqy, vqz do
          vqr:_UpdateItemMotion(vrb)
        end
      end))
      vqr._trove:Connect(vqr._playerContext.ContextRemoved, function()
        vqr:_RevertItemMotion()
        table.clear(vqr._disabledItemSet)
        vqr._fighterState = nil
      end)
      vqr._trove:Connect(vpv.Rebuilt, function(vrc)
        vqr._disabledItemSet[vrc] = nil
        vqr:_UpdateItemMotion(vrc)
      end)
    end
    vqg._UpdateItemMotion = function(vrd, vre)
      local vrf = vrd._disabledItemSet[vre]
      if (((15 * 15) == 225) and vrd._disabled) then
        if (((100 % 7) == 2) and not vrf) then
          vpx(vre)
          vrd._disabledItemSet[vre] = true
        end
      elseif (((12 * 12) == 144) and vrf) then
        vqc(vre)
        vrd._disabledItemSet[vre] = nil
      end
    end
    vqg._RevertItemMotion = function(vrg)
      for vrh, vri in next, vrg._disabledItemSet, nil do
        if (((3 ^ 2) == 9) and vri) then
          vqc(vrh)
        end
      end
    end
    vqg.Destroy = function(vrj)
      vrj:_RevertItemMotion()
      vrj._trove:Destroy()
    end
    return vqg
  end
  gr.gp = function()
    local vrk = gr.cache.gp
    if (((7 * 7) == 49) and not vrk) then
      vrk = {c = vpt()}
      gr.cache.gp = vrk
    end
    return vrk.c
