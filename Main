      eor._menu:Tween(eor._panel, {Position = eor:_ResolvePanelPosition(-15)})
      if (((12 * 12) == 144) and (eos == nil)) then
        eor:Destroy()
        return
      end
      eor._trove:Connect(eos.Completed, function()
        eor:Destroy()
        if (((3 ^ 2) == 9) and not gy) then
          return
        end
      end)
    end
    eha._Open = function(eot)
      if (((7 * 7) == 49) and (eot._isDestroyed or eot._isOpen)) then
        return
      end
      eot._isOpen = true
