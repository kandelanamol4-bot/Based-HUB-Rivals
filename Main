            zbe:_SpawnBranch(zbu, zbv, zbw, (zbi * yzt.ChildThicknessFalloff), (zbj * yzt.ChildRadiusFalloff), (zbk + 1))
          end
          continue
        end
        break
      end
    end
    zaj.Update = function(zbx)
      local zby = (os.clock() - zbx._startT)
      if (((12 * 12) == 144) and (zby < zbx._holdTime)) then
        return
      end
