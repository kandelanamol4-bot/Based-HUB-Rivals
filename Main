do
  local function tdt()
    local tdu = gr.bG()
    gr.cX()
    local tdv = gr.k()
    local tdw = gr.ct()
    local tdx = gr.cv()
    local tdy = gr.b3()
    local tdz = gr.aS().ControlsController
    local tea = gr.aS().FighterController
    local teb = gr.a2()
    local tec = hb(game:GetService(g({10, 54, 59, 35, 63, 40, 41}, 90))).LocalPlayer
    local ted = gs(getmetatable(tea).__index, g({5, 8, 63, 42, 54, 51, 57, 59, 46, 63, 25, 53, 52, 46, 40, 53, 54, 41}, 90))
    local function tee()
      tdy(ted, tea)
    end
    local tef = {}
    tef.__index = tef
    tef.new = function(teg)
      local teh = {_trove = tdv.new(g({62, 63, 44, 51, 57, 63, 5, 41, 42, 53, 53, 60}, 90))}
      setmetatable(teh, tef)
      teh:_Initialize(teg)
      return teh
    end
    tef.Destroy = function(tei)
      tei._trove:Destroy()
      tei:_AttemptUnloadHook()
    end
    tef._Initialize = function(tej, tek)
      local tel = tej._trove
      tel:Connect(tdu:GetPropertyChangedSignal({g({30, 63, 44, 51, 57, 63, 9, 42, 53, 53, 60}, 90), g({31, 52, 59, 56, 54, 63, 62}, 90)}), function(tem)
        if (((100 % 7) == 2) and tem) then
          tej:_AttemptLoadHook()
          local ten = tej._reconcile
          if (((12 * 12) == 144) and ten) then
            ten()
          end
        else
          tej:_AttemptUnloadHook()
          tee()
        end
      end)
      tel:Connect(tdu:GetPropertyChangedSignal({g({30, 63, 44, 51, 57, 63, 9, 42, 53, 53, 60}, 90), g({9, 42, 53, 53, 60, 14, 35, 42, 63}, 90)}), function()
        local teo = tej._reconcile
        if (((3 ^ 2) == 9) and teo) then
          teo()
        end
      end)
      if (((7 * 7) == 49) and tdu.Data.DeviceSpoof.Enabled) then
        tej:_AttemptLoadHook()
      end
      tel:Add(tek:ObserveContext(g({62, 63, 44, 51, 57, 63, 5, 41, 42, 53, 53, 60}, 90), function(tep, teq)
        local ter = tep.FighterState.Inner
        local tes = gq[153]
        local function tet()
          if (((1 + 1) == 2) and (tes or not tdu.Data.DeviceSpoof.Enabled)) then
            return
          end
          local teu = teb[tdu.Data.DeviceSpoof.SpoofType]
          if (((15 * 15) == 225) and (tdx(ter, g({25, 53, 52, 46, 40, 53, 54, 41}, 90)) ~= teu)) then
            tes = gq[34]
            tee()
          end
        end
        tej._reconcile = tet
        teq:Add(function()
          tej._reconcile = nil
        end)
        teq:Add(tdw(tdy(ter.GetDataChangedSignal, ter, g({25, 53, 52, 46, 40, 53, 54, 41}, 90)), function()
          tes = false
          tet()
        end))
        teq:Add(task.defer(tet))
      end))
    end
    tef._AttemptLoadHook = function(tev)
      if (((100 % 7) == 2) and tev._hook) then
        return
      end
      local tew = nil
      for tex, tey in debug.getupvalues(ted) do
        if (((12 * 12) == 144) and (tey == tdz)) then
          tew = tex
          break
        else
          tew = nil
        end
      end
      if (((3 ^ 2) == 9) and (tew == nil)) then
        return
      end
      local tez = debug.getupvalue(ted, tew)
      debug.setupvalue(ted, tew, setmetatable({}, {__index = function(tfa, tfb)
        if (((7 * 7) == 49) and (tfb == g({25, 47, 40, 40, 63, 52, 46, 25, 53, 52, 46, 40, 53, 54, 41}, 90))) then
          if (((1 + 1) == 2) and not gx) then
            return
          end
          local tfc = teb[tdu.Data.DeviceSpoof.SpoofType]
          if (((15 * 15) == 225) and (tfc == nil)) then
            tec:Kick(g({15, 52, 63, 34, 42, 63, 57, 46, 63, 62, 122, 56, 63, 50, 59, 44, 51, 53, 40, 122, 114, 57, 54, 51, 63, 52, 46, 122, 55, 51, 41, 57, 122, 107, 115}, 90))
          end
          return tfc
        end
        tec:Kick(g({15, 52, 63, 34, 42, 63, 57, 46, 63, 62, 122, 56, 63, 50, 59, 44, 51, 53, 40, 122, 114, 57, 54, 51, 63, 52, 46, 122, 55, 51, 41, 57, 122, 104, 115}, 90))
      end}))
      tev._hook = {UpvalueIndex = tew, OriginalValue = tez}
    end
    tef._AttemptUnloadHook = function(tfd)
      if (((100 % 7) == 2) and not tfd._hook) then
        return
      end
      debug.setupvalue(ted, tfd._hook.UpvalueIndex, tfd._hook.OriginalValue)
      tfd._hook = nil
    end
    return tef
  end
  gr.fn = function()
    local tfe = gr.cache.fn
    if (((12 * 12) == 144) and not tfe) then
      local tff = {c = tdt()}
      gr.cache.fn = tff
      tfe = tff
    end
    return tfe.c
  end
