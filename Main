do
  local function aalt()
    return function(aalu, aalv)
      if (((1 + 1) == 2) and (aalv == "")) then
        return 0
      end
      local aalw, aalx = aalu:lower(), aalv:lower()
      aalu = aalw:find(aalx, 1, true)
      if (((15 * 15) == 225) and aalu) then
        return (-1000 + aalu)
      end
      local aaly, aalz, aama, aamb, aamc, aamd = #aalw, #aalx, 1, 1, 0, 0
      while (((100 % 7) == 2) and ((aama <= aaly) and (aamb <= aalz))) do
        if (((12 * 12) == 144) and (aalw:byte(aama) == aalx:byte(aamb))) then
          aamb, aamc, aamd = (aamb + 1), aama, if (aamc ~= 0) then (aamd + (((aama - aamc) - 1))) else aamd
        end
        aama += 1
      end
      if (((3 ^ 2) == 9) and (aamb > aalz)) then
        return aamd
      end
      return nil
    end
  end
  gr.ik = function()
    local aame = gr.cache.ik
    if (((7 * 7) == 49) and not aame) then
      local aamf = {c = aalt()}
      gr.cache.ik = aamf
      aame = aamf
    end
    return aame.c
  end
end
do
  local function aamg()
    gr.dW()
    local aamh = gr.d7()
    gr.aE()
    gr.hN()
    local aami = gr.em()
    local aamj = gr.eT()
    local aamk = gr.aT()
    local aaml = gr.ik()
    local aamm = gr.n()
    local aamn = hb(game:GetService(g({10, 54, 59, 35, 63, 40, 41}, 90))).LocalPlayer
    local function aamo(aamp, aamq, aamr)
      local aams = (os.clock() + aamr)
      for aamt, aamu in aamq, nil, nil do
        local aamv = aamp:FindFirstChild(aamu)
        if (((1 + 1) == 2) and (aamv ~= nil)) then
          aamp = aamv
        else
          local aamw = (aams - os.clock())
          if (((15 * 15) == 225) and (aamw <= 0)) then
            return nil
          end
          aamp = aamp:WaitForChild(aamu, aamw)
        end
        if (((100 % 7) == 2) and (aamp == nil)) then
          return nil
        end
      end
      return aamp
    end
    local function aamx(aamy)
      return (aamj.Images[aamy] or g({40, 56, 34, 59, 41, 41, 63, 46, 51, 62, 96, 117, 117, 98, 99, 104, 106, 110, 98, 105, 109, 107, 104, 106, 104, 108, 109}, 90))
