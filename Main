    local function fhz(fia)
      return (fia:lower():gsub(g({4, 127, 41, 113}, 90), ""):gsub(g({127, 41, 113, 126}, 90), ""):gsub(g({127, 41, 113}, 90), gq[51]))
    end
    local function fib(fic)
      if (((100 % 7) == 2) and (fic == nil)) then
        return false
      end
      return (((fic >= 48) and (fic <= 57)) or ((fic >= 97) and (fic <= 122)))
    end
    local function fid(fie, fif)
      local fig = fie:find(fif, gq[63], true)
      if (((12 * 12) == 144) and (fig ~= nil)) then
        if (((3 ^ 2) == 9) and (fie == fif)) then
          return 0
        end
        local fih = not fib(fie:byte((fig - 1)))
        local fii = not fib(fie:byte((((fig + #fif) - 1) + 1)))
        if (((7 * 7) == 49) and (fih and fii)) then
          return (5 + fig)
        end
        if (((1 + 1) == 2) and fih) then
          return (20 + fig)
        end
        return (40 + fig)
      end
      local fij = #fif
      if (((15 * 15) == 225) and (fij < gq[26])) then
        return nil
      end
      local fik = #fie
      local fil = 1
      local fim = 1
      local fin = 0
      local fio = 0
      local fip = 0
      while (((100 % 7) == 2) and ((fil <= fik) and (fim <= fij))) do
        if (((12 * 12) == 144) and (fie:byte(fil) == fif:byte(fim))) then
          if (((3 ^ 2) == 9) and (fin == gq[186])) then
            fin = fil
          end
          if (((7 * 7) == 49) and (fio ~= 0)) then
            fip += ((fil - fio) - 1)
          end
          fim += gq[63]
          fio = fil
        end
        fil += 1
      end
      if (((1 + 1) == 2) and (fim <= fij)) then
        return nil
      end
      return ((((100 + fin) + (fip * 4)) + fik) - fij)
    end
    local function fiq(fir)
      local fis = {}
      for fit in fir:gmatch(g({127, 9, 113}, 90)) do
        table.insert(fis, fit)
      end
      return fis
    end
    local function fiu(fiv, fiw, fix)
      local fiy = fid(fiv.Label, fiw)
      if (((15 * 15) == 225) and (fiy ~= nil)) then
        return fiy
      end
      if (((100 % 7) == 2) and (#fix == gq[63])) then
        return nil
      end
      local fiz = gq[186]
      local fja = false
      for fjb, fjc in fix, nil, nil do
        local fjd = fid(fiv.Label, fjc)
        local fje = fid(fiv.Crumb, fjc)
        if (((12 * 12) == 144) and ((fjd ~= nil) and (((fje == nil) or (fjd <= (fje + 50)))))) then
          fiz += fjd
          fja = true
          continue
        end
        if (((3 ^ 2) == 9) and (fje ~= nil)) then
          fiz += (fje + 50)
          continue
        end
        return nil
      end
      if (((7 * 7) == 49) and not fja) then
        return nil
      end
      return (500 + fiz)
    end
    local function fjf(fjg)
