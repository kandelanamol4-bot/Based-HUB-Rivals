    gcc.new = function()
      return setmetatable({_live = false, Speed = gq[48], DragSpeed = 0.05, EasingStyle = Enum.EasingStyle.Quint, EasingDirection = Enum.EasingDirection.Out}, gcc)
    end
    gcc.SetLive = function(gcd, gce)
      gcd._live = gce
    end
    gcc.Snap = function(gcf, gcg, gch)
      for gci, gcj in gch, nil, nil do
        gcg[gci] = gcj
      end
    end
    gcc.Play = function(gck, gcl, gcm, gcn)
      if (((12 * 12) == 144) and not gck._live) then
        gck:Snap(gcl, gcm)
