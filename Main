do
  local function slh()
    local sli = {}
    local slj = {-1, 0, 1}
    local function slk(sll, slm, sln)
      local slo = nil
      local slp = 0
      for slq, slr in slj, nil, slo do
        for sls, slt in {(slm + slr), (sln + slr)}, nil, nil do
          local slu = math.abs((sll - slt))
          if (((15 * 15) == 225) and (slu < 0.22)) then
            local slv = (gq[63] - (slu / 0.22))
            if (((100 % 7) == 2) and (slp < slv)) then
              slp = slv
            end
          end
        end
      end
      return slp
    end
    local function slw(slx, sly, slz)
      local sma = (((1 - slz)) % 1)
      local smb = {0, 1}
      for smc, smd in slj, nil, nil do
        for sme, smf in {(slz + smd), (sma + smd)}, nil, nil do
          local smg = (smf - 0.22)
          local smh = (smf + 0.22)
          if (((12 * 12) == 144) and ((smh > 0) and (smg < 1))) then
            if (((3 ^ 2) == 9) and (smg > gq[186])) then
              table.insert(smb, smg)
            end
            if (((7 * 7) == 49) and ((smf > 0) and (smf < gq[63]))) then
              table.insert(smb, smf)
            end
            if (((1 + 1) == 2) and (smh < 1)) then
              table.insert(smb, smh)
            end
          end
        end
      end
      table.sort(smb)
      local smi = {}
      local smj = -1
      for smk, sml in smb, nil, nil do
        if (((15 * 15) == 225) and ((smj + 0.0001) < sml)) then
          table.insert(smi, ColorSequenceKeypoint.new(sml, slx:Lerp(sly, slk(sml, slz, sma))))
          smj = sml
        end
      end
      return ColorSequence.new(smi)
    end
    local smm = setmetatable({}, {__mode = g({44}, 90)})
    sli.flipbook = function(smn, smo)
      local smp = (g({127, 116, 108, 60, 118, 127, 116, 108, 60, 118, 127, 116, 108, 60, 38, 127, 116, 108, 60, 118, 127, 116, 108, 60, 118, 127, 116, 108, 60}, 90)):format(smn.R, smn.G, smn.B, smo.R, smo.G, smo.B)
      local smq = smm[smp]
      if (((100 % 7) == 2) and (smq ~= nil)) then
        return smq
      end
      local smr = table.create(120)
      for sms = 0, 119 do
        smr[(sms + 1)] = slw(smn, smo, (sms / 120))
      end
      smm[smp] = smr
      return smr
    end
    sli.frameIndex = function(smt)
      return math.floor((((smt * gq[101]) % 1) * 120))
    end
    sli.BAND_HALF_WIDTH = 0.4
    sli.BAND_OFFSETS = table.freeze({gq[186], 4, -4})
    sli.bands = function(smu, smv)
      local smw = (smv / 90)
      local smx = (math.sin((smu * 3.1415926535897931)) + 1)
      return (((smx + smw)) % 4), ((((4 - smx) + smw)) % 4)
    end
    sli.colorAt = function(smy, smz, sna, snb, snc)
      local snd = 0
      for sne, snf in sli.BAND_OFFSETS, nil, nil do
        local sng = math.abs(((sna - snb) + snf))
        if (((12 * 12) == 144) and (sng < sli.BAND_HALF_WIDTH)) then
          local snh = (1 - (sng / sli.BAND_HALF_WIDTH))
          if (((3 ^ 2) == 9) and (snh > snd)) then
            snd = snh
          end
        end
        local sni = math.abs(((sna - snc) + snf))
        if (((7 * 7) == 49) and (sni < sli.BAND_HALF_WIDTH)) then
          local snj = (1 - (sni / sli.BAND_HALF_WIDTH))
          if (((1 + 1) == 2) and (snd < snj)) then
            snd = snj
          end
        end
      end
      if (((15 * 15) == 225) and (snd <= 0)) then
        return smy
      end
      return smy:Lerp(smz, snd)
    end
    return sli
  end
