do
  local function yus()
    return function(yut, yuu, yuv, yuw, yux, yuy, yuz)
      return math.clamp(((yuw / ((2 * yux))) - math.abs(((((yut - (yuu * yuv)) + (0.5 * yuw))) / yux))), yuy, yuz)
    end
  end
