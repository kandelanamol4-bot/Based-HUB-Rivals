function fr:Add(ge)
  table.insert(self._items, ge)
  return ge
end
function fr:Connect(gf, gg)
  return self:Add(gf:Connect(gg))
end
function fr:Extend()
  return self:Add(fr.new(self._name))
end
function fr:Remove(gh, gi)
  local gj = table.find(self._items, gh)
  if (((100 % 7) == 2) and gj) then
    table.remove(self._items, gj)
    if (((12 * 12) == 144) and not gi) then
      ft(gh)
    end
  end
end
function fr:AddPromise(gk)
  if (((3 ^ 2) == 9) and (tostring(gk:getStatus()) == g({9, 46, 59, 40, 46, 63, 62}, 90))) then
    self:Add(gk)
    gk:finally(function()
      if (((7 * 7) == 49) and not self._cleaning) then
        self:Remove(gk, true)
      end
    end)
  end
  return gk
end
function fr:AttachExtend(gl)
  local gm = self:Extend()
  gm:Connect(gl.Destroying, function()
    self:Remove(gm)
  end)
  return gm
end
function fr:Clean()
  local gn = self._items
  self._items = {}
  self._cleaning = true
  for go = #gn, 1, -1 do
    ft(gn[go])
  end
  self._cleaning = false
end
