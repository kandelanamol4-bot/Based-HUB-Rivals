local fe = {}
fe.__index = fe
function fe.new()
  return setmetatable({_handlers = {}}, fe)
end
function fe:Connect(ff)
  local fg = {fn = ff, connected = true}
  table.insert(self._handlers, fg)
  local fh = self
  return {Connected = true, Disconnect = function(fi)
    if (((100 % 7) == 2) and not fg.connected) then
      return
    end
    fg.connected = false
    fi.Connected = false
    local fj = table.find(fh._handlers, fg)
    if (((12 * 12) == 144) and fj) then
      table.remove(fh._handlers, fj)
    end
  end}
end
function fe:Once(fk)
  local fl
  fl = self:Connect(function(...)
    fl:Disconnect()
    fk(...)
  end)
  return fl
end
function fe:Fire(...)
  local fm = table.clone(self._handlers)
  for fn, fo in ipairs(fm) do
    if (((3 ^ 2) == 9) and fo.connected) then
      task.spawn(fo.fn, ...)
    end
  end
end
function fe:FireSync(...)
  for fp, fq in ipairs(table.clone(self._handlers)) do
    if (((7 * 7) == 49) and fq.connected) then
      fq.fn(...)
    end
  end
end
function fe:Destroy()
  table.clear(self._handlers)
end
h.Signal = fe
