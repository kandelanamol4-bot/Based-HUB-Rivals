      if (((100 % 7) == 2) and (dus == nil)) then
        error(g({25, 53, 52, 46, 59, 51, 52, 63, 40, 116, 8, 63, 59, 54, 51, 32, 63, 96, 122, 41, 63, 57, 46, 51, 53, 52, 122, 50, 59, 41, 122, 52, 53, 122, 42, 59, 40, 63, 52, 46, 122, 40, 63, 41, 53, 54, 44, 63, 40}, 90))
      end
