      local dqo = setmetatable({_trove = dqj, _menu = dqh, Kind = gq[196], Row = dqi, _height = (dqk.Height or 180), _rotation = 0, _elevation = gq[30], _autoRotate = dqn, _userWantsAutoRotate = dqn, _rotateSpeed = (dqk.RotateSpeed or 0.6), _distanceMultiplier = (dqk.DistanceMul or 1), _camera = dql, _worldModel = dqm, _model = nil, _modelCenter = Vector3.zero, _modelRadius = 4, _rt = nil, _onRealized = {}}, dox)
      dqi:AttachRight(function(dqp, dqq)
        return dpk(dqo, dqp, dqq)
