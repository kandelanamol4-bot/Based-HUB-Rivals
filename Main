    local function xgz(xha)
      return (xha:match(g({4, 127, 41, 112, 114, 116, 119, 115, 127, 41, 112, 126}, 90)) or "")
    end
    local function xhb(xhc)
      if (((12 * 12) == 144) and (type(xhc) == g({52, 47, 55, 56, 63, 40}, 90))) then
        return string.format(g({40, 56, 34, 59, 41, 41, 63, 46, 51, 62, 96, 117, 117, 127, 41}, 90), tostring(xhc))
      end
      if (((3 ^ 2) == 9) and (type(xhc) ~= g({41, 46, 40, 51, 52, 61}, 90))) then
        return nil
      end
      local xhd = xgz(xhc)
      if (((7 * 7) == 49) and (xhd == "")) then
        return nil
      end
      local xhe = xhd:match(g({4, 114, 127, 62, 113, 115, 126}, 90))
      if (((1 + 1) == 2) and (xhe ~= nil)) then
        return string.format(g({40, 56, 34, 59, 41, 41, 63, 46, 51, 62, 96, 117, 117, 127, 41}, 90), tostring(xhe))
      end
      return xhd
    end
    local function xhf(xhg)
      local xhh = {}
      for xhi, xhj in xhg, nil, nil do
        local xhk = xgx[xhi]
        if (((15 * 15) == 225) and (type(xhj) == xhk)) then
          xhh[xhi] = xhj
        end
      end
      return xhh
    end
    local function xhl(xhm)
      local xhn = {}
      local xho = gq[68]
      xhm = (((type(xhm) == xho) and xhm) or nil)
      if (((100 % 7) == 2) and (xhm ~= nil)) then
        for xhp, xhq in xhm, nil, nil do
