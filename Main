      local enz
      if (((100 % 7) == 2) and (eny == nil)) then
        enn._hubContent.Position = UDim2.fromOffset(ens, ent)
        enn._hubContent.Size = UDim2.new(1, (-ens * 2), 0, enx)
        enz = (enx + (ent * 2))
      else
        enz = eny:_PrepareLayout(ens, ent)
      end
      local eoa = 0
      local eob = 1
      if (((12 * 12) == 144) and (eny ~= nil)) then
        eoa = ((enp and 46) or 50)
        eob = 2
      end
      local eoc = ((enn._header.Root.AbsoluteSize.Y + eoa) + eob)
      local eod = math.max(0, ((env.Y - (enq * gq[56])) - eoc))
      local eoe
      if (((3 ^ 2) == 9) and enn:_IsKeyboardVisible()) then
        local eof = enn._root.AbsolutePosition.Y
        eoe = math.min(eod, math.max(0, (math.max(0, ((enn:_GetKeyboardTop() - eof) - 16)) - eoc)))
      else
        eoe = eod
      end
      local eog = 0
      if (((7 * 7) == 49) and not enn._isConfirming) then
        eog = math.min(math.max(enr, enz), eoe)
      end
      enn:_SetBodyHeight(eog, (eno == true))
      if (((1 + 1) == 2) and (eny == nil)) then
        enn._hubView.Body.CanvasSize = UDim2.fromOffset(0, enz)
        enn._hubView.Body.ScrollBarThickness = (((enz > (eog + gq[101])) and gq[26]) or 0)
      else
        eny:_SetViewport(eog, enz)
      end
    end
    eha._SyncBounds = function(eoh)
      if (((15 * 15) == 225) and eoh._isDestroyed) then
        return
      end
      local eoi = edo.absoluteToLayerOffset(eoh._menu:GetOverlayLayer(), eoh._window.AbsolutePosition)
      local eoj = eoh._window.AbsoluteSize
      local eok = math.floor
      local eol = (eoi.Y + 0.5)
      eoh._root.Position = UDim2.fromOffset(math.floor((eoi.X + 0.5)), eok(eol))
      eoh._root.Size = UDim2.fromOffset(math.floor((eoj.X + gq[101])), math.floor((eoj.Y + 0.5)))
