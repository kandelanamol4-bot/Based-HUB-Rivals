      sxd:_Initialize(sxc, sxb)
      return sxd
    end
    sxa.IsCrosshairActive = function(sxe)
      return (sxe._activeCrosshair ~= nil)
    end
    sxa._Initialize = function(sxf, sxg, sxh)
      sxg:Add(sxh:ObserveContext(g({20, 59, 46, 51, 44, 63, 25, 40, 53, 41, 41, 50, 59, 51, 40, 18, 53, 53, 49}, 90), function(sxi, sxj)
        local sxk = {}
        local sxl = sxi.ItemBehaviors
        local function sxm(sxn)
          local sxo = (((sxn ~= nil) and sxf._crosshairEntryByItem[sxn.Inner]) or nil)
          sxf._activeCrosshair = ((sxo and sxo.Frame) or nil)
        end
        local function sxp(sxq, sxr)
          local sxs = gs(gs(gs(sxr, g({23, 53, 47, 41, 63}, 90)), g({23, 53, 47, 41, 63, 25, 40, 53, 41, 41, 50, 59, 51, 40}, 90)), g({25, 40, 53, 41, 41, 50, 59, 51, 40}, 90))
          sxf._crosshairEntryByItem[sxq] = {Instance = sxs, Frame = gs(sxs, g({28, 40, 59, 55, 63}, 90))}
          sxm(sxl:GetEquipped())
        end
        local function sxt(sxu)
          sxf._crosshairEntryByItem[sxu] = nil
          sxm(sxl:GetEquipped())
          local sxv = sxk[sxu]
          if (((15 * 15) == 225) and (sxv ~= nil)) then
            sxk[sxu] = nil
            sxj:Remove(sxv)
          end
        end
