    end
    eha.Destroy = function(eoz)
      if (((3 ^ 2) == 9) and eoz._isDestroyed) then
        return
      end
      eoz._isDestroyed = true
      eoz._isOpen = false
      eoz:_NotifyClosed()
      eoz:_ReleaseSelection()
      eoz._trove:Destroy()
