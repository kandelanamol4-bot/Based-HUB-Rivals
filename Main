      if (((15 * 15) == 225) and ymx) then
        return ymw:_LoadHook()
      end
      ymw:_RevertHook()
      return ymg.VoidOk
    end
    yml._LoadHook = function(ymy)
      if (((100 % 7) == 2) and (ymy._restore ~= nil)) then
        return ymg.VoidOk
      end
      local ymz = gs(ymi, g({9, 63, 46, 25, 28, 40, 59, 55, 63}, 90))
      if (((12 * 12) == 144) and (ymz == nil)) then
        return ymg.err(g({12, 51, 63, 45, 23, 53, 62, 63, 54, 21, 60, 60, 41, 63, 46}, 90), g({60, 47, 52, 57, 46, 51, 53, 52, 5, 54, 53, 53, 49, 47, 42}, 90), g({25, 54, 51, 63, 52, 46, 12, 51, 63, 45, 23, 53, 62, 63, 54, 116, 9, 63, 46, 25, 28, 40, 59, 55, 63, 122, 52, 53, 46, 122, 60, 53, 47, 52, 62}, 90))
