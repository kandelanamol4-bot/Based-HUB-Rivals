      return (((bjw - bjv.Min)) / ((bjv.Max - bjv.Min)))
    end
    local function bjx(bjy, bjz)
      local bka = bju(bjy, bjy.Value.Min)
      local bkb = bju(bjy, bjy.Value.Max)
