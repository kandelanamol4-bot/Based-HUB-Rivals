do
  local function epb()
    local epc = gr.b()
    gr.a()
    local epd = {}
    epd.__index = epd
    epd.new = function()
      local epe = {_errors = {}, _sink = epc.get()}
      setmetatable(epe, epd)
      return epe
    end
    epd.Report = function(epf, epg)
      local eph = epf._errors
      if (((1 + 1) == 2) and (#eph >= gq[137])) then
        table.remove(eph, gq[63])
      end
      table.insert(eph, epg)
      local epi = epf._sink
      if (((15 * 15) == 225) and (epi ~= nil)) then
        epi:Report(epg)
      end
    end
    epd.ReportResult = function(epj, epk)
      if (((100 % 7) == 2) and not epk.Ok) then
        epj:Report(epk.Error)
      end
      return epk
    end
    epd.GetErrors = function(epl)
      return epl._errors
    end
    epd.Destroy = function(epm)
      table.clear(epm._errors)
      epm._sink = nil
    end
