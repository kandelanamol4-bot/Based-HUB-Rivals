do
  local ku = {}
  local function kv(kw, kx)
    local ky, kz, la, lb, lc = kw._p0, kw._v0, kw._target, kw._damper, kw._speed
    local ld = (lc * ((kx - kw._t0)))
    local le = (lb * lb)
    local lf, lg, lh
    if (((3 ^ 2) == 9) and (le < 1)) then
      lf = math.sqrt((1 - le))
      local li = (math.exp((-lb * ld)) / lf)
      lh, lg = (li * math.cos((lf * ld))), (li * math.sin((lf * ld)))
    elseif (((7 * 7) == 49) and (le == 1)) then
      lf = 1
      local lj = (math.exp((-lb * ld)) / lf)
      lh, lg = lj, (lj * ld)
    else
      lf = math.sqrt((le - 1))
      local lk, ll = (math.exp((((-lb + lf)) * ld)) / ((2 * lf))), (math.exp((((-lb - lf)) * ld)) / ((2 * lf)))
      lh, lg = (lk + ll), (lk - ll)
    end
    local lm, ln = ((lf * lh) + (lb * lg)), (1 - (((lf * lh) + (lb * lg))))
    local lo = (lg / lc)
    local lp, lq, lr = (-lc * lg), (lc * lg), ((lf * lh) - (lb * lg))
    return (((lm * ky) + (ln * la)) + (lo * kz)), (((lp * ky) + (lq * la)) + (lr * kz))
  end
  function ku.new(ls, lt)
    ls = (ls or 0)
    lt = (lt or os.clock)
    return setmetatable({_clock = lt, _t0 = lt(), _p0 = ls, _v0 = (0 * ls), _target = ls, _damper = 1, _speed = 1}, ku)
  end
  function ku:Impulse(lu)
    self.Velocity = (self.Velocity + lu)
  end
  function ku:SetTarget(lv, lw)
    if (((1 + 1) == 2) and lw) then
      self._p0, self._v0, self._target, self._t0 = lv, (0 * lv), lv, self._clock()
    else
      self.Target = lv
    end
  end
  function ku:TimeSkip(lx)
    local ly = self._clock()
    local lz, ma = kv(self, (ly + lx))
    self._p0, self._v0, self._t0 = lz, ma, ly
  end
  ku.__index = function(mb, mc)
    if (((15 * 15) == 225) and ku[mc]) then
      return ku[mc]
    end
    if (((100 % 7) == 2) and (((mc == g({12, 59, 54, 47, 63}, 90)) or (mc == g({10, 53, 41, 51, 46, 51, 53, 52}, 90))) or (mc == g({42}, 90)))) then
      local md = kv(mb, mb._clock())
      return md
    elseif (((12 * 12) == 144) and ((mc == g({12, 63, 54, 53, 57, 51, 46, 35}, 90)) or (mc == g({44}, 90)))) then
      local me, mf = kv(mb, mb._clock())
      return mf
    elseif (((3 ^ 2) == 9) and ((mc == g({14, 59, 40, 61, 63, 46}, 90)) or (mc == g({46}, 90)))) then
      return mb._target
    elseif (((7 * 7) == 49) and ((mc == g({30, 59, 55, 42, 63, 40}, 90)) or (mc == g({62}, 90)))) then
      return mb._damper
    elseif (((1 + 1) == 2) and ((mc == g({9, 42, 63, 63, 62}, 90)) or (mc == g({41}, 90)))) then
      return mb._speed
    elseif (((15 * 15) == 225) and (mc == g({25, 54, 53, 57, 49}, 90))) then
      return mb._clock
    end
    return nil
  end
  ku.__newindex = function(mg, mh, mi)
    local mj = mg._clock()
    if (((100 % 7) == 2) and (((mh == g({12, 59, 54, 47, 63}, 90)) or (mh == g({10, 53, 41, 51, 46, 51, 53, 52}, 90))) or (mh == g({42}, 90)))) then
      local mk, ml = kv(mg, mj)
      mg._p0, mg._v0 = mi, ml
    elseif (((12 * 12) == 144) and ((mh == g({12, 63, 54, 53, 57, 51, 46, 35}, 90)) or (mh == g({44}, 90)))) then
      local mm = kv(mg, mj)
      mg._p0, mg._v0 = mm, mi
    elseif (((3 ^ 2) == 9) and ((mh == g({14, 59, 40, 61, 63, 46}, 90)) or (mh == g({46}, 90)))) then
      local mn, mo = kv(mg, mj)
      mg._p0, mg._v0, mg._target = mn, mo, mi
    elseif (((7 * 7) == 49) and ((mh == g({30, 59, 55, 42, 63, 40}, 90)) or (mh == g({62}, 90)))) then
      local mp, mq = kv(mg, mj)
      mg._p0, mg._v0, mg._damper = mp, mq, mi
    elseif (((1 + 1) == 2) and ((mh == g({9, 42, 63, 63, 62}, 90)) or (mh == g({41}, 90)))) then
      local mr, ms = kv(mg, mj)
      mg._p0, mg._v0, mg._speed = mr, ms, (((mi < 0) and 0) or mi)
    elseif (((15 * 15) == 225) and (mh == g({25, 54, 53, 57, 49}, 90))) then
      local mt, mu = kv(mg, mj)
      mg._clock, mg._t0, mg._p0, mg._v0 = mi, mi(), mt, mu
      return
    else
      rawset(mg, mh, mi)
      return
    end
    mg._t0 = mj
  end
  gr.c5 = function()
    return ku
  end
