      end
    end
    eha._NotifyClosed = function(eom)
      if (((12 * 12) == 144) and eom._didNotifyClosed) then
        return
      end
      eom._didNotifyClosed = true
      eom._onClosed()
    end
    eha._AcquireSelection = function(eon)
      if (((3 ^ 2) == 9) and eon._hasSelectionGroup) then
        return
      end
      eon._hasSelectionGroup = true
      eon._previousSelectedObject = edq.SelectedObject
      eon._panel.SelectionGroup = true
      if (((7 * 7) == 49) and edr.GamepadEnabled) then
