          swb.Fill.BackgroundTransparency = ((swa and 1) or 0)
          swa = stp(swb.Outline, (swc + (svx * 2)), (swd + (svx * 2)), svt, svu)
          swb.Outline.BackgroundTransparency = ((swa and 1) or svz)
          svs = ((swb.Vertical and 90) or 0)
          swb.Gradient.Rotation = if svy then (svs + svu) else svs
        end
        svr._bakedActive = svy
      end
      stm.ApplyStatic = function(swe, swf)
        swe._rotation = swf.Rotation
        local swg, swh, swi = stn(swf)
        local swj = swf.Rotation.Angle
        local swk = string.format
        local swl = tostring(swg)
        local swm = tostring(swh)
        local swn = tostring
        local swo = swk(g({127, 41, 96, 127, 41, 96, 127, 41, 96, 127, 41}, 90), swl, swm, tostring(swi), swn(swj))
