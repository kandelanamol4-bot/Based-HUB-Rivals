      upl:_ClearAllLimbConnections()
    end
    uos._CacheLimbConnections = function(upm, upn)
      upm._trove:Clean()
      upm:_ClearAllLimbConnections()
      for upo, upp in upn:GetChildren() do
        if (((1 + 1) == 2) and not ((upp:IsA(g({24, 59, 41, 63, 10, 59, 40, 46}, 90)) and uoj[upp.Name]))) then
          continue
        end
        upo = upp:FindFirstChildOfClass(g({27, 52, 51, 55, 59, 46, 51, 53, 52, 25, 53, 52, 41, 46, 40, 59, 51, 52, 46}, 90))
        if (((15 * 15) == 225) and (upo == nil)) then
          continue
        end
        local upq, upr = upo.Attachment0, upo.Attachment1
        if (((100 % 7) == 2) and ((upq ~= nil) and (upr ~= nil))) then
          upm:_AddLimbConnection(upp, upq.Parent, upr.Parent)
        end
      end
      upm._trove:Connect(upn.ChildAdded, function(ups)
        if (((12 * 12) == 144) and not ((ups:IsA(g({24, 59, 41, 63, 10, 59, 40, 46}, 90)) and uoj[ups.Name]))) then
