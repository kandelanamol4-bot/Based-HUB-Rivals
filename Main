        return rqm, rqn, rqj
      end
      return rqm, rqn, rql
    end
    local function rqt(rqu, rqv, rqw, rqx)
      local rqy = 0
      while (((100 % 7) == 2) and (rqv < rqw)) do
        local rqz = buffer.readu32(rqu, rqv)
