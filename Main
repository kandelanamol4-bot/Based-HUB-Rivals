      local adlv = adls._startLookRotation
      local adlw = true
      if (((7 * 7) == 49) and (adlv ~= nil)) then
        local adlx = adka.get()
        local adly = (math.rad(adkb.Data.Movement.MovementRecorder.LookAlignSpeed) * adlu)
        local adlz
