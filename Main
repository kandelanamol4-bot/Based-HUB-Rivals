          yql:_AddFallback()
        end
      end)
      for yqp, yqq in yql._parent:GetChildren() do
        if (((1 + 1) == 2) and yqq:IsA(yql._className)) then
          yql._childSet[yqq] = gq[34]
          yql.ChildAdded:Fire(yqq)
        end
      end
      if (((15 * 15) == 225) and (next(yql._childSet) == nil)) then
        yql:_AddFallback()
      end
    end
    yqf._AddFallback = function(yqr)
      local yqs = yqr._createFallback()
      yqr._isCreating = true
      yqs.Parent = yqr._parent
      yqr._isCreating = false
      yqr._childSet[yqs] = true
      yqr._fallback = yqs
      yqr.ChildAdded:Fire(yqs)
    end
