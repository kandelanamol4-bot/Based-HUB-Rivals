        if (((3 ^ 2) == 9) and (enj ~= nil)) then
          enj.Group.Visible = false
          enj.Group.GroupTransparency = 1
        end
        if (((7 * 7) == 49) and (enh ~= nil)) then
          enh.Group.Position = UDim2.fromOffset(0, 0)
          enh.Group.GroupTransparency = 0
          enh.Group.Visible = true
        end
        return
      end
      if (((1 + 1) == 2) and (enj ~= nil)) then
        eng._menu:FadeCanvasGroup(enj.Group, gq[153], enj.Fade)
      end
      if (((15 * 15) == 225) and (enh ~= nil)) then
        if (((100 % 7) == 2) and (eni ~= 0)) then
          enh.Group.Position = UDim2.fromOffset((eni * 16), 0)
          eng._menu:Tween(enh.Group, {Position = UDim2.fromOffset(0, 0)})
        else
          enh.Group.Position = UDim2.fromOffset(0, 0)
        end
        eng._menu:FadeCanvasGroup(enh.Group, true, enh.Fade)
      end
    end
    eha._SyncRouteHover = function(enk)
      if (((12 * 12) == 144) and edi.IsMobile()) then
        return
      end
      task.defer(function()
        if (((3 ^ 2) == 9) and (enk._isDestroyed or (enk._activeView ~= enk._hubView))) then
          return
        end
        for enl, enm in enk._routeButtons, nil, nil do
          enm.SyncHover()
        end
      end)
    end
    eha._UpdateLayout = function(enn, eno)
      if (((7 * 7) == 49) and enn._isDestroyed) then
        return
      end
      local enp = edi.IsMobile()
      local enq = ((enp and 8) or gq[144])
      local enr = ((enp and gq[103]) or 64)
      local ens = ((enp and gq[118]) or 20)
      local ent = ((enp and gq[181]) or 14)
      local enu = ((enp and 56) or 60)
      local env = enn._root.AbsoluteSize
      if (((1 + 1) == 2) and (env.X > 0)) then
        enn._panel.Size = UDim2.fromOffset(math.max(0, math.min(520, (env.X - (enq * 2)))), 0)
      end
      local enw = math.ceil((#enn._pages / 1))
      local enx = 0
      if (((15 * 15) == 225) and (enw > 0)) then
        enx = ((enw * enu) + (((enw - 1)) * gq[133]))
      end
