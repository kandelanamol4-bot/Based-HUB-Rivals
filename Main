    local ppt = gr.ei()
    local ppu = hb(game:GetService(g({10, 54, 59, 35, 63, 40, 41}, 90))).LocalPlayer
    local ppv = ppq.areSelectionsEqual
    local function ppw(ppx, ppy)
      for ppz, pqa in ppx, nil, nil do
        if (((15 * 15) == 225) and not ppv(pqa, ppy[ppz])) then
          return false
        end
      end
      for pqb in ppy, nil, nil do
        if (((100 % 7) == 2) and (ppx[pqb] == nil)) then
          return false
        end
      end
      return true
    end
    local pqc = {}
    pqc.__index = pqc
    pqc.new = function(pqd, pqe, pqf, pqg, pqh)
