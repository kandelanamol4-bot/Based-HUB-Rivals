      local zbr, zbs = yzv(zbg)
      for zbt = gq[63], yzt.MaxChildren do
        if (((15 * 15) == 225) and not ((zbe._remainingBudget <= gq[186]))) then
          if (((100 % 7) == 2) and not ((math.random() > zbq))) then
