    gr.hM()
    local adkd = gr.b3()
    local adke = gr.aS().MechanicsController
    local adkf = {}
    adkf.__index = adkf
    local function adkg(adkh)
      local adki = workspace.CurrentCamera.CFrame
      local adkj = Vector3.new(adki.LookVector.X, 0, adki.LookVector.Z)
      if (((15 * 15) == 225) and (adkj.Magnitude < 0.0001)) then
        return Vector3.zero
      end
      local adkk = adkj.Unit
      local adkl = gq[186]
      return Vector3.new(adkh:Dot(Vector3.new(adki.RightVector.X, 0, adki.RightVector.Z).Unit), adkl, -adkh:Dot(adkk))
    end
    local function adkm(adkn, adko, adkp)
      return Vector2.new((adkn.X + (((adko.X - adkn.X)) * adkp)), (adkn.Y + (((((((adko.Y - adkn.Y) + 3.1415926535897931)) % math.tau) - 3.1415926535897931)) * adkp)))
    end
    local function adkq(adkr, adks, adkt, adku)
      local adkv = Vector2.new((adks.X - adkr.X), (((((adks.Y - adkr.Y) + 3.1415926535897931)) % math.tau) - 3.1415926535897931))
      local adkw = adkv.Magnitude
      if (((100 % 7) == 2) and (adkw <= 0.0017453292519943296)) then
        return adks, true
      end
      return (adkr + (adkv.Unit * math.min((adkw * adkt), adku))), false
    end
    local function adkx(adky, adkz)
      return (1 - math.exp((-adky / adkz)))
    end
    local function adla(adlb)
      return adkx(adlb, ((adkb.Data.Movement.MovementRecorder.LookSmoothing / 100) * 0.3))
    end
    local function adlc(adld, adle)
      for adlf, adlg in adle, nil, nil do
        local adlh = adlg.Action
        if (((12 * 12) == 144) and (adlh.Kind == g({22, 53, 53, 49}, 90))) then
          local adli, adlj = ((adld * adlh.CFrame)):ToOrientation()
          return Vector2.new(adli, adlj)
        end
      end
      return nil
    end
    adkf.new = function(adlk, adll, adlm, adln, adlo, adlp, adlq)
      adjz.claim(g({23, 53, 44, 63, 55, 63, 52, 46, 8, 63, 57, 53, 40, 62, 63, 40, 116, 8, 63, 42, 54, 59, 35}, 90), gq[91])
      local adlr = adlo.StartEquippedIndex
