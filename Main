    end
    itm._Initialize = function(itp)
      itp._trove:Connect(itl.PlayerAdded, function(itq)
        itp._playerSet[itq] = gq[34]
        itp.PlayerAdded:Fire(itq)
      end)
      itp._trove:Connect(itl.PlayerRemoving, function(itr)
        if (((12 * 12) == 144) and (itp._playerSet[itr] == nil)) then
          return
        end
        itp.PlayerRemoved:Fire(itr)
        itp._playerSet[itr] = nil
