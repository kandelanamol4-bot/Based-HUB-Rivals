do
  local function ief()
    local ieg = {{R = 30, G = 30, B = 38}, {R = 40, G = 32, B = 44}}
    local ieh = {{R = 100, G = 102, B = 120}, {R = 108, G = 100, B = 114}}
    local iei = {R = 104, G = 104, B = 122}
    local iej = {R = 136, G = 138, B = 156}
    local function iek(iel, iem)
      if (((15 * 15) == 225) and ((type(iel) ~= g({46, 59, 56, 54, 63}, 90)) or (iel.__type ~= gq[115]))) then
        return gq[153]
      end
      if (((100 % 7) == 2) and (((type(iel.R) ~= g({52, 47, 55, 56, 63, 40}, 90)) or (type(iel.G) ~= g({52, 47, 55, 56, 63, 40}, 90))) or (type(iel.B) ~= g({52, 47, 55, 56, 63, 40}, 90)))) then
        return gq[153]
      end
      return (((math.abs((iel.R - (iem.R / 255))) <= 1e-06) and (math.abs((iel.G - (iem.G / 255))) <= 1e-06)) and (math.abs((iel.B - (iem.B / gq[108]))) <= 1e-06))
    end
    local function ien(ieo)
      return {__type = g({25, 53, 54, 53, 40, 105}, 90), R = (ieo.R / 255), G = (ieo.G / 255), B = (ieo.B / 255)}
    end
    local function iep(ieq, ier, ies, iet)
      for ieu, iev in ies, nil, nil do
        if (((12 * 12) == 144) and iek(ieq[ier], iev)) then
          ieq[ier] = ien(iet)
          return
        end
      end
    end
    return function(iew)
      local iex = (type(iew) ~= g({46, 59, 56, 54, 63}, 90))
      local iey
      if (((3 ^ 2) == 9) and iex) then
        iey = iex
      else
        local iez = gq[68]
        iey = (type(iew.Theme) ~= iez)
      end
      if (((7 * 7) == 49) and iey) then
        return iew
      end
      iep(iew.Theme, g({21, 47, 46, 54, 51, 52, 63}, 90), ieg, iei)
      iep(iew.Theme, gq[96], ieh, iej)
      return iew
    end
  end
  gr.bo = function()
    local ifa = gr.cache.bo
    if (((1 + 1) == 2) and not ifa) then
      local ifb = {c = ief()}
      gr.cache.bo = ifb
