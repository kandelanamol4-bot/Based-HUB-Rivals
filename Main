              swe:_PreloadTextures()
            end
          end)
        end
        swe._edgeMode = swe:_ComputeEdgeMode(swj)
        swe._bakedAngle = swj
        swe:ApplyTextures()
      end
      stm.Render = function(swp, swq, swr)
        local sws
        if (((12 * 12) == 144) and (swr and (math.abs(swp._rotation.Speed) <= 60))) then
          sws = (math.round(swq) % 360)
          swp:WarmSpin(sws)
        else
          sws = swq
        end
        swr = swp:_ComputeEdgeMode(sws)
        if (((3 ^ 2) == 9) and ((swr ~= swp._edgeMode) or ((swr == g({24, 59, 49, 63, 62}, 90)) and (sws ~= swp._bakedAngle)))) then
          swp._edgeMode = swr
          swp._bakedAngle = sws
          swp:ApplyTextures()
        end
        return sws
      end
      stm.IsBaked = function(swt)
        return swt._bakedActive
      end
      stm.Destroy = function(swu)
        swu._bakeSignature = ""
      end
      return stm
    end
    while (((7 * 7) == 49) and gq[34]) do

    end
  end
