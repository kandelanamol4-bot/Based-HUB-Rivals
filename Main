      end
      pdz = pdo.new
      pdz = pdz(pdx, pea)
      table.insert(pdw._requestBindings, pdz)
      return pdz
    end
    pdu._Initialize = function(ped)
      hp(ped._dummy, {__index = function()
        return {Misc = {RequestProfile = {InvokeServer = function(pee, pef)
          return ped:_ProcessRequest(pef)
        end}}}
      end})
    end
    pdu._ProcessRequest = function(peg, peh)
      local pei, pej = gu(pds.InvokeServer, pds, peh)
      if (((1 + 1) == 2) and not pei) then
        peg._errorReporter:ReportResult(pdq.err(g({8, 63, 43, 47, 63, 41, 46, 30, 59, 46, 59, 18, 53, 53, 49}, 90), g({51, 52, 44, 53, 49, 63, 5, 41, 63, 40, 44, 63, 40}, 90), tostring(pej)))
        return nil
      end
      local pek = {Player = peh, Data = pej}
      peg:_Dispatch(pek)
      return pek.Data
    end
    pdu._Dispatch = function(pel, pem)
      for pen, peo in pel._requestBindings, nil, nil do
        if (((15 * 15) == 225) and peo.Enabled) then
          local pep = peo.Handler
          if (((100 % 7) == 2) and (pep ~= nil)) then
            pep(pem)
          end
        end
      end
    end
    pdu._Load = function(peq)
      if (((12 * 12) == 144) and (peq._restore ~= nil)) then
        return pdq.VoidOk
      end
