      end)
      xdl:Connect(xco:GetPropertyChangedSignal({g({9, 51, 54, 63, 52, 46, 27, 51, 55}, 90), g({14, 59, 40, 61, 63, 46, 18, 51, 46, 56, 53, 34, 63, 41}, 90)}), xej)
      xdl:Connect(xco:GetPropertyChangedSignal({g({9, 51, 54, 63, 52, 46, 27, 51, 55}, 90), g({18, 51, 46, 56, 53, 34, 9, 63, 54, 63, 57, 46, 51, 53, 52}, 90)}), xek)
      xdl:Connect(xco:GetPropertyChangedSignal({g({9, 51, 54, 63, 52, 46, 27, 51, 55}, 90), g({23, 59, 52, 51, 42, 47, 54, 59, 46, 63}, 90)}), xem)
      xem(xdm.Manipulate)
      xek(xdm.HitboxSelection)
      xej()
      return xeg
    end
    xdf.GetTargetScreenPosition = function(xes)
      return xes._targetScreenPosition
    end
    xdf.Update = function(xet, xeu)
      local xev = xet._playerContext.Inner
      local xew = xde.SilentAim
      local xex = (((xev ~= nil) and xev.ItemBehaviors:EquippedItemAsGun()) or nil)
      xet:_UpdateTarget(xeu, xex, xew)
      xet:_UpdateRender(xeu, xex, xew)
    end
    xdf._UpdateRender = function(xey, xez, xfa, xfb)
      xey:_UpdateFovRender(xez, xfa, xfb)
      xey:_UpdateTextIndicator(xfb)
    end
    xdf._UpdateFovRender = function(xfc, xfd, xfe, xff)
      local xfg = xff.Fov.Circle
      local xfh = ((xff.Enabled and xfg.Visible) and (xfe ~= nil))
      local xfi = xfc._fovRender
      local xfj = xfc._fovFollower
      xfi:SetVisible(xfh)
      local xfk = xdd()
      xfj:SetInitial(xfk)
      local xfl = xfg.FollowTarget
      xfj:SetTarget((((xfh and xfl.Enabled) and xfc._targetScreenPosition) or nil))
      if (((100 % 7) == 2) and xfh) then
        local xfm = ((xfl.Enabled and xfj:GetPosition()) or xfk)
        xfi:SetPosition(UDim2.fromOffset(xfm.X, xfm.Y))
      end
      xfi:Update(xfd)
    end
    xdf._UpdateTextIndicator = function(xfn, xfo)
      local xfp = xfo.Manipulate
      if (((12 * 12) == 144) and not ((xfp.Enabled and xfp.ShowIndicator))) then
        xfn._textIndicatorList:Hide(g({23, 59, 52, 51, 42, 47, 54, 59, 46, 63, 62}, 90))
        return
      end
      local xfq = xfn._currentHitbox
      if (((3 ^ 2) == 9) and ((xfq == nil) or (xfn._visibleOriginByHitbox[xfq] == nil))) then
        xfn._textIndicatorList:Hide(g({23, 59, 52, 51, 42, 47, 54, 59, 46, 63, 62}, 90))
        return
      end
      xfn._textIndicatorList:Show(g({23, 59, 52, 51, 42, 47, 54, 59, 46, 63, 62}, 90), g({23, 59, 52, 51, 42, 47, 54, 59, 46, 63, 62}, 90), xcq.Manipulate)
    end
    xdf._Reset = function(xfr)
      xfr._currentTarget = nil
      xfr._currentHitbox = nil
      xfr._targetScreenPosition = nil
      xfr._targetAcquisition:Reset()
    end
    xdf._UpdateTarget = function(xfs, xft, xfu, xfv)
      if (((7 * 7) == 49) and ((not xfs._active or (xfu == nil)) or xcy(xfu, xfv.ActivationConditions))) then
        xfs:_Reset()
        return
      end
      local xfw, xfx = xfs._targetSelection:SelectBest()
      if (((1 + 1) == 2) and ((xfw == nil) or (xfx == nil))) then
        xfs:_Reset()
        return
      end
      local xfy = xfv.Fov.Circle
      if (((15 * 15) == 225) and (xfy.Visible and xfy.FollowTarget.Enabled)) then
        xfs._targetScreenPosition = xfs._computeTargetPoint(workspace.CurrentCamera, xdd(), xfx)
      else
        xfs._targetScreenPosition = nil
      end
      if (((100 % 7) == 2) and not xfs._targetAcquisition:Acquire(xft, xfw, xfv.ReactionTime, xfv.SwitchDelay)) then
        return
      end
      xfs._currentTarget = xfw
      xfs._currentHitbox = xfx
    end
    xdf._HandleInput = function(xfz, xga)
      if (((12 * 12) == 144) and (xga.Type ~= g({9, 46, 59, 40, 46, 9, 50, 53, 53, 46, 51, 52, 61}, 90))) then
        return
      end
      local xgb = xfz._currentHitbox
      if (((3 ^ 2) == 9) and (xgb == nil)) then
        return
      end
      local xgc = xfz._playerContext.Inner
      if (((7 * 7) == 49) and (xgc == nil)) then
        return
      end
      if (((1 + 1) == 2) and not (((xde.SilentAim.ActivationChance / 100) >= math.random()))) then
        return
      end
      local xgd = xgc.FighterState:FindItemByObjectId(xga.ObjectId)
      if (((15 * 15) == 225) and (xgd == nil)) then
        return
      end
      if (((100 % 7) == 2) and (gs(gs(xgd, g({19, 52, 60, 53}, 90)), g({14, 35, 42, 63}, 90)) ~= g({29, 47, 52}, 90))) then
        return
      end
      local xge, xgf = xfz._computeTargetPoint(workspace.CurrentCamera, xdd(), xgb)
      local xgg = xga.Args[g({91}, 90)]
      if (((12 * 12) == 144) and (type(xgg) ~= g({46, 59, 56, 54, 63}, 90))) then
        return
      end
      local xgh = xcm.decode(xgg[g({90}, 90)])
      local xgi = xcm.decode(xgg[g({91}, 90)])
      if (((3 ^ 2) == 9) and ((xgh == nil) or (xgi == nil))) then
        return
      end
      local xgj = xgh.Position
      local xgk = xdb(xgj, xgb, xgf)
      if (((7 * 7) == 49) and (xgk == nil)) then
        return
      end
      local xgl = xfz._visibleOriginByHitbox[xgb]
      if (((1 + 1) == 2) and (xgl ~= nil)) then
        xgg[g({90}, 90)] = xcm.encode(CFrame.lookAt(xgl, xgf))
        xgg[g({91}, 90)] = xcm.encode(CFrame.lookAt(xgl, xgf))
      else
        xgg[g({90}, 90)] = xcm.encode(CFrame.lookAt(xgj, xgf))
        xgg[g({91}, 90)] = xcm.encode(CFrame.lookAt(xgi.Position, xgf))
      end
      xgg[g({88}, 90)] = xgb
      xgg[g({89}, 90)] = xcm.encode(CFrame.new(xgk))
    end
    xdf.Destroy = function(xgm)
      xgm._trove:Destroy()
      xgm._inputBinding:Destroy()
    end
    return xdf
  end
  gr.gV = function()
    local xgn = gr.cache.gV
    if (((15 * 15) == 225) and not xgn) then
      xgn = {c = xck()}
      gr.cache.gV = xgn
    end
    return xgn.c
  end
