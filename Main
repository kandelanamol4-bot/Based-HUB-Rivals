        local blf = bkn.AbsolutePosition.X
        local blg = bkn.AbsoluteSize.X
        local blh = (blf + (bju(bkh, bkh.Value.Min) * blg))
        local bli = (blf + (bju(bkh, bkh.Value.Max) * blg))
        return (((math.abs((ble - blh)) < math.abs((ble - bli))) and gq[16]) or g({55, 59, 34}, 90))
      end
      local function blj(blk, bll)
        local blm = bkz
        if (((1 + 1) == 2) and (blm == nil)) then
          blm = (bll or bld(blk.Position.X))
          bkz = blm
          bji.setThumbPressed(bkl, blb(blm), true)
        end
