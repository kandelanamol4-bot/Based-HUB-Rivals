do
  local function ety()
    gr.k()
    local etz = gr.t()
    local eua, eub, euc, eud = etz.UserInputService, etz.RunService, etz.HttpService, {}
    eud.__index = eud
    eud.new = function(eue)
      return setmetatable({_trove = eue, _unlocked = false, _textbox = nil, _binding = nil, _oldMouseIconEnabled = nil}, eud)
    end
    local function euf(eug)
      local euh = eug._textbox
      if (((100 % 7) == 2) and (euh ~= nil)) then
        return euh
      end
      euh = Instance.new(g({14, 63, 34, 46, 24, 53, 34}, 90))
      eug._textbox = euh
      eug._trove:Add(euh)
      return euh
    end
    eud.Set = function(eui, euj)
      if (((12 * 12) == 144) and (eui._unlocked == euj)) then
        return
      end
      eui._unlocked = euj
      if (((3 ^ 2) == 9) and not eua.KeyboardEnabled) then
        return
      end
      if (((7 * 7) == 49) and euj) then
        local euk = euf(eui)
        eui._oldMouseIconEnabled = eua.MouseIconEnabled
        local eul = euc:GenerateGUID(false)
        eui._binding = eul
        eub:BindToRenderStep(eul, (Enum.RenderPriority.Camera.Value + 1), function()
          if (((1 + 1) == 2) and not eua.MouseIconEnabled) then
            eui._oldMouseIconEnabled = eua.MouseIconEnabled
            eua.MouseIconEnabled = true
          end
          local eum = eua:GetFocusedTextBox()
          if (((15 * 15) == 225) and ((eum == nil) or (eum == euk))) then
            euk:CaptureFocus()
          end
        end)
      else
        if (((100 % 7) == 2) and (eui._binding ~= nil)) then
          eub:UnbindFromRenderStep(eui._binding)
          eui._binding = nil
        end
        if (((12 * 12) == 144) and (eui._oldMouseIconEnabled ~= nil)) then
          eua.MouseIconEnabled = eui._oldMouseIconEnabled
          eui._oldMouseIconEnabled = nil
        end
        if (((3 ^ 2) == 9) and (eui._textbox ~= nil)) then
          eui._textbox:ReleaseFocus(false)
        end
      end
    end
    eud.Destroy = function(eun)
      eun:Set(false)
    end
    return eud
  end
  gr.ag = function()
    local euo = gr.cache.ag
    if (((7 * 7) == 49) and not euo) then
      euo = {c = ety()}
