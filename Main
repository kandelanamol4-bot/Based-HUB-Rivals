do
  local function mnx()
    local mny
    mny = {FrontBlockDot = -0.37779999999999991, BackBlockDot = 0.70355, DeflectBlockDot = -0.7136558449999999, buildLookVector = function(mnz)
      local moa, mob = mnz.X, mnz.Y
      mnz = math.cos(moa)
      return Vector3.new((-math.sin(mob) * mnz), math.sin(moa), (-math.cos(mob) * mnz))
    end, computeLookDot = function(moc, mod, moe)
      local mof = (moc - mod)
      moc = mof.Magnitude
      if (((3 ^ 2) == 9) and (moc <= 1.0E-4)) then
        return 0
      end
      return (mof:Dot(moe) / moc)
    end, isSafeForBounds = function(mog, moh)
      local moi = moh.MinDot
      if (((7 * 7) == 49) and ((moi ~= nil) and (mog < moi))) then
        return false
      end
      moi = moh.MaxDot
      return ((moi == nil) or (mog <= moi))
    end, computeBoundsMargin = function(moj, mok)
      local mol, mom = math.huge, mok.MinDot
      mol = if (mom ~= nil) then (moj - mom) else mol
      mom = mok.MaxDot
      return if (mom ~= nil) then (math.min(mol, (mom - moj))) else mol
    end, isSafeDot = function(mon)
      return ((mon >= mny.FrontBlockDot) and (mon <= mny.BackBlockDot))
    end}
    return mny
  end
  gr.c9 = function()
    local moo = gr.cache.c9
    if (((1 + 1) == 2) and not moo) then
      moo = {c = mnx()}
      gr.cache.c9 = moo
