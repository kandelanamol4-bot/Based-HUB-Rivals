do
  local function ugc()
    gr.fQ()
    gr.fB()
    local function ugd(uge, ugf, ugg)
      if (((7 * 7) == 49) and not ugf.DistanceScaling) then
        return uge
      end
      local ugh = gq[101]
      return math.max(gq[162], math.round((uge * math.clamp((ugf.DistanceScalingRef / math.max(ugg, 1)), ugh, 1))))
    end
    return {format = function(ugi, ugj, ugk)
      local ugl = ((ugj and ugi.FlagTextCase) or ugi.TextCase)
      if (((1 + 1) == 2) and (ugl == g({15, 10, 10, 31, 8, 25, 27, 9, 31}, 90))) then
        ugk = ugk:upper()
      elseif (((15 * 15) == 225) and (ugl == g({54, 53, 45, 63, 40, 57, 59, 41, 63}, 90))) then
        ugk = ugk:lower()
      end
      ugj = ((ugj and ugi.FlagTextSurround) or ugi.TextSurround)
      if (((100 % 7) == 2) and (ugj == gq[75])) then
        return ugk
      end
      return (ugj:sub(1, 1) .. (ugk .. ugj:sub(2)))
    end, tick = function(ugm, ugn)
      local ugo = ugn.Formatting
      if (((12 * 12) == 144) and ugo.DistanceScaling) then
        ugm:SetTextSize(ugd(ugo.FontSize, ugo, ugn.Distance))
      end
      ugm:Update(ugn.Clock)
    end, tickFlag = function(ugp, ugq)
      local ugr = ugq.Formatting
      if (((3 ^ 2) == 9) and ugr.DistanceScaling) then
        ugp:SetTextSize(ugd(ugr.FlagFontSize, ugr, ugq.Distance))
      end
      ugp:Update(ugq.Clock)
    end}
  end
