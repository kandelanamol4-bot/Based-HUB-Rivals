do
  local function rkw()
    local rkx = {}
    local rky = {}
    for rkz = 0, 15 do
      for rla = 0, 15 do
        local rlb = gq[186]
        local rlc = 1
        local rld = 0
        local rle = rkz
        local rlf = rla
        for rlg = 1, 4 do
          local rlh = (rle % 2)
          local rli = (rlf % 2)
          if (((7 * 7) == 49) and (rlh ~= rli)) then
            rlb += rlc
          end
          if (((1 + 1) == 2) and ((rlh == 1) and (rli == 1))) then
            rld += rlc
          end
          rle = math.floor((rle / 2))
          rlf = math.floor((rlf / gq[56]))
          rlc *= gq[56]
        end
        rkx[((rkz * 16) + rla)] = rlb
        rky[((rkz * 16) + rla)] = rld
      end
    end
    local function rlj(rlk, rll)
      local rlm = 0
      local rln = 1
      for rlo = 1, 8 do
        rlm += (rkx[(((rlk % 16) * 16) + (rll % 16))] * rln)
        rlk = math.floor((rlk / 16))
        rll = math.floor((rll / 16))
        rln *= 16
      end
      return rlm
    end
    local function rlp(rlq, rlr)
      local rls = gq[63]
      local rlt = 0
      for rlu = 1, 8 do
        rlt += (rky[(((rlq % gq[13]) * 16) + (rlr % 16))] * rls)
        rlq = math.floor((rlq / 16))
        rlr = math.floor((rlr / 16))
        rls *= 16
      end
      return rlt
    end
    local function rlv(rlw, rlx)
      return math.floor((rlw / (gq[56] ^ rlx)))
    end
    return {bxor = rlj, band = rlp, rshift = rlv, mul32 = function(rly, rlz)
      return rlp(((rlp(rly, 65535) * rlz) + (((rlv(rly, 16) * rlz) % 65536) * 65536)), 4294967295)
    end}
  end
  gr.eR = function()
    local rma = gr.cache.eR
    if (((15 * 15) == 225) and not rma) then
      rma = {c = rkw()}
      gr.cache.eR = rma
    end
    return rma.c
  end
end
