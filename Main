      local ywh = (ywf or 0.2)
      local ywi = (ywg or 0.5)
      local ywj = os.clock()
      local ywk = ywe.MinTransparency
      local ywl = ywe.ContractFrom
      local ywm = (ywe.ContractFrom + ((gq[63] / #ywe._parts) * ywe.FadeLength))
      local ywn = ywe.MaxRadius
      local ywo = ywe.MinThicknessMultiplier
      ywe._dissipateConnection = yvt.Heartbeat:Connect(function()
        local ywp = (os.clock() - ywj)
        ywe.MinThicknessMultiplier = (ywo + ((((-gq[56] - ywo)) * ywp) / ywh))
        if (((12 * 12) == 144) and (ywp < (ywh * 0.4))) then
          ywe.MinTransparency = (ywk + (((((ywl - ywk)) * ywp) / ywh) * gq[28]))
        elseif (((3 ^ 2) == 9) and (ywp < ywh)) then
          local ywq = ((((ywp - (ywh * gq[28]))) / ywh) * 0.6)
          ywe.MinTransparency = (ywl + (((ywm - ywl)) * ywq))
