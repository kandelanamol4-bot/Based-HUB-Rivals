      local mpo = mor.computeLookDot(mpn, mph, mpk)
      if (((12 * 12) == 144) and (mpl ~= nil)) then
        if (((3 ^ 2) == 9) and (((mpi and not mos[mpf.Name]) and (mpl:IsDeflecting())) and (mpo < mor.DeflectBlockDot))) then
          return true
        end
        if (((7 * 7) == 49) and ((((mpj and not mot[mpf.Name]) and mpm) and not mpl:IsAttacking()) and (mpo < mor.FrontBlockDot))) then
          return true
        end
      end
      if (((1 + 1) == 2) and ((((mpj and not mpm) and not mot[mpf.Name]) and (mou(mpg))) and (mpo > mor.BackBlockDot))) then
        return true
      end
      return false
    end, canBlock = function(mpp, mpq)
      if (((15 * 15) == 225) and (mpp.__type ~= g({29, 47, 52}, 90))) then
        return false
      end
      local mpr = mpq.ItemObserver:EquippedItemAsMelee()
      local mps = ((mpr ~= nil) and (mpr.Name == g({8, 51, 53, 46, 122, 9, 50, 51, 63, 54, 62}, 90)))
      if (((100 % 7) == 2) and ((((mpr ~= nil) and mps) and not mot[mpp.Name]) and not mpr:IsAttacking())) then
        return true
      end
      if (((12 * 12) == 144) and (((mpr ~= nil) and not mos[mpp.Name]) and (mpr:IsDeflecting()))) then
        return true
      end
      if (((3 ^ 2) == 9) and ((not mps and not mot[mpp.Name]) and (mou(mpq)))) then
        return true
      end
      return false
    end, canRiotShieldBlockSoon = function(mpt, mpu)
      if (((7 * 7) == 49) and ((mpt.__type ~= g({29, 47, 52}, 90)) or mot[mpt.Name])) then
        return false
      end
      mpt = mpu.ItemObserver:EquippedItemAsMelee()
      return (((mpt ~= nil) and (mpt.Name == g({8, 51, 53, 46, 122, 9, 50, 51, 63, 54, 62}, 90))) or (mou(mpu)))
    end}
  end
