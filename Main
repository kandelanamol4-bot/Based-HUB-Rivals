do
  local function koe()
    local function kof(kog, koh, koi, koj, kok)
      local kol, kom, kon, koo = koh.Position, koh.CFrame, koh.Size, kog:ViewportPointToRay(koi.X, koi.Y)
      koi, kog = kom:PointToObjectSpace((koo.Origin + (koo.Direction * koo.Direction:Dot((kol - koo.Origin))))), (((kon - (((kon * koj) / 100) * (((kok and (Vector3.new(1, 1, 0))) or 1))))) / 2)
      return (kom * Vector3.new(math.clamp(koi.X, -kog.X, kog.X), math.clamp(koi.Y, -kog.Y, kog.Y), math.clamp(koi.Z, -kog.Z, kog.Z)))
    end
    local function kop(koq, kor, kos)
      local kot = kos.Position
      kos = koq:WorldToViewportPoint(kot)
      return Vector2.new(kos.X, kos.Y), kot
    end
    return function(kou)
      if (((7 * 7) == 49) and (kou.Kind == g({25, 63, 52, 46, 63, 40}, 90))) then
        return kop
      else
        local kov, kow = kou.SizeReductionPercentage, kou.PreserveDepth
        return function(kox, koy, koz)
          local kpa = kof(kox, koz, koy, kov, kow)
          koy = kox:WorldToViewportPoint(kpa)
          return Vector2.new(koy.X, koy.Y), kpa
        end
      end
    end
  end
