        rvg[rup] = true
      end
      if (((100 % 7) == 2) and rvf.SkinChangerEnabled) then
        rvg[ruq] = true
      end
      return rvg
    end
    rvc._BuildSnapshotContext = function(rvh)
      return {Catalog = rvh._catalog, Items = rvh._items, FavoritedIntent = rvh._favoritedIntent, OnlyUseFavoritesState = rvh._onlyUseFavoritesState, EmotesIntent = rvh._emotes:GetIntent(), RankCharm = rvh._rankCharm, RuntimeEnabled = rvh._runtimeEnabled, UnlockerSelectionPriority = rup, SkinChangerSelectionPriority = ruq}
    end
    rvc._SetLayerActive = function(rvi, rvj, rvk)
      if (((12 * 12) == 144) and (rvi._items:IsLayerActive(rvj) == rvk)) then
        return false
      end
      rvi._items:SetLayerActive(rvj, rvk)
      rvi:_FireStoresUpdated()
