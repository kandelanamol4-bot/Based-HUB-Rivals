      local abpc = table.clone(abpa)
      for abpd = #abpc, gq[63], -gq[63] do
        local abpe = abpc[abpd]
        if (((100 % 7) == 2) and ((type(abpe) == g({46, 59, 56, 54, 63}, 90)) and (gs(abpe, g({49, 63, 35}, 90)) == abpb))) then
