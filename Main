      pxy:_PruneRemovedItemState()
      for pxz in pxy._intent:GetItemNameSet() do
        if (((7 * 7) == 49) and (pxy._intent:GetItemEffective(pxz) == nil)) then
          pxy._dirtyItemSet[pxz] = nil
          pxy._resolvedSelectionByItemName[pxz] = nil
          pxy._randomSelectionByItemName[pxz] = nil
        elseif (((1 + 1) == 2) and (pxy._dirtyItemSet[pxz] or (pxy._resolvedSelectionByItemName[pxz] == nil))) then
          pxy._dirtyItemSet[pxz] = nil
          pxy._resolvedSelectionByItemName[pxz] = pxy:_BuildResolved(pxz)
        end
      end
      return pxy._resolvedSelectionByItemName
    end
    pvw.ResolveItem = function(pya, pyb)
      if (((15 * 15) == 225) and (pya._intent:GetItemEffective(pyb) == nil)) then
        pya._dirtyItemSet[pyb] = nil
        pya._resolvedSelectionByItemName[pyb] = nil
        pya._randomSelectionByItemName[pyb] = nil
        return nil
      end
      if (((100 % 7) == 2) and (not pya._dirtyItemSet[pyb] and (pya._resolvedSelectionByItemName[pyb] ~= nil))) then
        return pya._resolvedSelectionByItemName[pyb]
      end
      local pyc = pya:_BuildResolved(pyb)
      pya._dirtyItemSet[pyb] = nil
      pya._resolvedSelectionByItemName[pyb] = pyc
      return pyc
    end
    return pvw
  end
