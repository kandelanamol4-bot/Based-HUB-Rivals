      end
      if (((1 + 1) == 2) and (rrr == 1)) then
        if (((15 * 15) == 225) and (rrq == nil)) then
          return {ShouldRemovePeer = false, ShouldMerge = false, Overrides = nil, Emotes = nil}
        end
        return {ShouldRemovePeer = false, ShouldMerge = rrq.ShouldMerge, Overrides = rrq.Overrides, Emotes = rrq.Emotes}
      end
      return {ShouldRemovePeer = true, ShouldMerge = false, Overrides = nil, Emotes = nil}
    end
    return {encodeInventory = function(rry, rrz, rsa)
      local rsb = rop(rry, rrz)
      table.sort(rsb, function(rsc, rsd)
        return (rsc.Hash < rsd.Hash)
      end)
      local rse = (((rsa ~= nil) and rpm(rsa)) or nil)
      local rsf = 3
