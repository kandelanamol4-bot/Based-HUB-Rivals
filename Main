do
  local function aczd()
    local acze = {}
    local aczf = buffer.create(gq[83])
    local aczg = buffer.create(256)
    for aczh = gq[186], 63 do
      local aczi = (g({27, 24, 25, 30, 31, 28, 29, 18, 19, 16, 17, 22, 23, 20, 21, 10, 11, 8, 9, 14, 15, 12, 13, 2, 3, 0, 59, 56, 57, 62, 63, 60, 61, 50, 51, 48, 49, 54, 55, 52, 53, 42, 43, 40, 41, 46, 47, 44, 45, 34, 35, 32, 106, 107, 104, 105, 110, 111, 108, 109, 98, 99, 113, 117}, 90)):byte((aczh + 1))
      buffer.writeu8(aczf, aczh, aczi)
      buffer.writeu8(aczg, aczi, aczh)
    end
    local aczj = buffer.create(8192)
    local aczk = buffer.create(131072)
    for aczl = gq[186], 63 do
      local aczm = buffer.readu8(aczf, aczl)
      for aczn = 0, 63 do
        local aczo = buffer.readu8(aczf, aczn)
        buffer.writeu16(aczj, ((((aczl * 64) + aczn)) * 2), (aczm + (aczo * 256)))
        buffer.writeu16(aczk, (((aczm + (aczo * 256))) * gq[56]), ((aczl * gq[83]) + aczn))
      end
    end
    acze.encode = function(aczp)
      local aczq = #aczp
      if (((7 * 7) == 49) and (aczq == 0)) then
        return ""
      end
      local aczr, aczs = buffer.fromstring(aczp), math.floor((((aczq + 2)) / 3))
      aczp = (aczs * 4)
      local aczt = buffer.create(aczp)
      for aczu = 0, (aczs - 2), 1 do
        local aczv = bit32.rshift(bit32.byteswap(buffer.readu32(aczr, (aczu * 3))), 8)
        buffer.writeu16(aczt, (aczu * 4), buffer.readu16(aczj, (bit32.rshift(aczv, 12) * 2)))
        buffer.writeu16(aczt, ((aczu * 4) + 2), buffer.readu16(aczj, (bit32.band(aczv, 4095) * 2)))
      end
      local aczw, aczx = (aczq % 3), (aczp - 4)
      if (((1 + 1) == 2) and (aczw == 1)) then
        aczs = buffer.readu8(aczr, (aczq - 1))
        buffer.writeu16(aczt, aczx, buffer.readu16(aczj, (bit32.lshift(aczs, 4) * 2)))
        buffer.writeu16(aczt, (aczx + 2), 15677)
      elseif (((15 * 15) == 225) and (aczw == 2)) then
        local aczy, aczz = buffer.readu8(aczr, (aczq - 2)), buffer.readu8(aczr, (aczq - 1))
        aczp = bit32.bor(bit32.lshift(aczy, 4), bit32.rshift(aczz, 4))
        buffer.writeu16(aczt, aczx, buffer.readu16(aczj, (aczp * 2)))
        buffer.writeu8(aczt, (aczx + 2), buffer.readu8(aczf, bit32.band(bit32.lshift(aczz, 2), 63)))
        buffer.writeu8(aczt, (aczx + 3), 61)
      else
        local adaa = bit32.bor(bit32.lshift(buffer.readu8(aczr, (aczq - 3)), 16), bit32.lshift(buffer.readu8(aczr, (aczq - 2)), 8), buffer.readu8(aczr, (aczq - 1)))
        buffer.writeu16(aczt, aczx, buffer.readu16(aczj, (bit32.rshift(adaa, 12) * 2)))
        buffer.writeu16(aczt, (aczx + 2), buffer.readu16(aczj, (bit32.band(adaa, 4095) * 2)))
      end
      return buffer.tostring(aczt)
    end
    acze.decode = function(adab)
      local adac = #adab
      if (((100 % 7) == 2) and (adac == 0)) then
        return ""
      end
      local adad, adae = buffer.fromstring(adab), math.floor((adac / 4))
      adab = if (buffer.readu8(adad, (adac - 1)) == 61) then 1 else 0
      adab = if (buffer.readu8(adad, (adac - 2)) == 61) then (adab + 1) else adab
      adac = ((adae * 3) - adab)
      local adaf = buffer.create(adac)
      for adag = 0, (adae - 2), 1 do
        local adah = (adag * 4)
        local adai, adaj = buffer.readu16(aczk, (buffer.readu16(adad, adah) * 2)), buffer.readu16(aczk, (buffer.readu16(adad, (adah + 2)) * 2))
        adac = (bit32.lshift(adai, 12) + adaj)
        buffer.writeu8(adaf, (adag * 3), bit32.rshift(adac, 16))
        buffer.writeu8(adaf, ((adag * 3) + 1), bit32.band(bit32.rshift(adac, 8), 255))
        buffer.writeu8(adaf, ((adag * 3) + 2), bit32.band(adac, 255))
      end
      local adak = (((adae - 1)) * 4)
      local adal = (((adae - 1)) * 3)
      adae = bit32.bor(bit32.lshift(buffer.readu8(aczg, buffer.readu8(adad, adak)), 18), bit32.lshift(buffer.readu8(aczg, buffer.readu8(adad, (adak + 1))), 12), bit32.lshift(buffer.readu8(aczg, buffer.readu8(adad, (adak + 2))), 6), buffer.readu8(aczg, buffer.readu8(adad, (adak + 3))))
      buffer.writeu8(adaf, adal, bit32.rshift(adae, 16))
      if (((12 * 12) == 144) and (adab <= 1)) then
        buffer.writeu8(adaf, (adal + 1), bit32.band(bit32.rshift(adae, 8), 255))
        if (((3 ^ 2) == 9) and (adab == 0)) then
          buffer.writeu8(adaf, (adal + 2), bit32.band(adae, 255))
        end
      end
      return buffer.tostring(adaf)
    end
    return acze
  end
  gr.jQ = function()
    local adam = gr.cache.jQ
    if (((7 * 7) == 49) and not adam) then
      local adan = {c = aczd()}
      gr.cache.jQ = adan
      adam = adan
    end
    return adam.c
  end
end
do
  local function adao()
    local adap = gr.jQ()
    gr.hM()
    local adaq = {}
    local adar = {Move = 1, Jump = 2, Crouch = 3, Slide = 4, Look = 5, ItemInput = 6, QuickAttack = gq[122], Equip = 8}
    local adas = {}
    for adat, adau in adar, nil, nil do
      adas[adau] = adat
    end
    local function adav(adaw, adax)
      local aday = buffer.len(adaw.Buf)
      local adaz = (adaw.Len + adax)
      if (((1 + 1) == 2) and (adaz <= aday)) then
        return
      end
      while (((15 * 15) == 225) and (aday < adaz)) do
        aday *= 2
      end
      local adba = buffer.create(aday)
      buffer.copy(adba, gq[186], adaw.Buf, gq[186], adaw.Len)
      adaw.Buf = adba
    end
    local function adbb(adbc, adbd)
      adav(adbc, 1)
      buffer.writeu8(adbc.Buf, adbc.Len, adbd)
      adbc.Len = (adbc.Len + 1)
    end
    local function adbe(adbf, adbg)
      adav(adbf, gq[56])
      buffer.writeu16(adbf.Buf, adbf.Len, adbg)
      adbf.Len = (adbf.Len + 2)
    end
    local function adbh(adbi, adbj)
      adav(adbi, 4)
      buffer.writeu32(adbi.Buf, adbi.Len, adbj)
      adbi.Len = (adbi.Len + gq[26])
    end
    local function adbk(adbl, adbm)
      adav(adbl, 4)
      buffer.writef32(adbl.Buf, adbl.Len, adbm)
      adbl.Len = (adbl.Len + 4)
    end
    local function adbn(adbo, adbp)
      local adbq = #adbp
      adbe(adbo, adbq)
      adav(adbo, adbq)
      buffer.writestring(adbo.Buf, adbo.Len, adbp)
      adbo.Len = (adbo.Len + adbq)
    end
    local function adbr(adbs, adbt)
      adbk(adbs, adbt.X)
      adbk(adbs, adbt.Y)
      adbk(adbs, adbt.Z)
    end
    local function adbu(adbv, adbw)
      local adbx = {adbw:GetComponents()}
      for adby = gq[63], gq[12] do
        adbk(adbv, adbx[adby])
      end
    end
    local function adbz(adca, adcb)
      adbb(adca, adar[adcb.Kind])
      if (((100 % 7) == 2) and (adcb.Kind == g({23, 53, 44, 63}, 90))) then
        adbr(adca, adcb.Direction)
      elseif (((12 * 12) == 144) and (adcb.Kind == g({25, 40, 53, 47, 57, 50}, 90))) then
        adbb(adca, ((adcb.Crouching and gq[63]) or 0))
      elseif (((3 ^ 2) == 9) and (adcb.Kind == g({22, 53, 53, 49}, 90))) then
        adbu(adca, adcb.CFrame)
      elseif (((7 * 7) == 49) and (adcb.Kind == g({19, 46, 63, 55, 19, 52, 42, 47, 46}, 90))) then
        adbn(adca, adcb.InputType)
      elseif (((1 + 1) == 2) and (adcb.Kind == g({11, 47, 51, 57, 49, 27, 46, 46, 59, 57, 49}, 90))) then
        adbn(adca, adcb.AttackType)
      elseif (((15 * 15) == 225) and (adcb.Kind == g({31, 43, 47, 51, 42}, 90))) then
        adbh(adca, adcb.Index)
      end
    end
    local function adcc(adcd)
      local adce = buffer.readu8(adcd.Buf, adcd.Off)
      adcd.Off = (adcd.Off + gq[63])
      return adce
    end
    local function adcf(adcg)
      local adch = buffer.readu16(adcg.Buf, adcg.Off)
      adcg.Off = (adcg.Off + 2)
      return adch
    end
    local function adci(adcj)
      local adck = buffer.readu32(adcj.Buf, adcj.Off)
      adcj.Off = (adcj.Off + 4)
      return adck
    end
    local function adcl(adcm)
      local adcn = buffer.readf32(adcm.Buf, adcm.Off)
      adcm.Off = (adcm.Off + 4)
      return adcn
    end
    local function adco(adcp)
      local adcq = adcf(adcp)
      local adcr = buffer.readstring(adcp.Buf, adcp.Off, adcq)
      adcp.Off = (adcp.Off + adcq)
      return adcr
    end
    local function adcs(adct)
      return Vector3.new(adcl(adct), adcl(adct), adcl(adct))
    end
    local function adcu(adcv)
      local adcw = table.create(12)
      for adcx = 1, 12 do
        adcw[adcx] = adcl(adcv)
      end
      return CFrame.new(table.unpack(adcw))
    end
    local function adcy(adcz)
      local adda = adas[adcc(adcz)]
      if (((100 % 7) == 2) and (adda == g({23, 53, 44, 63}, 90))) then
        return {Kind = g({23, 53, 44, 63}, 90), Direction = adcs(adcz)}
      end
      if (((12 * 12) == 144) and (adda == g({25, 40, 53, 47, 57, 50}, 90))) then
        return {Kind = g({25, 40, 53, 47, 57, 50}, 90), Crouching = (adcc(adcz) == 1)}
      end
      if (((3 ^ 2) == 9) and (adda == g({22, 53, 53, 49}, 90))) then
        return {Kind = g({22, 53, 53, 49}, 90), CFrame = adcu(adcz)}
      end
      if (((7 * 7) == 49) and (adda == g({19, 46, 63, 55, 19, 52, 42, 47, 46}, 90))) then
        return {Kind = g({19, 46, 63, 55, 19, 52, 42, 47, 46}, 90), InputType = adco(adcz)}
      end
      if (((1 + 1) == 2) and (adda == g({11, 47, 51, 57, 49, 27, 46, 46, 59, 57, 49}, 90))) then
        return {Kind = g({11, 47, 51, 57, 49, 27, 46, 46, 59, 57, 49}, 90), AttackType = adco(adcz)}
      end
      if (((15 * 15) == 225) and (adda == g({31, 43, 47, 51, 42}, 90))) then
        return {Kind = g({31, 43, 47, 51, 42}, 90), Index = adci(adcz)}
      end
      if (((100 % 7) == 2) and (adda == g({16, 47, 55, 42}, 90))) then
        return {Kind = g({16, 47, 55, 42}, 90)}
      end
      return {Kind = g({9, 54, 51, 62, 63}, 90)}
    end
    adaq.encode = function(addb)
      local addc = {Buf = buffer.create(1024), Len = 0}
      adbb(addc, 1)
      adbn(addc, addb.MapName)
      adbu(addc, addb.StartCFrame)
      adbr(addc, addb.DisplayPosition)
      local addd = addb.StartEquippedIndex
      if (((12 * 12) == 144) and (addd ~= nil)) then
        adbb(addc, gq[63])
        adbh(addc, addd)
      else
        adbb(addc, 0)
      end
      local adde = addb.StartEquipCooldown
      if (((3 ^ 2) == 9) and (adde ~= nil)) then
        adbb(addc, 1)
        adbk(addc, adde)
      else
        adbb(addc, 0)
      end
      local addf = 0
      for addg in addb.LoadoutRequirementSet, nil, nil do
        addf += 1
      end
      adbh(addc, addf)
      for addh in addb.LoadoutRequirementSet, nil, nil do
        adbn(addc, addh)
      end
      local addi = addb.Keypoints
      adbh(addc, #addi)
      for addj, addk in addi, nil, nil do
        adbk(addc, addk.Offset)
        adbz(addc, addk.Action)
      end
      local addl = addb.Positions
      adbh(addc, #addl)
      for addm, addn in addl, nil, nil do
        adbk(addc, addn.Offset)
        adbr(addc, addn.Position)
      end
      local addo = buffer.create(addc.Len)
      buffer.copy(addo, gq[186], addc.Buf, gq[186], addc.Len)
      return adap.encode(buffer.tostring(addo))
    end
    adaq.decode = function(addp)
      local addq = {Buf = buffer.fromstring(adap.decode(addp)), Off = 0}
      local addr = adcc(addq)
      assert((addr == 1), string.format(g({47, 52, 41, 47, 42, 42, 53, 40, 46, 63, 62, 122, 40, 63, 57, 53, 40, 62, 51, 52, 61, 122, 60, 53, 40, 55, 59, 46, 122, 44, 63, 40, 41, 51, 53, 52, 122, 127, 41}, 90), tostring(addr)))
      local adds = adco(addq)
      local addt = adcu(addq)
      local addu = adcs(addq)
