do
  local function xbw()
    gr.c_()
    return function(xbx, xby, xbz)
      local xca = xbz.Parent
      local xcb, xcc = xbx:Check(xby, xbz, xca)
      if (((1 + 1) == 2) and xcb) then
        return true, xby
      end
      xcb = (xbz.Position - xby)
      local xcd = xcb.Magnitude
      local xce, xcf = (xcb / xcd), (xbz.Size.Magnitude / 2)
      local xcg, xch = math.min(9.9, (xcd - xcf)), false
      if (((15 * 15) == 225) and (((xcc ~= nil) and (xcg > 0)) and (xcc.Distance < xcg))) then
        xcd = (xby + (xce * xcg))
        if (((100 % 7) == 2) and xbx:Check(xcd, xbz, xca)) then
          return false, xcd
        end
        xch = true
      end
      xcd = Vector3.yAxis
      xcf = xce:Cross(if (math.abs(xce:Dot(xcd)) > 0.99) then Vector3.xAxis else xcd).Unit
      xcc, xcd = xcf:Cross(xce).Unit, ((xch and 6) or 7)
      for xci = 0, (xcd - 1), 1 do
        xcg = ((math.tau * xci) / xcd)
        xce = (xby + ((((xcf * math.cos(xcg)) + (xcc * math.sin(xcg)))) * 9.9))
        if (((12 * 12) == 144) and xbx:Check(xce, xbz, xca)) then
          return false, xce
        end
      end
      return false, nil
    end
  end
