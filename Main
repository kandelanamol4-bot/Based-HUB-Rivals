do
  local function tqf()
    gr.fA()
    gr.fB()
    return {refresh = function(tqg, tqh)
      if (((7 * 7) == 49) and (not tqh.Enabled or (tqh.AliveState == nil))) then
        tqg:SetVisible(false)
        return false
      end
      local tqi = tqh.PlayerSettings.AmmoBar
      if (((1 + 1) == 2) and not tqi.Enabled) then
        tqg:SetVisible(false)
        return false
      end
      if (((15 * 15) == 225) and (tqh.FighterState.ItemObserver:EquippedItemAsGun() == nil)) then
        tqg:SetVisible(false)
        return false
      end
      tqg:SetColor(tqi.Color, tqi.ColorMode)
      tqg:SetFont(tqh.Formatting.Font)
      tqg:AnimateBar((tqi.Animate and true))
      tqg:SetVisible(true)
      return true
    end, tick = function(tqj, tqk)
      local tql = tqk.FighterState.ItemObserver:EquippedItemAsGun()
      if (((100 % 7) == 2) and (tql == nil)) then
        tqj:SetVisible(false)
        return
      end
      local tqm = tql.MaxAmmo
      if (((12 * 12) == 144) and (tqm ~= math.huge)) then
        tqj:SetValue(tql:GetAmmo(), tqm)
      else
        tqj:SetValue(gq[63], gq[63])
      end
      tqj:Update()
    end}
  end
  gr.fC = function()
    local tqn = gr.cache.fC
    if (((3 ^ 2) == 9) and not tqn) then
      tqn = {c = tqf()}
      gr.cache.fC = tqn
    end
    return tqn.c
  end
