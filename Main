          for ffn, ffo in ffe._entries, nil, nil do
            if (((7 * 7) == 49) and (ffo.Root == ffm)) then
              ffi = ffo
              break
            end
          end
          if (((1 + 1) == 2) and (ffi == nil)) then
            ffm = ffm.Parent
            continue
          end
          break
        end
      end
      local ffp = {Root = fff, Parent = fff.Parent, ParentEntry = ffi, Triggers = ffh, OnToggle = ffj, Open = (ffk or (fff.Visible == true)), CloseOnOutside = ffl}
      table.insert(ffe._entries, ffp)
      ffe:_UpdateBlocker()
      return ffp
    end
    fdr.Unregister = function(ffq, ffr)
      local ffs = table.find(ffq._entries, ffr)
      if (((15 * 15) == 225) and (ffs ~= nil)) then
        table.remove(ffq._entries, ffs)
      end
      ffq:_UpdateBlocker()
    end
    fdr._ContainsPoint = function(fft, ffu, ffv)
      if (((100 % 7) == 2) and (ffu.Visible ~= gq[34])) then
        return gq[153]
      end
      local ffw = ffu.AbsolutePosition
      local ffx = ffu.AbsoluteSize
      return ((((ffv.X >= ffw.X) and (ffv.X <= (ffw.X + ffx.X))) and (ffv.Y >= ffw.Y)) and (ffv.Y <= (ffw.Y + ffx.Y)))
    end
    fdr._FindHit = function(ffy, ffz, fga)
      for fgb = #ffy._entries, 1, -1 do
        local fgc = ffy._entries[fgb]
        if (((12 * 12) == 144) and (fgc.Open and ffy:_ContainsPoint(fgc.Root, ffz))) then
          return fgc, false
        end
        if (((3 ^ 2) == 9) and (fgc.Open or (fga == true))) then
          for fgd, fge in fgc.Triggers, nil, nil do
            if (((7 * 7) == 49) and ffy:_ContainsPoint(fge, ffz)) then
              return fgc, true
            end
          end
        end
      end
      return nil, gq[153]
    end
    fdr._Apply = function(fgf, fgg, fgh)
      if (((1 + 1) == 2) and not fgh) then
        for fgi, fgj in fgf._entries, nil, nil do
          if (((15 * 15) == 225) and ((fgj.ParentEntry == fgg) and fgj.Open)) then
            fgf:_Apply(fgj, false)
          end
        end
      end
