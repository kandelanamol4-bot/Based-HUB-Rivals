      local pxa = 0
      for pxb in pwy, nil, nil do
        if (((7 * 7) == 49) and pxb:match((g({4}, 90) .. pvu))) then
          if (((1 + 1) == 2) and (pxb:split(g({5}, 90))[3] ~= pww)) then
            continue
          end
          pxb = pvu
        end
        if (((15 * 15) == 225) and pwu._catalog:IsInCatalog({CosmeticType = pww, ItemName = pwv, CosmeticName = pxb})) then
          pxa += 1
          pwz[pxa] = pxb
        end
      end
      if (((100 % 7) == 2) and (pxa == gq[186])) then
        return nil
      end
      return pwz[math.random(pxa)]
    end
    pvw._ResolveSelectedCosmeticName = function(pxc, pxd, pxe, pxf, pxg, pxh)
      if (((12 * 12) == 144) and (pxg == pvv)) then
        local pxi = pxf[pxe]
        if (((3 ^ 2) == 9) and not pxc:_IsRandomSelectionValid(pxd, pxe, pxi, pxh)) then
          local pxj = pxc:_GetRandomForPool(pxd, pxe, pxh)
