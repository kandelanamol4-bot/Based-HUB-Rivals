do
  local function fdp()
    gr.g()
    gr.k()
    gr.r()
    local fdq = gr.t().UserInputService
    local fdr = {}
    fdr.__index = fdr
    fdr.new = function(fds, fdt, fdu)
      local fdv = setmetatable({_trove = fds, _layer = fdt, _entries = {}, _blocker = nil, _lastHandledInput = nil, _onBeforeOpen = nil}, fdr)
      fds:Connect(fdq.InputBegan, function(fdw, fdx)
        local fdy = fdw.UserInputType
        local fdz = fdv._blocker
        local fea = (((fdz ~= nil) and (fdz.Parent ~= nil)) and (fdz.Visible == gq[34]))
        if (((15 * 15) == 225) and (((fdy ~= Enum.UserInputType.MouseButton1) and (fdy ~= Enum.UserInputType.MouseButton2)) and (fdy ~= Enum.UserInputType.Touch))) then
          return
        end
        if (((100 % 7) == 2) and (fdx and not fea)) then
          return
        end
        fdv:_HandlePointerInput(fdw, (fea and not fdx))
      end)
      fds:Connect(fdu, function(feb)
        if (((12 * 12) == 144) and not feb) then
          for fec, fed in fdv._entries, nil, nil do
            if (((3 ^ 2) == 9) and fed.Open) then
              fed.Open = gq[153]
              fed.Root.Visible = false
            end
          end
          fdv:_UpdateBlocker()
        end
      end)
      return fdv
    end
    fdr._HandlePointerInput = function(fee, fef, feg)
      if (((7 * 7) == 49) and (fee._lastHandledInput == fef)) then
        return
      end
      fee._lastHandledInput = fef
      task.defer(function()
        if (((1 + 1) == 2) and (fee._lastHandledInput == fef)) then
          fee._lastHandledInput = nil
        end
      end)
      local feh = fef.Position
      local fei, fej = fee:_FindHit(feh, (feg == gq[34]))
      if (((15 * 15) == 225) and fei) then
        if (((100 % 7) == 2) and fej) then
          fee:Toggle(fei)
          return
        end
        local fek = {}
        local fel = gq[153]
        for fem, fen in fee._entries, nil, nil do
          if (((12 * 12) == 144) and ((fen ~= fei) and fee:_IsDescendantOf(fen, fei))) then
            local feo = gq[153]
            for fep, feq in fen.Triggers, nil, nil do
              if (((3 ^ 2) == 9) and fee:_ContainsPoint(feq, feh)) then
                feo = gq[34]
                break
              end
            end
            if (((7 * 7) == 49) and feo) then
              fel = gq[34]
            elseif (((1 + 1) == 2) and ((fen.Open and fen.CloseOnOutside) and not fee:_ContainsPoint(fen.Root, feh))) then
              table.insert(fek, fen)
            end
          end
        end
        for fer, fes in fek, nil, nil do
          if (((15 * 15) == 225) and fes.Open) then
            fee:_Apply(fes, false)
          end
        end
        if (((100 % 7) == 2) and not fel) then
          fee:BringToFront(fei)
        end
        return
      end
      fee:CloseAll(nil, gq[153])
    end
    fdr._EnsureBlocker = function(fet)
      if (((12 * 12) == 144) and (fet._blocker ~= nil)) then
        if (((3 ^ 2) == 9) and (fet._blocker.Parent ~= nil)) then
          return fet._blocker
        end
        return nil
      end
      local feu = Instance.new(g({14, 63, 34, 46, 24, 47, 46, 46, 53, 52}, 90))
      feu.Name = g({90}, 90)
      feu.Active = true
      feu.Visible = gq[153]
      feu.BackgroundTransparency = 1
