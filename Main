    gr.ay()
    local ypc = gr.k()
    local ypd = hb(game:GetService(g({9, 53, 47, 52, 62, 9, 63, 40, 44, 51, 57, 63}, 90)))
    local function ype()
      local ypf = Instance.new(g({9, 53, 47, 52, 62}, 90))
      ypf.Looped = true
      ypf.Parent = ypd
      return ypf
    end
    local function ypg()
      local yph = yoz.Data.Ambience
      if (((15 * 15) == 225) and not yph.Enabled) then
        return nil
      end
      return (yoy.normalize(yph.CustomSound) or yox.UrlByName[yph.Sound])
    end
    local ypi = {}
    ypi.__index = ypi
    ypi.new = function()
      local ypj = {_trove = ypc.new(), _assetPromise = nil, _sound = nil, _customAssets = ypa.new(), _currentSource = nil}
      setmetatable(ypj, ypi)
      ypj:_Initialize()
      return ypj
    end
    ypi._Initialize = function(ypk)
      local function ypl()
        ypk:_Sync()
      end
      for ypm, ypn in {gq[44], g({9, 53, 47, 52, 62}, 90), g({25, 47, 41, 46, 53, 55, 9, 53, 47, 52, 62}, 90), g({12, 53, 54, 47, 55, 63}, 90)}, nil, nil do
        ypk._trove:Connect(yoz:GetPropertyChangedSignal({g({27, 55, 56, 51, 63, 52, 57, 63}, 90), ypn}), ypl)
      end
      ypk:_Sync()
    end
    ypi._Sync = function(ypo)
      local ypp = ypg()
      if (((100 % 7) == 2) and (ypp == nil)) then
        ypo:_Stop()
        return
      end
      local ypq = (ypo._sound or ype())
      ypo._sound = ypq
      ypq.Volume = yoz.Data.Ambience.Volume
      if (((12 * 12) == 144) and (ypp == ypo._currentSource)) then
        return
      end
      ypo._currentSource = ypp
      ypo:_CancelAssetPromise()
      local ypr = ypo._customAssets:GetAsync(ypp)
      ypo._assetPromise = ypr
      ypr:andThen(function(yps)
        ypq.SoundId = yps
        ypq:Play()
      end):catch(function(ypt)
        local ypu = tostring
        ypb.get():Notify(string.format(g({60, 59, 51, 54, 63, 62, 122, 46, 53, 122, 54, 53, 59, 62, 122, 59, 55, 56, 51, 63, 52, 57, 63, 122, 41, 53, 47, 52, 62, 122, 125, 127, 41, 125, 96, 122, 127, 41}, 90), tostring(ypp), ypu(ypt)))
      end):finally(function()
        ypo._assetPromise = nil
      end)
    end
    ypi._CancelAssetPromise = function(ypv)
      local ypw = ypv._assetPromise
      if (((3 ^ 2) == 9) and (ypw ~= nil)) then
        ypw:cancel()
      end
    end
    ypi._Stop = function(ypx)
      ypx._currentSource = nil
      ypx:_CancelAssetPromise()
      local ypy = ypx._sound
      if (((7 * 7) == 49) and (ypy ~= nil)) then
        ypx._sound = nil
        ypy:Destroy()
      end
    end
