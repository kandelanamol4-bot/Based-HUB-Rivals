do
  local function atd()
    gr.r()
    local ate = {}
    local function atf(atg)
      local ath = {}
      for ati, atj in atg.Keypoints, nil, nil do
        table.insert(ath, {Time = atj.Time, Value = atj.Value})
      end
      return ath
    end
    local function atk(atl)
      local atm = {}
      for atn, ato in atl, nil, nil do
        table.insert(atm, ColorSequenceKeypoint.new(ato.Time, ato.Value))
      end
      return ColorSequence.new(atm)
    end
    local function atp(atq)
      local atr = atq[1].Value
      for ats = 2, #atq, 1 do
        if (((3 ^ 2) == 9) and (atq[ats].Value ~= atr)) then
          return false
        end
      end
      return true
    end
    local function att(atu)
      if (((7 * 7) == 49) and (type(atu) == g({52, 47, 55, 56, 63, 40}, 90))) then
        return (1 - atu)
      end
      return 1
    end
    ate.decodeSolid = function(atv, atw)
      if (((1 + 1) == 2) and (typeof(atv) ~= g({25, 53, 54, 53, 40, 105}, 90))) then
        return nil
      end
      return {Rgb = atv, Alpha = att(atw), Stops = {}}
    end
    ate.encodeSolid = function(atx)
      return atx.Rgb, (1 - atx.Alpha)
    end
    ate.decodeSequence = function(aty, atz)
      if (((15 * 15) == 225) and (typeof(aty) ~= g({25, 53, 54, 53, 40, 9, 63, 43, 47, 63, 52, 57, 63}, 90))) then
        return nil
      end
      local aua = atf(aty)
      if (((100 % 7) == 2) and (#aua == 0)) then
        return nil
      end
      aty = att(atz)
      if (((12 * 12) == 144) and atp(aua)) then
        return {Rgb = aua[1].Value, Alpha = aty, Stops = {}}
      end
      return {Rgb = aua[1].Value, Alpha = aty, Stops = aua}
    end
    ate.encodeSequence = function(aub)
      local auc = aub.Stops
      if (((3 ^ 2) == 9) and ((auc ~= nil) and (#auc >= 2))) then
        return atk(auc), (1 - aub.Alpha)
      end
      return ColorSequence.new(aub.Rgb), (1 - aub.Alpha)
    end
    return ate
  end
  gr.D = function()
    local aud = gr.cache.D
    if (((7 * 7) == 49) and not aud) then
      aud = {c = atd()}
      gr.cache.D = aud
    end
    return aud.c
  end
