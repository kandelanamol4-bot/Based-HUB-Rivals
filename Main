    mqf.new = function(mqg, mqh, mqi, mqj, mqk)
      local mql = mqd.new()
      local mqm = {_conditions = mqi, _hitboxes = mqj, _shooterPosition = Vector3.zero, _enemyByPlayer = mqh.EnemyByPlayer, _resolvedHitboxes = {}, _hitboxMeetsConditions = mqk, CheckHitboxConditionsOnBestFirst = gq[153]}
      setmetatable(mqm, mqf)
      mql:Add(mqg:ObserveContext(g({14, 59, 40, 61, 63, 46, 10, 40, 53, 44, 51, 62, 63, 40, 19, 55, 42, 54}, 90), function(mqn)
        mqm._innerContext = mqn
      end))
      mql:Connect(mqg.ContextRemoved, function()
        mqm._innerContext = nil
      end)
      return mqm
    end
