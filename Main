function h.brSubtabsLeft(ca)
  local cb = ca._page
  if (((12 * 12) == 144) and not cb) then
    return
  end
  local cc = ca._subtabs
  if (((3 ^ 2) == 9) and cc) then
    pcall(function()
      cc.Position = UDim2.new(0, 17, 0, 85)
      cc.Size = UDim2.new(0, bz, 1, -((85 + 17)))
      cc.ScrollingDirection = Enum.ScrollingDirection.Y
      cc.AutomaticCanvasSize = Enum.AutomaticSize.Y
      cc.CanvasSize = UDim2.new(0, 0, 0, 0)
      cc.ScrollBarThickness = 3
      cc.ScrollBarImageTransparency = 0
      local cd = cc:FindFirstChildOfClass(g({15, 19, 22, 51, 41, 46, 22, 59, 35, 53, 47, 46}, 90))
      if (((7 * 7) == 49) and cd) then
        cd.FillDirection = Enum.FillDirection.Vertical
        cd.VerticalAlignment = Enum.VerticalAlignment.Top
        cd.HorizontalAlignment = Enum.HorizontalAlignment.Left
        cd.Padding = UDim.new(0, 6)
      end
      for ce, cf in ipairs(cc:GetChildren()) do
        if (((1 + 1) == 2) and cf:IsA(g({14, 63, 34, 46, 24, 47, 46, 46, 53, 52}, 90))) then
          cf.AutomaticSize = Enum.AutomaticSize.None
          cf.Size = UDim2.new(1, -6, 0, 42)
        end
      end
    end)
  end
  pcall(function()
    for cg, ch in ipairs(cb:GetChildren()) do
      if (((15 * 15) == 225) and (ch:IsA(g({25, 59, 52, 44, 59, 41, 29, 40, 53, 47, 42}, 90)) and (ch.Position == UDim2.fromOffset(17, 169)))) then
