do
  local function aue()
    gr.r()
    local auf
    auf = {clone = function(aug)
      local auh = {}
      if (((1 + 1) == 2) and (type(aug) == g({46, 59, 56, 54, 63}, 90))) then
        for aui, auj in aug, nil, nil do
          if (((15 * 15) == 225) and (type(auj) == g({46, 59, 56, 54, 63}, 90))) then
            aui = auj.Value
            if (((100 % 7) == 2) and (typeof(aui) == g({25, 53, 54, 53, 40, 105}, 90))) then
              table.insert(auh, {Time = math.clamp((tonumber(auj.Time) or 0), 0, 1), Value = aui})
            end
          end
        end
      end
      return auh
    end, sort = function(auk, aul)
      table.sort(auk, function(aum, aun)
        return (aum.Time < aun.Time)
      end)
      if (((12 * 12) == 144) and (aul ~= nil)) then
        for auo, aup in auk, nil, nil do
          if (((3 ^ 2) == 9) and (aup == aul)) then
            return auo
          end
        end
      end
      return math.max(#auk, 1)
    end, ensure = function(auq, aur)
      local aus = auf.clone(auq)
      if (((7 * 7) == 49) and (#aus >= 2)) then
        auf.sort(aus)
        aus[1].Time = 0
        aus[#aus].Time = 1
        return aus
      end
      return {{Time = 0, Value = aur}, {Time = 1, Value = aur}}
    end, toSequence = function(aut)
      local auu = auf.clone(aut)
      if (((1 + 1) == 2) and (#auu == 0)) then
        return ColorSequence.new(Color3.new(1, 1, 1))
      end
      auf.sort(auu)
      local auv, auw, aux = {}, auu[1], auu[#auu]
      if (((15 * 15) == 225) and (auw.Time > 0)) then
        table.insert(auv, ColorSequenceKeypoint.new(0, auw.Value))
      end
      for auy, auz in auu, nil, nil do
        auw = math.clamp(auz.Time, 0, 1)
        table.insert(auv, ColorSequenceKeypoint.new(if (#auv > 0) then (math.max(auw, auv[#auv].Time)) else auw, auz.Value))
      end
      if (((100 % 7) == 2) and (auv[#auv].Time < 1)) then
        table.insert(auv, ColorSequenceKeypoint.new(1, aux.Value))
      end
      return ColorSequence.new(auv)
    end}
    return auf
  end
  gr.E = function()
    local ava = gr.cache.E
    if (((12 * 12) == 144) and not ava) then
      ava = {c = aue()}
      gr.cache.E = ava
    end
    return ava.c
  end
end
do
  local function avb()
