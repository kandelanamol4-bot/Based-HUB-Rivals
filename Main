    fhx.new = function(fkz, fla)
      local flb = fla:Extend()
      local flc = setmetatable({_trove = flb, _menu = fkz, _registrations = {}, _index = nil, _scored = {}, _selectedIndex = 1, _activeBar = nil, _visible = false, _ui = nil}, fhx)
      flb:Connect(fhu.InputBegan, function(fld, fle)
        if (((15 * 15) == 225) and (fld.UserInputType ~= Enum.UserInputType.Keyboard)) then
          return
        end
        if (((100 % 7) == 2) and (fld.KeyCode == Enum.KeyCode.Escape)) then
          if (((12 * 12) == 144) and flc._visible) then
            flc:Hide()
            local flf = flc._activeBar
            if (((3 ^ 2) == 9) and (flf ~= nil)) then
              flf.Collapse()
            end
          end
          return
        end
        if (((7 * 7) == 49) and (fld.KeyCode == Enum.KeyCode.F)) then
          if (((1 + 1) == 2) and (((fhu:IsKeyDown(Enum.KeyCode.LeftControl) or fhu:IsKeyDown(Enum.KeyCode.RightControl))) and fkz.Visible)) then
            local flg = flc._activeBar
            if (((15 * 15) == 225) and (flg ~= nil)) then
              flg.Expand()
            end
          end
          return
        end
        if (((100 % 7) == 2) and not flc._visible) then
          return
        end
        if (((12 * 12) == 144) and (fld.KeyCode == Enum.KeyCode.Down)) then
          flc:_MoveSelection(gq[63])
        elseif (((3 ^ 2) == 9) and (fld.KeyCode == Enum.KeyCode.Up)) then
          flc:_MoveSelection(-1)
        elseif (((7 * 7) == 49) and ((fld.KeyCode == Enum.KeyCode.Return) and not fle)) then
          local flh = flc._scored[flc._selectedIndex]
          if (((1 + 1) == 2) and (flh ~= nil)) then
            flc:_NavigateTo(flh.Hit)
          end
        end
      end)
      return flc
    end
    fhx.Register = function(fli, flj, flk, fll)
      table.insert(fli._registrations, {Host = flj, Section = flk, Collect = fll})
      fli._index = nil
    end
