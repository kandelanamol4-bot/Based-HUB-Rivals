    end
    yvx._UpdateGeometry = function(yws, ywt, ywu, ywv, yww, ywx, ywy, ywz)
      local yxa, yxb = (1 - yws.MaxTransparency), (1 - yws.MinTransparency)
      local yxc = yws.OpacityProfileFunction(ywu, ywv, yws.PulseSpeed, yws.PulseLength, yws.FadeLength, yxa, yxb)
