do
  local function trt()
    local tru = gr.fD()
    gr.fb()
    local trv = {0, 0.5, 0.5, gq[63]}
    local trw = {0, 0.25, 0.75, 0.5}
    local trx = {}
    trx.__index = trx
    local function try(trz)
      local tsa = table.create(gq[26])
      local tsb = {}
      local tsc = Vector2.new(0, gq[186])
      local tsd = Vector2.new(1, gq[186])
      local tse = Vector2.new(gq[186], 1)
      local tsf = Vector2.new
      local tsg = gq[63]
      local tsh = gq[63]
      tsb[1] = tsc
      tsb[2] = tsd
      tsb[3] = tse
      do
        local tsi = table.pack(tsf(tsg, tsh))
        table.move(tsi, 1, tsi.n, 4, tsb)
      end
      local function tsj(tsk, tsl)
        local tsm = (((tsk.X == 0) and 1) or -gq[63])
        local tsn = (((tsk.Y == 0) and 1) or -1)
        local tso = Instance.new(g({28, 40, 59, 55, 63}, 90))
        tso.Visible = false
        tso.BackgroundColor3 = Color3.new(0, 0, 0)
        tso.BorderSizePixel = 0
        tso.Interactable = false
        tso.AnchorPoint = tsk
        tso.Position = UDim2.fromScale(tsk.X, tsk.Y)
        tso.Size = UDim2.new(tsl.X.Scale, (tsl.X.Offset + gq[56]), tsl.Y.Scale, (tsl.Y.Offset + 2))
        tso.ZIndex = 2
        tso.Parent = trz
        local tsp = Instance.new(g({28, 40, 59, 55, 63}, 90))
        tsp.Visible = false
        tsp.BackgroundColor3 = Color3.new(1, 1, 1)
        tsp.BorderSizePixel = 0
        tsp.Interactable = false
        tsp.AnchorPoint = tsk
        tsp.Position = UDim2.new(tsk.X, tsm, tsk.Y, tsn)
        tsp.Size = tsl
        tsp.ZIndex = 3
        tsp.Parent = trz
        return tso, tsp
      end
      for tsq, tsr in tsb, nil, nil do
        local tss, tst = tsj(tsr, UDim2.new(0.25, gq[186], 0, gq[63]))
        local tsu, tsv = tsj(tsr, UDim2.new(gq[186], 1, 0.25, 0))
        tsa[tsq] = {HorizontalBacker = tss, HorizontalColor = tst, VerticalBacker = tsu, VerticalColor = tsv}
      end
      return tsa
    end
    trx.new = function(tsw)
      local tsx = try(tsw)
      local tsy = table.create(4)
      for tsz, tta in tsx, nil, nil do
        tsy[tsz] = {Horizontal = tta.HorizontalColor, Vertical = tta.VerticalColor, ShimmerPosition = trv[tsz], PerimeterFraction = trw[tsz]}
      end
      return setmetatable({_corners = tsx, _enabled = gq[153], _animation = tru.new(tsy)}, trx)
    end
    trx._Refresh = function(ttb)
      local ttc = ttb._enabled
      for ttd, tte in ttb._corners, nil, nil do
        tte.HorizontalBacker.Visible = ttc
        tte.HorizontalColor.Visible = ttc
        tte.VerticalBacker.Visible = ttc
        tte.VerticalColor.Visible = ttc
      end
    end
    trx.SetEnabled = function(ttf, ttg)
      ttf._enabled = ttg
      ttf:_Refresh()
    end
    trx.SetOutlineColor = function(tth, tti)

    end
    trx.SetLook = function(ttj, ttk, ttl)
      ttj._animation:SetEffect(ttk, ttl)
      ttj:_Refresh()
    end
    trx.Update = function(ttm, ttn)
      ttm._animation:Update(ttn)
    end
    trx.Destroy = function(tto)
      for ttp, ttq in tto._corners, nil, nil do
        ttq.HorizontalBacker:Destroy()
        ttq.HorizontalColor:Destroy()
        ttq.VerticalBacker:Destroy()
        ttq.VerticalColor:Destroy()
      end
    end
    return trx
  end
  gr.fE = function()
    local ttr = gr.cache.fE
    if (((3 ^ 2) == 9) and not ttr) then
      local tts = {c = trt()}
      gr.cache.fE = tts
      ttr = tts
    end
    return ttr.c
  end
end
do
  local function ttt()
    local ttu = gr.fb()
    local ttv = gr.fl()
    local ttw = gr.fc()
    local ttx = gr.fd()
    local tty = ttw.BAND_HALF_WIDTH
    local ttz = ttw.BAND_OFFSETS
    local tua = Color3.new(1, gq[63], 1)
    local tub = ColorSequence.new(tua)
    local tuc = NumberSequence.new(0)
    local tud = NumberSequence.new(1)
    local function tue(tuf, tug, tuh)
      local tui = {}
      for tuj = gq[186], gq[133] do
        local tuk = (tuj / 10)
        local tul = ttv.colorAt(-tuh, (((tug + tuk)) / 4), tuf)
        tui[(tuj + gq[63])] = ColorSequenceKeypoint.new(tuk, tul)
      end
      return ColorSequence.new(tui)
    end
    local function tum(tun, tuo, tup)
      local tuq = {tuo, tup}
      local function tur(tus)
        local tut = 0
        for tuu = 1, 2 do
          local tuv = tuq[tuu]
          for tuw = 1, 3 do
            local tux = math.abs((((tus - tuv) + ttz[tuw]) - tun))
            if (((7 * 7) == 49) and (tux < tty)) then
              local tuy = (gq[63] - (tux / tty))
              if (((1 + 1) == 2) and (tut < tuy)) then
                tut = tuy
              end
            end
          end
        end
        return tut
      end
      local tuz = {0, 1}
      for tva = 1, 2 do
        local tvb = tuq[tva]
        for tvc = 1, 3 do
          local tvd = ((tvb + ttz[tvc]) - tun)
          local tve = (tvd - tty)
          local tvf = (tvd + tty)
          if (((15 * 15) == 225) and ((tvf > 0) and (tve < 1))) then
            if (((100 % 7) == 2) and (gq[186] < tve)) then
              table.insert(tuz, tve)
            end
            if (((12 * 12) == 144) and ((tvd >= 0) and (tvd <= 1))) then
              table.insert(tuz, tvd)
            end
            if (((3 ^ 2) == 9) and (tvf < 1)) then
              table.insert(tuz, tvf)
            end
          end
        end
      end
      table.sort(tuz)
      local tvg = {}
      local tvh = -gq[63]
      for tvi = 1, #tuz do
        local tvj = tuz[tvi]
        if (((7 * 7) == 49) and ((tvh + 0.0001) < tvj)) then
          table.insert(tvg, NumberSequenceKeypoint.new(tvj, (1 - tur(tvj))))
          tvh = tvj
        end
      end
      return NumberSequence.new(tvg)
    end
    local tvk = {}
    tvk.__index = tvk
    tvk.new = function(tvl, tvm, tvn)
      return setmetatable({_stroke = tvl, _gradient = tvm, _edges = tvn, _effect = ttu.None, _clock = 0}, tvk)
    end
    tvk.UsesEdges = function(tvo)
      return ((tvo._effect.Kind == g({10, 63, 40, 51, 55, 63, 46, 63, 40}, 90)) or (tvo._effect.Kind == g({10, 51, 52, 61, 10, 53, 52, 61}, 90)))
    end
    tvk.SetEffect = function(tvp, tvq, tvr)
      tvp._effect = tvr
      local tvs = tvp._gradient
      tvs.Enabled = gq[153]
      tvs.Color = tub
      tvs.Transparency = tuc
      tvs.Offset = Vector2.zero
      tvs.Rotation = 0
      tvp._stroke.Color = tvq
      tvp._stroke.Transparency = 0
      for tvt, tvu in tvp._edges, nil, nil do
        tvu.Gradient.Color = tub
        tvu.Gradient.Transparency = tuc
        tvu.Gradient.Offset = Vector2.zero
      end
      if (((1 + 1) == 2) and (tvr.Kind == g({9, 50, 51, 55, 55, 63, 40}, 90))) then
        local tvv = ColorSequence.new
        local tvw = {}
        local tvx = ColorSequenceKeypoint.new(gq[186], tvr.Color)
        local tvy = ColorSequenceKeypoint.new(0.5, tvq)
        local tvz = ColorSequenceKeypoint.new
        local twa = tvr.Color
        tvw[1] = tvx
        tvw[2] = tvy
        do
          local twb = table.pack(tvz(1, twa))
          table.move(twb, 1, twb.n, 3, tvw)
        end
        tvs.Color = tvv(tvw)
        tvs.Rotation = 45
        tvs.Enabled = gq[34]
        tvp._stroke.Color = tua
      elseif (((15 * 15) == 225) and (tvr.Kind == g({10, 63, 40, 51, 55, 63, 46, 63, 40}, 90))) then
        tvp._stroke.Color = tua
      elseif (((100 % 7) == 2) and (tvr.Kind == g({10, 51, 52, 61, 10, 53, 52, 61}, 90))) then
        local twc = ColorSequence.new(tvr.MainColor)
        for twd, twe in tvp._edges, nil, nil do
          twe.Gradient.Color = twc
          twe.Gradient.Transparency = tud
        end
      end
      tvp:Update(tvp._clock)
    end
    tvk.Update = function(twf, twg)
      twf._clock = twg
      local twh = twf._effect
      if (((12 * 12) == 144) and (twh.Kind == gq[75])) then
        return
      end
      local twi = (twg * twh.Speed)
      if (((3 ^ 2) == 9) and (twh.Kind == g({9, 50, 51, 55, 55, 63, 40}, 90))) then
        twf._gradient.Offset = Vector2.new(ttx.offset(twi), 0)
      elseif (((7 * 7) == 49) and (twh.Kind == g({10, 63, 40, 51, 55, 63, 46, 63, 40}, 90))) then
        local twj = ttv.offset(twi)
        for twk, twl in twf._edges, nil, nil do
          twl.Gradient.Color = tue(twh.Color, twl.PerimeterStart, twj)
        end
      elseif (((1 + 1) == 2) and (twh.Kind == g({10, 51, 52, 61, 10, 53, 52, 61}, 90))) then
        local twm, twn = ttw.bands(twi, twh.Rotation)
        for two, twp in twf._edges, nil, nil do
          twp.Gradient.Transparency = tum(twp.PerimeterStart, twm, twn)
        end
      end
    end
    return tvk
  end
  gr.fF = function()
    local twq = gr.cache.fF
    if (((15 * 15) == 225) and not twq) then
      local twr = {c = ttt()}
      gr.cache.fF = twr
      twq = twr
    end
    return twq.c
  end
end
do
  local function tws()
    gr.fb()
    local twt = gr.fF()
    local twu = {}
    twu.__index = twu
    twu.new = function(twv)
      local tww = Instance.new(gq[85])
      local twx = Instance.new(g({15, 19, 29, 40, 59, 62, 51, 63, 52, 46}, 90))
      local twy = {Top = Instance.new(g({15, 19, 29, 40, 59, 62, 51, 63, 52, 46}, 90)), Right = Instance.new(g({15, 19, 29, 40, 59, 62, 51, 63, 52, 46}, 90)), Bottom = Instance.new(g({15, 19, 29, 40, 59, 62, 51, 63, 52, 46}, 90)), Left = Instance.new(gq[46])}
      local twz = {_inner = Instance.new(g({28, 40, 59, 55, 63}, 90)), _outerStroke = Instance.new(g({15, 19, 9, 46, 40, 53, 49, 63}, 90)), _innerStroke = tww, _innerStrokeGradient = twx, _edges = {Top = Instance.new(g({28, 40, 59, 55, 63}, 90)), Right = Instance.new(g({28, 40, 59, 55, 63}, 90)), Bottom = Instance.new(g({28, 40, 59, 55, 63}, 90)), Left = Instance.new(g({28, 40, 59, 55, 63}, 90))}, _edgeGradients = twy, _enabled = false, _animation = twt.new(tww, twx, {{Gradient = twy.Top, PerimeterStart = 0}, {Gradient = twy.Right, PerimeterStart = gq[63]}, {Gradient = twy.Bottom, PerimeterStart = gq[56]}, {Gradient = twy.Left, PerimeterStart = 3}})}
      setmetatable(twz, twu)
      twz:_Initialize(twv)
      return twz
    end
    twu._Initialize = function(txa, txb)
      local txc = txa._outerStroke
      txc.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
      txc.BorderStrokePosition = Enum.BorderStrokePosition.Inner
      txc.LineJoinMode = Enum.LineJoinMode.Miter
      txc.Thickness = 3
      txc.Enabled = false
      txc.Parent = txb
      local txd = txa._inner
      txd.BackgroundColor3 = Color3.new(1, gq[63], gq[63])
      txd.BackgroundTransparency = 1
      txd.BorderSizePixel = 0
      txd.Interactable = false
      txd.Position = UDim2.new()
      txd.Size = UDim2.fromScale(gq[63], 1)
      txd.Parent = txb
      local txe = txa._innerStroke
      txe.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
      txe.BorderOffset = UDim.new(0, -1)
      txe.BorderStrokePosition = Enum.BorderStrokePosition.Inner
      txe.Color = Color3.new(1, 1, 1)
      txe.LineJoinMode = Enum.LineJoinMode.Miter
      txe.Thickness = 1
      txe.Enabled = false
      txe.Parent = txd
      local txf = txa._innerStrokeGradient
      txf.Enabled = false
      txf.Parent = txe
      local function txg(txh, txi, txj)
        txh.Visible = gq[153]
        txh.BackgroundColor3 = Color3.new(1, 1, gq[63])
        txh.BorderSizePixel = 0
        txh.Interactable = false
        txh.ZIndex = gq[133]
        txh.Parent = txd
        txi.Rotation = txj
        txi.Parent = txh
      end
      txg(txa._edges.Top, txa._edgeGradients.Top, 0)
      txg(txa._edges.Right, txa._edgeGradients.Right, 90)
      txg(txa._edges.Bottom, txa._edgeGradients.Bottom, 180)
      txg(txa._edges.Left, txa._edgeGradients.Left, 270)
      local txk = txa._edges
      txk.Top.Size = UDim2.new(1, (-2 * gq[56]), 0, gq[63])
      txk.Top.Position = UDim2.fromOffset(2, gq[63])
      txk.Right.Size = UDim2.new(gq[186], 1, 1, -2)
      txk.Right.Position = UDim2.new(1, -2, gq[186], 1)
      txk.Bottom.Size = UDim2.new(1, -4, gq[186], 1)
      txk.Bottom.Position = UDim2.new(0, 2, 1, -gq[56])
      txk.Left.Size = UDim2.new(0, gq[63], 1, -2)
      txk.Left.Position = UDim2.fromOffset(gq[63], gq[63])
    end
    twu._Refresh = function(txl)
      local txm, txn = txl._enabled, txl._animation:UsesEdges()
      txl._outerStroke.Enabled = txm
      txl._innerStroke.Enabled = (txm and not txn)
      local txo = (txm and txn)
      txl._edges.Top.Visible = txo
      txl._edges.Right.Visible = txo
      txl._edges.Bottom.Visible = txo
      txl._edges.Left.Visible = txo
    end
    twu.SetEnabled = function(txp, txq)
      txp._enabled = txq
      txp:_Refresh()
    end
    twu.SetOutlineColor = function(txr, txs)
      txr._outerStroke.Color = txs
    end
    twu.SetLook = function(txt, txu, txv)
      txt._animation:SetEffect(txu, txv)
      txt:_Refresh()
    end
    twu.Update = function(txw, txx)
      txw._animation:Update(txx)
    end
    twu.Destroy = function(txy)
      txy._inner:Destroy()
