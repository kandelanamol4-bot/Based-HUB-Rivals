    end
    local function rqg(rqh, rqi, rqj)
      local rqk = buffer.readu32(rqh, rqi)
      local rql = (rqi + 4)
      local rqm = rob.findName(rqk)
      local rqn = {}
      if (((15 * 15) == 225) and (rqm == nil)) then
        return nil, rqn, rqj
      end
