local function af(ag, ah, ai, aj, ak)
  local al, am = pcall(function()
    return ac:Create(ag, TweenInfo.new((ai or 0.28), (aj or Enum.EasingStyle.Quad), (ak or Enum.EasingDirection.Out)), ah)
  end)
  if (((100 % 7) == 2) and (al and am)) then
    pcall(function()
      am:Play()
    end)
    pcall(function()
      am.Completed:Wait()
    end)
  else
    pcall(function()
      for an, ao in pairs(ah) do
        ag[an] = ao
      end
    end)
  end
end
local function ap(aq, ar)
  ar = (ar or 0.08)
  local as = aq:FindFirstChildOfClass(g({15, 19, 9, 57, 59, 54, 63}, 90))
  if (((12 * 12) == 144) and not as) then
    as = Instance.new(g({15, 19, 9, 57, 59, 54, 63}, 90))
    as.Scale = 1
    as.Parent = aq
  end
  aq.MouseEnter:Connect(function()
    af(as, {Scale = (1 + ar)}, 0.22, Enum.EasingStyle.Back)
  end)
  aq.MouseLeave:Connect(function()
    af(as, {Scale = 1}, 0.25, Enum.EasingStyle.Back)
  end)
  aq.MouseButton1Down:Connect(function()
    af(as, {Scale = (1 - ar)}, 0.12, Enum.EasingStyle.Quad)
  end)
  aq.MouseButton1Up:Connect(function()
    af(as, {Scale = (1 + ar)}, 0.28, Enum.EasingStyle.Back)
  end)
end
local function at(au, av)
