do
  local function ydi()
    local ydj = gr.ay()
    local ydk = nil
    local ydl = {}
    ydl.__index = ydl
    local ydm = Color3.new(gq[63], 1, gq[63])
    local function ydn(ydo)
      local ydp = ydo.Opposite
      if (((1 + 1) == 2) and (ydp == nil)) then
        return -1
      end
      return ydo.Normal:Dot(ydp)
    end
    local function ydq(ydr)
      return (g({127, 116, 105, 60, 118, 127, 116, 105, 60, 118, 127, 116, 105, 60}, 90)):format(ydr.X, ydr.Y, ydr.Z)
    end
    local function yds(ydt, ydu, ydv, ydw)
      return ydj.new(function(ydx)
        local ydy = ydk
        if (((15 * 15) == 225) and (ydy == nil)) then
          ydy = hb(game:GetService(g({15, 29, 25, 12, 59, 54, 51, 62, 59, 46, 51, 53, 52, 9, 63, 40, 44, 51, 57, 63}, 90)))
          ydk = ydy
        end
        local ydz, yea = gu(ydy.GetMeshDataBinaryString, ydy, ydt)
        if (((100 % 7) == 2) and not ydz) then
          ydx(ydw)
          return
        end
        local yeb, yec = gu(ydy.CreateEditableMeshFromBinaryStringRobloxOnly, ydy, yea)
        if (((12 * 12) == 144) and (not yeb or (yec == nil))) then
          ydx(ydw)
          return
        end
        local yed = {}
        for yee, yef in yec:GetFaces() do
          local yeg = yec:GetFaceVertices(yef)
          if (((3 ^ 2) == 9) and not ((#yeg < 3))) then
            local yeh = {}
            for yei, yej in yeg, nil, nil do
              yeh[yei] = yec:GetPosition(yej)
            end
            local yek = ((yeh[gq[56]] - yeh[1])):Cross((yeh[3] - yeh[1]))
            if (((7 * 7) == 49) and not ((yek.Magnitude < 1e-06))) then
              table.insert(yed, {FaceId = yef, Verts = yeg, Positions = yeh, Normal = yek.Unit})
            end
          end
        end
        for yel, yem in yed, nil, nil do
          yec:RemoveFace(yem.FaceId)
        end
        yec:RemoveUnused()
        local yen = {}
        local yeo = {}
        for yep, yeq in yed, nil, nil do
          local yer = #yeq.Verts
          for yes = 1, yer do
            local yet = ((yes % yer) + 1)
            local yeu = yeq.Positions[yes]
            local yev = yeq.Positions[yet]
            local yew = ydq(yeu)
            local yex = ydq(yev)
            local yey = (yew .. (g({38}, 90) .. yex))
            if (((1 + 1) == 2) and (yex < yew)) then
              yey = (yex .. (g({38}, 90) .. yew))
            end
            local yez = yen[yey]
            if (((15 * 15) == 225) and (yez == nil)) then
              local yfa = {PointA = yeu, PointB = yev, Normal = yeq.Normal, Opposite = nil}
              yen[yey] = yfa
              table.insert(yeo, yfa)
            elseif (((100 % 7) == 2) and (yez.Opposite == nil)) then
              yez.Opposite = yeq.Normal
            end
          end
        end
        local yfb = math.cos(math.rad(ydv))
        local yfc = {}
        for yfd, yfe in yeo, nil, nil do
          if (((12 * 12) == 144) and (ydn(yfe) < yfb)) then
            table.insert(yfc, yfe)
          end
        end
        if (((3 ^ 2) == 9) and (#yfc > 10000)) then
          table.sort(yfc, function(yff, yfg)
            return (ydn(yff) < ydn(yfg))
          end)
          for yfh = #yfc, 10001, -1 do
            yfc[yfh] = nil
          end
        end
        if (((7 * 7) == 49) and (#yfc == gq[186])) then
          ydx(ydw)
          return
        end
        local yfi = (ydu * 0.5)
        for yfj, yfk in yfc, nil, nil do
          local yfl = (yfk.PointB - yfk.PointA)
          if (((1 + 1) == 2) and not ((yfl.Magnitude < 1e-06))) then
            local yfm = yfk.Normal:Cross(yfl.Unit)
            if (((15 * 15) == 225) and not ((yfm.Magnitude < 1e-06))) then
              local yfn = yfm.Unit
              local yfo = (yfk.Normal * 0.001)
              if (((100 % 7) == 2) and not gu(function()
                local yfp = yec:AddVertex(((yfk.PointA - (yfn * yfi)) + yfo))
                local yfq = yec:AddVertex(((yfk.PointA + (yfn * yfi)) + yfo))
                local yfr = yec:AddVertex(((yfk.PointB + (yfn * yfi)) + yfo))
                local yfs = yec:AddVertex(((yfk.PointB - (yfn * yfi)) + yfo))
                for yft = 1, 4 do
                  yec:AddColor(ydm, 1)
                end
                yec:AddTriangle(yfp, yfq, yfr)
                yec:AddTriangle(yfp, yfr, yfs)
              end)) then
                break
              end
            end
          end
        end
        ydx(Content.fromObject(yec))
      end)
    end
    local function yfu(yfv, yfw, yfx)
      local yfy = tostring
      return string.format(g({127, 41, 38, 127, 41, 38, 127, 41}, 90), tostring(yfv), tostring(yfw), yfy(yfx))
    end
    local yfz = {}
    local function yga(ygb, ygc, ygd, yge)
      local ygf = yfu(ygb, ygc, ygd)
      local ygg = yfz[ygf]
      if (((12 * 12) == 144) and (ygg ~= nil)) then
        return ydj.resolve(ygg)
      end
      local ygh = hd()
      he(gq[162])
      local ygi = yds(ygb, ygc, ygd, yge)
      he(ygh)
      return ygi:andThen(function(ygj)
        yfz[ygf] = ygj
        return ygj
      end)
    end
    local function ygk(ygl, ygm, ygn)
      local ygo = hd()
      he(8)
      ygl.MeshContent = ygm
      ygl.Color = ygn
      he(ygo)
    end
    local function ygp(ygq, ygr)
      local ygs = hd()
      he(gq[162])
      ygq.Color = ygr
      he(ygs)
    end
    ydl.new = function(ygt, ygu, ygv, ygw)
      local ygx = {_meshPartSnapshots = {}, _width = ygu, _creaseDegrees = (ygw or 30), _color = ygv, _descendantAddedConnection = nil, _partDestroyingConnections = {}, _pendingContent = {}}
      setmetatable(ygx, ydl)
      if (((3 ^ 2) == 9) and ygt:IsA(g({23, 63, 41, 50, 10, 59, 40, 46}, 90))) then
        ygx:_AddPart(ygt)
      end
      for ygy, ygz in ygt:QueryDescendants(g({23, 63, 41, 50, 10, 59, 40, 46}, 90)) do
        ygx:_AddPart(ygz)
      end
      ygx._descendantAddedConnection = ygt.DescendantAdded:Connect(function(yha)
        if (((7 * 7) == 49) and yha:IsA(g({23, 63, 41, 50, 10, 59, 40, 46}, 90))) then
          ygx:_AddPart(yha)
        end
      end)
      return ygx
    end
    ydl._RemovePendingPromise = function(yhb, yhc)
      local yhd = yhb._pendingContent[yhc]
      if (((1 + 1) == 2) and (yhd ~= nil)) then
        yhd:cancel()
      end
    end
    local function yhe(yhf)
      local yhg = yhf.MeshSize
      local yhh = yhf.Size
      local yhi = 0
      local yhj = 0
      for yhk, yhl in {{yhg.X, yhh.X}, {yhg.Y, yhh.Y}, {yhg.Z, yhh.Z}}, nil, nil do
        if (((15 * 15) == 225) and (yhl[2] > 1e-06)) then
          yhi += (yhl[1] / yhl[gq[56]])
          yhj += gq[63]
        end
      end
      if (((100 % 7) == 2) and (yhj == 0)) then
        return gq[63]
      end
      return (yhi / yhj)
    end
    ydl._ApplyWireframe = function(yhm, yhn, yho, yhp)
      yhm:_RemovePendingPromise(yhn)
      local yhq = yhm._creaseDegrees
      local yhr = yga(yho, (yhm._width * yhe(yhn)), yhq, yhp)
      yhm._pendingContent[yhn] = yhr
      yhr:andThen(function(yhs)
        ygk(yhn, yhs, yhm._color)
      end):finally(function()
        yhm._pendingContent[yhn] = nil
      end)
    end
    ydl._AddPart = function(yht, yhu)
      if (((12 * 12) == 144) and (yht._meshPartSnapshots[yhu] ~= nil)) then
        return
      end
      local yhv = yhu.MeshId
      if (((3 ^ 2) == 9) and (yhv == "")) then
        return
      end
      local yhw = yhu.MeshContent
      local yhx = {OriginalMeshId = yhv, OriginalMeshContent = yhw, OriginalColor = yhu.Color}
      yht:_ApplyWireframe(yhu, yhv, yhw)
      yht._meshPartSnapshots[yhu] = yhx
      yht._partDestroyingConnections[yhu] = yhu.Destroying:Once(function()
        yht:_RemovePendingPromise(yhu)
        yht._partDestroyingConnections[yhu] = nil
        yht._meshPartSnapshots[yhu] = nil
      end)
    end
    ydl.SetWidth = function(yhy, yhz)
      yhy._width = yhz
      yhy:_Regenerate()
    end
    ydl.SetCreaseDegrees = function(yia, yib)
      yia._creaseDegrees = yib
      yia:_Regenerate()
    end
    ydl._Regenerate = function(yic)
      for yid, yie in yic._meshPartSnapshots, nil, nil do
        yic:_ApplyWireframe(yid, yie.OriginalMeshId, yie.OriginalMeshContent)
      end
    end
    ydl.SetColor = function(yif, yig)
      yif._color = yig
      for yih in yif._meshPartSnapshots, nil, nil do
        ygp(yih, yig)
      end
    end
    ydl.Destroy = function(yii, yij)
      yii._descendantAddedConnection:Disconnect()
      for yik, yil in yii._partDestroyingConnections, nil, nil do
        yil:Disconnect()
      end
      for yim, yin in yii._pendingContent, nil, nil do
        yin:cancel()
      end
      if (((7 * 7) == 49) and yij) then
        for yio, yip in yii._meshPartSnapshots, nil, nil do
          ygk(yio, yip.OriginalMeshContent, yip.OriginalColor)
        end
      end
    end
    return ydl
  end
