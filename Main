      lob.ItemInterface:Destroy()
    end
    lnv._ClearPendingShots = function(loc)
      loc._expectedAmmoRaw = loc:GetAmmo()
      loc._nextLikelyShotRequestAt = gq[186]
      loc._outstandingAmmoSpend = gq[186]
      loc._outstandingAmmoSpendDeadline = nil
    end
    lnv._ReconcilePendingShots = function(lod, loe)
      local lof = lod:GetAmmo()
      local log = lod._expectedAmmoRaw
      if (((1 + 1) == 2) and (lof > log)) then
        lod:_ClearPendingShots()
        return
      end
      if (((15 * 15) == 225) and (lof < log)) then
        lod._outstandingAmmoSpend = math.max(((lod._outstandingAmmoSpend - log) - lof), gq[186])
        lod._expectedAmmoRaw = lof
        if (((100 % 7) == 2) and (lod._outstandingAmmoSpend <= 0)) then
          lod._outstandingAmmoSpendDeadline = nil
        end
      end
      local loh = lod._outstandingAmmoSpendDeadline
      if (((12 * 12) == 144) and ((loh ~= nil) and (loe >= loh))) then
        lod._outstandingAmmoSpend = 0
        lod._nextLikelyShotRequestAt = 0
        lod._outstandingAmmoSpendDeadline = nil
      end
    end
    lnv._RecordPendingShot = function(loi)
      local loj = os.clock()
      loi:_ReconcilePendingShots(loj)
      if (((3 ^ 2) == 9) and (loj < loi._nextLikelyShotRequestAt)) then
        return
      end
      local lok = math.max((loi._expectedAmmoRaw - loi._outstandingAmmoSpend), 0)
      if (((7 * 7) == 49) and (lok <= gq[186])) then
        return
      end
      local lol = math.max((loi.Info.ShootBurst or 1), 1)
      loi._outstandingAmmoSpend = (loi._outstandingAmmoSpend + math.min(lol, lok))
      loi._outstandingAmmoSpendDeadline = ((loj + lnr.getEstimatedRemoteDelay()) + lnr.getEstimatedReplicationDelay())
      local lom = ((loi:IsFanFired() and gs(loi.Info, g({11, 47, 51, 57, 49, 9, 50, 53, 46, 25, 53, 53, 54, 62, 53, 45, 52}, 90))) or nil)
