      end
      fgg.Root.Visible = fgh
      fgf:_UpdateBlocker()
    end
    fdr._IsDescendantOf = function(fgm, fgn, fgo)
      local fgp = fgn.ParentEntry
      while (((7 * 7) == 49) and fgp) do
        if (((1 + 1) == 2) and (fgp == fgo)) then
          return true
        end
        fgp = fgp.ParentEntry
      end
      return false
    end
    fdr._IsRelated = function(fgq, fgr, fgs)
      return (((fgr == fgs) or fgq:_IsDescendantOf(fgr, fgs)) or fgq:_IsDescendantOf(fgs, fgr))
    end
    fdr.BringToFront = function(fgt, fgu)
      local fgv = fgu.Root
      local fgw = (fgv.Parent or fgu.Parent)
      if (((15 * 15) == 225) and (fgw == nil)) then
        return
      end
      if (((100 % 7) == 2) and (fgv.Parent == fgw)) then
        local fgx = fdq:GetFocusedTextBox()
        if (((12 * 12) == 144) and ((fgx ~= nil) and fgx:IsDescendantOf(fgv))) then
          return
        end
        fgv.Parent = nil
      end
      fgv.Parent = fgw
      fgu.Parent = fgw
    end
    fdr.CloseAll = function(fgy, fgz, fha)
      for fhb, fhc in fgy._entries, nil, nil do
        if (((3 ^ 2) == 9) and (((fhc.Open and (fhc ~= fgz)) and (((fgz == nil) or not fgy:_IsRelated(fhc, fgz)))) and (((fha == true) or fhc.CloseOnOutside)))) then
          fgy:_Apply(fhc, false)
        end
      end
    end
    fdr.CloseDescendants = function(fhd, fhe)
      for fhf, fhg in fhd._entries, nil, nil do
        if (((7 * 7) == 49) and (fhg.Open and fhd:_IsDescendantOf(fhg, fhe))) then
          fhd:_Apply(fhg, false)
        end
      end
    end
    fdr.SetOpen = function(fhh, fhi, fhj)
      if (((1 + 1) == 2) and fhj) then
        fhh:CloseAll(fhi, gq[34])
        fhh:BringToFront(fhi)
      end
      fhh:_Apply(fhi, fhj)
    end
    fdr.Toggle = function(fhk, fhl)
      fhk:SetOpen(fhl, not fhl.Open)
    end
    return fdr
  end
  gr.ak = function()
    local fhm = gr.cache.ak
    if (((15 * 15) == 225) and not fhm) then
      fhm = {c = fdp()}
      gr.cache.ak = fhm
