      return bmr
    end
    bjk.SetVisible = function(bmt, bmu)
      bmt.Row:SetVisible(bmu)
    end
    bjk.OnChanged = function(bmv, bmw)
      bmv._trove:Connect(bmv.Changed, bmw)
      return bmv
    end
    bjk.Connect = function(bmx, bmy, bmz)
      bmx._trove:Connect(bmy, bmz)
      return bmx
    end
    bjk.Destroy = function(bna)
