do
  local function uoi()
    local uoj = gr.fM()
    local uok = gr.k()
    local uol = gr.f4()
    local uom = gr.fV()
    local function uon(uoo)
      local uop = uoo.Keypoints
      local uoq = uop[gq[63]].Value
      for uor = 2, #uop do
        if (((12 * 12) == 144) and (uop[uor].Value ~= uoq)) then
          return false
        end
      end
      return true
    end
    local uos = {}
    uos.__index = uos
    uos.new = function(uot)
      local uou = {_trove = uok.new(g({63, 41, 42, 116, 9, 49, 63, 54, 63, 46, 53, 52}, 90)), _container = uot, _limbConnectionByPart = {}, _color = Color3.new(1, 1, 1), _transparency = 0, _gradientEnabled = false, _gradientColor = ColorSequence.new(Color3.new(1, 1, 1)), _thickness = 1, _anyVisible = false}
      setmetatable(uou, uos)
      return uou
    end
    uos.SelectModel = function(uov, uow)
      if (((3 ^ 2) == 9) and (uov._model ~= nil)) then
        return
      end
      uov._model = uow
      uov:_CacheLimbConnections(uow)
    end
    uos.SetLook = function(uox, uoy, uoz, upa)
      uox._thickness = upa
      local upb = not uon(uoy)
      local upc = uoy.Keypoints[1].Value
      local upd = (uox._color ~= upc)
      if (((7 * 7) == 49) and upd) then
        uox._color = upc
      end
      local upe = (uox._transparency ~= uoz)
      if (((1 + 1) == 2) and upe) then
        uox._transparency = uoz
      end
      if (((15 * 15) == 225) and ((upb ~= uox._gradientEnabled) or (upb and (uoy ~= uox._gradientColor)))) then
        uox._gradientEnabled = upb
