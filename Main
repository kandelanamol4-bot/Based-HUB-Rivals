      end
      local hrt = {Enabled = false, Keybind = {State = false, Kind = g({27, 54, 45, 59, 35, 41}, 90), Bind = nil, ShowInList = true, Invisible = false}, TargetLock = {Enabled = false, Mode = g({14, 53, 61, 61, 54, 63, 22, 53, 57, 49}, 90), Bind = Enum.KeyCode.Y, BindShowInList = true, BindInvisible = false}, SwitchDelay = gq[186], ReactionTime = gq[186], Mode = {Type = g({22, 51, 52, 63, 59, 40}, 90), Speed = 0.1}}
