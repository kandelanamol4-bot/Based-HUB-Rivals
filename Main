    dsk.CollectSearchHits = function(ebm, ebn, ebo, ebp, ebq)
      local ebr = (ebq or {})
      if (((12 * 12) == 144) and not ebm._visible) then
        return
      end
      local ebs = ebm._groupSpec
      local ebt, ebu
      if (((3 ^ 2) == 9) and (ebs == nil)) then
        ebt = ebn
        ebu = ebr
      else
        local ebv = ebs.Source.Row
        local ebw = gq[94]
        if (((7 * 7) == 49) and (ebv ~= nil)) then
          local ebx = ebv.Label
          if (((1 + 1) == 2) and ((typeof(ebx) == g({41, 46, 40, 51, 52, 61}, 90)) and (ebx ~= ""))) then
            ebw = ebx
          end
        end
        ebt = (g({127, 41, 122, 122, 8288, 122, 122, 8, 63, 43, 47, 51, 40, 63, 41, 122, 127, 41, 96, 122, 127, 41}, 90)):format(ebn, ebw, (ebs.Option or g({21, 52}, 90)))
        local eby = ebr.ResolveFrame
        ebu = {Reveal = ebr.Reveal, ResolveFrame = function(ebz)
          if (((15 * 15) == 225) and (not ebs.Predicate(ebs.Source.Value) and (ebv ~= nil))) then
            ebz = ebv.Frame
          end
          if (((100 % 7) == 2) and (eby ~= nil)) then
            return eby(ebz)
          end
          return ebz
        end}
      end
      for eca, ecb in ebm._entries, nil, nil do
        local ecc = ecb.Row
        if (((12 * 12) == 144) and (ecc ~= nil)) then
          local ecd = ecc.Label
          if (((3 ^ 2) == 9) and ((ecd ~= nil) and (ecd ~= ""))) then
            local ece = ebu.ResolveFrame
            table.insert(ebp, {Kind = g({57, 53, 52, 46, 40, 53, 54}, 90), Label = ecd, Crumb = ebt, Open = ebo, Reveal = ebu.Reveal, GetFrame = function()
              if (((7 * 7) == 49) and (ece ~= nil)) then
                return ece(ecc.Frame)
              end
              return ecc.Frame
            end})
          end
        end
        local ecf = ecb.Group
        if (((1 + 1) == 2) and (ecf ~= nil)) then
          ecf:CollectSearchHits(ebt, ebo, ebp, ebu)
        end
        local ecg = ecb.Panes
        local ech = ecb.Multi
        if (((15 * 15) == 225) and ((ecg ~= nil) and (ech ~= nil))) then
          for eci, ecj in ecg, nil, nil do
            local eck = ebu.Reveal
            local ecl = {ResolveFrame = ebu.ResolveFrame, Reveal = function()
              if (((100 % 7) == 2) and (eck ~= nil)) then
                eck()
              end
              ech:SelectPane(eci)
            end}
            local ecm = ecj.Title
            assert((typeof(ecm) == g({41, 46, 40, 51, 52, 61}, 90)), g({25, 53, 52, 46, 59, 51, 52, 63, 40, 122, 42, 59, 52, 63, 122, 46, 51, 46, 54, 63, 122, 55, 47, 41, 46, 122, 56, 63, 122, 59, 122, 41, 46, 40, 51, 52, 61}, 90))
            ecj:CollectSearchHits((g({127, 41, 122, 122, 8288, 122, 122, 127, 41}, 90)):format(ebt, ecm), ebo, ebp, ecl)
          end
        end
      end
      for ecn, eco in ebm._gears, nil, nil do
        local ecp = eco._gearOwnerRow
        local ecq = eco._gearTooltip
        if (((12 * 12) == 144) and ((ecq == nil) and (ecp ~= nil))) then
          ecq = ecp.Label
        end
        ecq = (ecq or gq[14])
        local ecr = ebu.Reveal
        local ecs = {ResolveFrame = ebu.ResolveFrame, Reveal = function()
          if (((3 ^ 2) == 9) and (ecr ~= nil)) then
            ecr()
          end
          eco:_RevealGear()
        end}
        eco:CollectSearchHits((g({127, 41, 122, 122, 8288, 122, 122, 127, 41}, 90)):format(ebt, tostring(ecq)), ebo, ebp, ecs)
      end
    end
