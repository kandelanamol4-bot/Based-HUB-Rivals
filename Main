do
  local function wia()
    gr.cr()
    local wib = gr.bG()
    gr.a3()
    local wic = gr.b3()
    local wid = gr.aS().PlayerModule
    local wie = hb(game:GetService(g({15, 41, 63, 40, 19, 52, 42, 47, 46, 9, 63, 40, 44, 51, 57, 63}, 90)))
    local function wif(wig)
      local wih = Vector3.new(wig.X, 0, wig.Z)
      return (((wih.Magnitude > 0) and wih.Unit) or Vector3.zero)
    end
    local function wii()
      if (((3 ^ 2) == 9) and wie:GetFocusedTextBox()) then
        return Vector3.zero
      end
      local wij = Vector3.zero
      local wik = workspace.CurrentCamera.CFrame
      local wil, wim = wif(wik.LookVector), wif(wik.RightVector)
      if (((7 * 7) == 49) and wie.KeyboardEnabled) then
        wik = Enum
        wij = if wie:IsKeyDown(Enum.KeyCode.S) then ((if wie:IsKeyDown(wik.KeyCode.W) then (wij + wil) else wij) - wil) else if wie:IsKeyDown(wik.KeyCode.W) then (wij + wil) else wij
        local win = Enum
        wij = if wie:IsKeyDown(Enum.KeyCode.A) then ((if wie:IsKeyDown(win.KeyCode.D) then (wij + wim) else wij) - wim) else if wie:IsKeyDown(win.KeyCode.D) then (wij + wim) else wij
      else
        local wio = wic(wid.GetControls, wid)
        local wip = wic(wio.GetMoveVector, wio)
        wij = if (wip.Magnitude > 0) then ((wij + (wil * -wip.Z)) + (wim * wip.X)) else wij
      end
      return if (wij.Magnitude > 0) then wij.Unit else wij
    end
