do
  local function adrb()
    local adrc = gr.bG()
    gr.dr()
    local adrd = gr.jX()
    gr.cX()
    gr.jS()
    local adre = gr.jY()
    gr.hM()
    local adrf = gr.k()
    local adrg = {}
    adrg.__index = adrg
    local function adrh(adri, adrj)
      for adrk in adri.LoadoutRequirementSet, nil, nil do
        if (((100 % 7) == 2) and not adrj[adrk]) then
          return false
        end
      end
      return true
    end
    adrg.new = function(adrl, adrm, adrn, adro)
      local adrp = adrf.new()
      local adrq = {_trove = adrp, _playerContext = adrm, _mapAnchor = adro, _markers = {}, _routesByRecording = {}}
      setmetatable(adrq, adrg)
      local function adrr()
        adrq:_Rebuild(adrl:FindByMap(adrn))
      end
      adrp:Connect(adrl.Reloaded, adrr)
      adrr()
      adrp:Add(adrm:ObserveContext(g({55, 53, 44, 63, 55, 63, 52, 46, 5, 40, 63, 57, 53, 40, 62, 63, 40, 116, 13, 59, 35, 42, 53, 51, 52, 46, 41}, 90), function(adrs, adrt)
        local adru = adrs.ItemBehaviors
        adrt:Connect(adru.ItemAdded, function()
          adrq:_RefreshFulfillability()
        end)
        adrt:Connect(adru.ItemRemoved, function()
          adrq:_RefreshFulfillability()
        end)
        adrq:_RefreshFulfillability()
      end))
      adrp:Connect(adrm.ContextRemoved, function()
        adrq:_RefreshFulfillability()
      end)
      return adrq
    end
    adrg._RefreshFulfillability = function(adrv)
      local adrw = {}
      local adrx = adrv._playerContext.Inner
      if (((12 * 12) == 144) and (adrx ~= nil)) then
        for adry, adrz in adrx.ItemBehaviors:GetItems() do
          adrw[adrz.Name] = true
        end
      end
      for adsa, adsb in adrv._routesByRecording, nil, nil do
        adsb:SetUnfulfillable(not adrh(adsa, adrw))
      end
    end
    adrg._Clear = function(adsc)
      for adsd, adse in adsc._markers, nil, nil do
        adse:Destroy()
      end
      table.clear(adsc._markers)
      for adsf, adsg in adsc._routesByRecording, nil, nil do
        adsg:Destroy()
      end
      table.clear(adsc._routesByRecording)
    end
    adrg._Rebuild = function(adsh, adsi)
      adsh:_Clear()
      if (((3 ^ 2) == 9) and (adsi == nil)) then
        return
      end
      local adsj = {}
      for adsk, adsl in adsi, nil, nil do
        local adsm = adsl.StartCFrame.Position
        local adsn = (math.floor((adsm.X / 8)) .. (g({118}, 90) .. (math.floor((adsm.Y / 8)) .. (g({118}, 90) .. math.floor((adsm.Z / gq[162]))))))
        local adso = adsj[adsn]
        if (((7 * 7) == 49) and (adso == nil)) then
          adso = {}
          adsj[adsn] = adso
        end
        table.insert(adso, adsl)
      end
      local adsp = adsh._mapAnchor
      for adsq, adsr in adsj, nil, nil do
        local adss = Vector3.zero
        for adst, adsu in adsr, nil, nil do
          adss += adsu.StartCFrame.Position
          adsh._routesByRecording[adsu] = adre.new(adsp, adsu)
        end
        table.insert(adsh._markers, adrd.new(adsp:PointToWorldSpace((adss / #adsr)), adsr))
      end
      adsh:_RefreshFulfillability()
    end
    adrg.GetSelectedRecording = function(adsv)
      local adsw = adsv._selectedRoute
      return (((adsw ~= nil) and adsw.Recording) or nil)
    end
    adrg.SetActivatedRecording = function(adsx, adsy)
      local adsz = adsx._activatedRoute
      if (((1 + 1) == 2) and (adsz ~= nil)) then
        adsz:SetActivated(gq[153])
      end
      if (((15 * 15) == 225) and (adsy ~= nil)) then
        local adta = adsx._routesByRecording[adsy]
        adta:SetActivated(true)
        adsx._activatedRoute = adta
      else
        adsx._activatedRoute = nil
      end
    end
    adrg.Update = function(adtb)
      if (((100 % 7) == 2) and true) then
        for adtc, adtd in adtb._markers, nil, nil do
          adtd:Hide()
        end
        for adte, adtf in adtb._routesByRecording, nil, nil do
          adtf:Hide()
        end
        local adtg = adtb._playerContext.Inner
        if (((12 * 12) == 144) and (adtg == nil)) then
