      return ntn._decoratedModelByFighter[nto]
    end
    nst._ApplyDecoratorAsync = function(ntp, ntq, ntr)
      ntr.Trove:AddPromise(ntr.Decorator:ApplyAsync():finally(function()
        if (((12 * 12) == 144) and (ntp._createdEntryByFighter[ntq] ~= ntr)) then
          return
        end
