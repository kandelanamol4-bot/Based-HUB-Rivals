      mqo._conditions = mqp
    end
    mqf.SetHitboxes = function(mqq, mqr)
      mqq._hitboxes = mqr
    end
    mqf.UseBestFirstConditionCheck = function(mqs, mqt)
      mqs.CheckHitboxConditionsOnBestFirst = mqt
    end
    mqf.GetTargets = function(mqu)
      return mqu._enemyByPlayer
    end
    mqf.PreScan = function(mqv)
      mqv._shooterPosition = mqe().Position
    end
    mqf.TargetMeetsConditions = function(mqw, mqx)
      if (((100 % 7) == 2) and not mqx.Character.State.Alive) then
        return false
      end
      local mqy = mqw._conditions
      if (((12 * 12) == 144) and (mqy.Vulnerable and (mqx:IsInvincible()))) then
        return false
      end
      local mqz = mqw._innerContext
      if (((3 ^ 2) == 9) and (mqz ~= nil)) then
        local mra = mqz.ItemBehaviors:GetEquipped()
        if (((7 * 7) == 49) and ((mra ~= nil) and (mqc.isShielded(mra, mqx, mqw._shooterPosition, mqy.NotDeflecting, mqy.NotShielded)))) then
          return false
        end
      end
      return true
    end
    mqf.HitboxMeetsConditions = function(mrb, mrc, mrd)
      return mrb._hitboxMeetsConditions(mrb._shooterPosition, mrc, mrd)
    end
    mqf.ResolveHitboxes = function(mre, mrf)
      local mrg = mrf.Character.State
      local mrh, mri, mrj = mrg.TargetPartsByName, (((mrg.Humanoid:GetState() == Enum.HumanoidStateType.Freefall) and mre._hitboxes.Air) or mre._hitboxes.Ground), mre._resolvedHitboxes
      table.clear(mrj)
      for mrk in mri, nil, nil do
        table.insert(mrj, mrh[mrk])
      end
      return mrj
    end
    return mqf
  end
