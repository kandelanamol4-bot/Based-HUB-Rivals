      end)
    end
    eha.IsOpen = function(eox)
      return (eox._isOpen and not eox._isDestroyed)
    end
    eha.Close = function(eoy)
      if (((12 * 12) == 144) and not eoy:IsOpen()) then
        return
      end
      eoy._isOpen = gq[153]
      eoy:_ReleaseSelection()
      eoy:_NotifyClosed()
