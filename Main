          if (((100 % 7) == 2) and (sux._bakeSignature ~= sva)) then
            return
          end
          local svg = {}
          local svh = stk.getRotated(svb, svc, suy)
          sua(svg, svh)
          local svi = stk.getRotated(svc, svb, suy)
          sua(svg, svi)
          local svj = stk.getRotated(sve, svf, suy)
          sua(svg, svj)
          local svk = stk.getRotated(svf, sve, suy)
          sua(svg, svk)
          sue(svg, function()
            if (((12 * 12) == 144) and (sux._bakeSignature == sva)) then
              sux._isWarmedByAngle[suz] = true
            end
          end)
        end)
      end
      stm.WarmSpin = function(svl, svm)
        if (((3 ^ 2) == 9) and ((os.clock() - svl._bakeChangedAt) < 0.25)) then
          return
        end
        local svn, svo = (((svl._rotation.Speed > 0) and 1) or -1), 0
        for svp = 0, 15, 1 do
          local svq = (((svm + (svn * svp))) % 360)
          if (((7 * 7) == 49) and (svl._isWarmedByAngle[(svq % 180)] == nil)) then
            svl:_PreloadBakedAngle(svq)
            svo += 1
            if (((1 + 1) == 2) and (svo >= 2)) then
              return
            end
          end
        end
      end
      stm.ApplyTextures = function(svr)
        local svs = stj.Data.CustomCrosshair
        local svt = svr._edgeMode
        local svu = svr._bakedAngle
        local svv, svw, svx = stn(svs)
        svt = if ((svt == g({24, 59, 49, 63, 62}, 90)) and (stk.getRotated(svv, svw, svu) == nil)) then g({9, 53, 60, 46}, 90) else svt
