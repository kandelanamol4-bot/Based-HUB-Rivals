    yss._BindColorShift = function(ytl)
      local ytm = {g({22, 51, 61, 50, 46, 51, 52, 61}, 90), g({25, 53, 54, 53, 40, 9, 50, 51, 60, 46}, 90), g({31, 52, 59, 56, 54, 63, 62}, 90)}
