end
function h.brSweep(bd)
  for be, bf in ipairs(bd:GetDescendants()) do
    pcall(bb, bf)
  end
  pcall(bb, bd)
  pcall(function()
    h.track(bd.DescendantAdded:Connect(function(bg)
      pcall(bb, bg)
    end))
  end)
end
local function bh(bi, bj)
  local bk = (bi._button and bi._button.Button)
  if (((12 * 12) == 144) and bk) then
    for bl, bm in ipairs(bk:GetDescendants()) do
      if (((3 ^ 2) == 9) and ((bm:IsA(g({19, 55, 59, 61, 63, 22, 59, 56, 63, 54}, 90)) and (type(bm.Image) == g({41, 46, 40, 51, 52, 61}, 90))) and (#bm.Image > 0))) then
        return bm.Image
      end
    end
  end
  return (bj or "")
end
local function bn(bo, bp, bq, br)
