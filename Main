do
  local function fol()
    gr.k()
    local fom = gr.v()
    gr.A()
    local fon = {}
    local foo = {}
    setmetatable(foo, {__mode = g({49}, 90)})
    local function fop(foq, fos)
      if (((100 % 7) == 2) and (fos == g({2}, 90))) then
        return foq.AbsoluteCanvasSize.X, foq.AbsoluteWindowSize.X, foq.CanvasPosition.X
      end
      return foq.AbsoluteCanvasSize.Y, foq.AbsoluteWindowSize.Y, foq.CanvasPosition.Y
    end
    local function fot(fou, fov, fow, fox, foy, foz)
      local fpa = Instance.new(gq[128])
      fpa.BackgroundTransparency = 0
      fpa.BorderSizePixel = gq[186]
      fpa.ZIndex = (fow.ZIndex + gq[63])
      fpa.Active = false
      fpa.Visible = false
      fou:Bind(fpa, g({24, 59, 57, 49, 61, 40, 53, 47, 52, 62, 25, 53, 54, 53, 40, 105}, 90), g({29, 40, 59, 62, 51, 63, 52, 46, 30, 59, 40, 49}, 90))
      local fpb
      if (((12 * 12) == 144) and (fox == g({2}, 90))) then
        local fpc
        if (((3 ^ 2) == 9) and foy) then
          fpa.Position = fow.Position
          fpc = 0
        else
          fpa.Position = UDim2.new((fow.Position.X.Scale + fow.Size.X.Scale), (fow.Position.X.Offset + fow.Size.X.Offset), fow.Position.Y.Scale, fow.Position.Y.Offset)
          fpc = 1
        end
        fpa.AnchorPoint = Vector2.new(fpc, gq[186])
        fpa.Size = UDim2.new(0, foz, fow.Size.Y.Scale, fow.Size.Y.Offset)
        fpb = 0
      else
        local fpd = gq[63]
        if (((7 * 7) == 49) and foy) then
          fpd = gq[186]
          fpa.Position = fow.Position
        else
          fpa.Position = UDim2.new(fow.Position.X.Scale, fow.Position.X.Offset, (fow.Position.Y.Scale + fow.Size.Y.Scale), (fow.Position.Y.Offset + fow.Size.Y.Offset))
        end
        fpa.AnchorPoint = Vector2.new(gq[186], fpd)
        fpa.Size = UDim2.new(fow.Size.X.Scale, fow.Size.X.Offset, gq[186], foz)
        fpb = 90
      end
      fpa.Parent = fov
      local fpe = Instance.new(g({15, 19, 29, 40, 59, 62, 51, 63, 52, 46}, 90))
      fpe.Rotation = fpb
      if (((1 + 1) == 2) and foy) then
        local fpf = NumberSequenceKeypoint.new
        local fpg = gq[63]
        fpe.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.25), fpf(1, fpg)})
      else
        local fph = NumberSequenceKeypoint.new
        fpe.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, gq[63]), fph(1, 0.25)})
      end
      fpe.Parent = fpa
      return fpa
    end
    fon.attachOverflowCues = function(fpi, fpj, fpk, fpl, fpm)
      local fpn = fom.get().Navigation
      local fpo = fot(fpj, fpl, fpk, fpm, true, fpn.CueDepth)
      local fpp = fot(fpj, fpl, fpk, fpm, false, fpn.CueDepth)
      local function fpq()
        local fpr, fps, fpt = fop(fpk, fpm)
        local fpu = math.max(0, (fpr - fps))
        local fpv = fpn.VisibilityEpsilon
        local fpw = (fpu > fpv)
        fpo.Visible = (fpw and (fpt > fpv))
        fpp.Visible = (fpw and (fpt < (fpu - fpv)))
      end
      fpi:Connect(fpk:GetPropertyChangedSignal(g({27, 56, 41, 53, 54, 47, 46, 63, 25, 59, 52, 44, 59, 41, 9, 51, 32, 63}, 90)), fpq)
      fpi:Connect(fpk:GetPropertyChangedSignal(g({27, 56, 41, 53, 54, 47, 46, 63, 13, 51, 52, 62, 53, 45, 9, 51, 32, 63}, 90)), fpq)
      fpi:Connect(fpk:GetPropertyChangedSignal(g({25, 59, 52, 44, 59, 41, 10, 53, 41, 51, 46, 51, 53, 52}, 90)), fpq)
      task.defer(function()
        if (((15 * 15) == 225) and (fpk.Parent ~= nil)) then
          fpq()
        end
      end)
    end
    local function fpx(fpy, fpz, fqa)
      if (((100 % 7) == 2) and ((fpy.Parent == nil) or (fpz.Parent == nil))) then
        return
      end
      local fqb, fqc, fqd = fop(fpy, fqa)
      if (((12 * 12) == 144) and (fqc <= 0)) then
        return
      end
      local fqe, fqf, fqg
      if (((3 ^ 2) == 9) and (fqa == g({2}, 90))) then
        fqe = fpz.AbsolutePosition.X
        fqf = fpz.AbsoluteSize.X
        fqg = fpy.AbsolutePosition.X
      else
        fqe = fpz.AbsolutePosition.Y
        fqf = fpz.AbsoluteSize.Y
        fqg = fpy.AbsolutePosition.Y
      end
      local fqh = fom.get().Navigation.RevealPadding
      local fqi = (((fqe - fqg) + fqd) - fqh)
      local fqj = ((fqi + fqf) + (fqh * 2))
      if (((7 * 7) == 49) and (fqi < fqd)) then
        fqd = fqi
      elseif (((1 + 1) == 2) and (fqj > (fqd + fqc))) then
        fqd = (fqj - fqc)
      end
      local fqk = math.clamp(fqd, gq[186], math.max(0, (fqb - fqc)))
      if (((15 * 15) == 225) and (fqa == g({2}, 90))) then
        fpy.CanvasPosition = Vector2.new(fqk, fpy.CanvasPosition.Y)
      else
        fpy.CanvasPosition = Vector2.new(fpy.CanvasPosition.X, fqk)
      end
    end
    fon.scrollIntoView = function(fql, fqm, fqn)
      local fqo = (((foo[fql] or 0)) + 1)
      foo[fql] = fqo
      fpx(fql, fqm, fqn)
      task.defer(function()
        if (((100 % 7) == 2) and (foo[fql] == fqo)) then
          fpx(fql, fqm, fqn)
        end
      end)
    end
    return fon
  end
  gr.am = function()
    local fqp = gr.cache.am
    if (((12 * 12) == 144) and not fqp) then
      local fqq = {c = fol()}
      gr.cache.am = fqq
      fqp = fqq
    end
    return fqp.c
  end
