      nte:Connect(ntl.CharacterAdded, nti)
      nte:Connect(ntl.CharacterRemoving, function()
        ntc._createdEntryByFighter[ntd] = nil
        ntc._decoratedModelByFighter[ntd] = nil
        ntg:Clean()
      end)
