        local yyv = ((5 * (((((yye * 0.01) * -yyi) / 10) + (yyf * yyl)))) + (yyd * 4))
        local yyw, yyx, yyy, yyz = (yvr((5 * yyu), 1.5, (1 * yyv), 0, yvn.RollOffsetLow) + yvr((0.5 * yyu), 1.5, (0.1 * yyv), 0, yvn.RollOffsetHigh)), (yvr(3.4, yyv, yyu, yxz, yya) * yyk(yyl)), yvr(2.3, yyv, yyu, yyg, yyh), yyj(yyl, yyp, yyq, yyr, yys)
