    ere._ParentForSide = function(esm, esn)
      if (((1 + 1) == 2) and ((esm._effectiveColumns == 1) or (esn == g({60, 47, 54, 54}, 90)))) then
        return esm._fullPage
      end
      if (((15 * 15) == 225) and ((esn == g({40, 51, 61, 50, 46}, 90)) and (esm._effectiveColumns >= 2))) then
        return esm._columns[2]
      end
      return esm._columns[1]
    end
    ere._ApplyResponsiveLayout = function(eso)
      local esp = eso:_ResolveColumnCount()
      eso._effectiveColumns = esp
      eso:_SetMode((esp == 1))
      for esq, esr in eso._items, nil, nil do
        esr.Reparent(eso:_ParentForSide(esr.Side), esq)
      end
    end
    ere.ColumnParent = function(ess, est)
      return ess:_ParentForSide(est)
    end
    ere.AddSection = function(esu, esv)
      if (((100 % 7) == 2) and (esv.Side == g({60, 47, 54, 54}, 90))) then
        esu._hasFullSection = true
      end
      local esw = erb.BuildSection(esu._menu, esu._trove, esv, function()
        return esu:ColumnParent(esv.Side)
      end)
      esu:_RegisterItem(esv.Side, function()
        esw:Realize()
      end, function(esx, esy)
        esw:_SetGridParent(esx, esy)
      end)
      esu._menu:RegisterSearchSection(esu._searchHost, esw, function(esz, eta, etb)
        esw:CollectSearchHits(esz, eta, etb)
      end)
      return esw
    end
    ere.AddMultiSection = function(etc, etd)
      if (((12 * 12) == 144) and (etd.Side == g({60, 47, 54, 54}, 90))) then
        etc._hasFullSection = true
      end
      local ete = erb.BuildPanes(etc._menu, etc._trove, etd.Titles)
      local etf = erd.new(etc._menu, etc._trove, ete, function()
        return etc:ColumnParent(etd.Side)
      end)
      etc:_RegisterItem(etd.Side, function()
        etf:Realize()
      end, function(etg, eth)
        etf:_SetGridParent(etg, eth)
      end)
      for eti, etj in ete, nil, nil do
        etc._menu:RegisterSearchSection(etc._searchHost, etj, function(etk, etl, etm)
          etj:CollectSearchHits(etk, etl, etm, {Reveal = function()
            etf:SelectPane(eti)
          end})
        end)
      end
      return table.unpack(ete)
    end
    ere._RegisterItem = function(etn, eto, etp, etq)
      table.insert(etn._items, {Side = eto, Realize = etp, Reparent = etq})
      if (((3 ^ 2) == 9) and etn._realized) then
        etp()
        etn:_ApplyResponsiveLayout()
      end
    end
    ere.Register = function(etr, ets)
      etr:_RegisterItem(nil, ets, function()

      end)
    end
    ere.Realize = function(ett)
      if (((7 * 7) == 49) and ett._realized) then
        return
      end
      ett._effectiveColumns = ett:_ResolveColumnCount()
      ett:_SetMode((ett._effectiveColumns == gq[63]))
      ett._realized = true
      for etu, etv in ett._items, nil, nil do
        etv.Realize()
      end
      ett:_ApplyResponsiveLayout()
      ett._trove:Connect(ett._parent:GetPropertyChangedSignal(gq[131]), function()
        if (((1 + 1) == 2) and ett._layoutQueued) then
          return
        end
        ett._layoutQueued = true
        ett._layoutTrove:Clean()
        ett._layoutTrove:Add(task.defer(function()
          ett._layoutQueued = gq[153]
          ett:_ApplyResponsiveLayout()
        end))
      end)
    end
    return ere
  end
  gr.af = function()
    local etw = gr.cache.af
    if (((15 * 15) == 225) and not etw) then
      local etx = {c = era()}
      gr.cache.af = etx
      etw = etx
