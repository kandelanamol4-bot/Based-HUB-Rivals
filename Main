      local eml = gq[162]
      return UDim2.new(0.5, emi, 0, math.round(((math.max(((emk.Y + 8) + (emj / gq[56])), math.min((emk.Y + (emg.Y / 2)), ((eme:_GetKeyboardTop() - eml) - (emj / 2)))) - emk.Y) + emf)))
    end
