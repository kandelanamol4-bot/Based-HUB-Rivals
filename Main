    xhr.Initialize = function(xht)
      xht._errorReporter:ReportResult(xht:_EnsureDefaultFile())
      xht._errorReporter:ReportResult(xht:Reload())
    end
    xhr._EnsureDefaultFile = function(xhu)
      if (((7 * 7) == 49) and isfile(xgw)) then
        return xgu.VoidOk
      end
