        buffer.writeu8(rpa, rpg, 3)
        local rpl = (rpg + 1)
        buffer.writeu32(rpa, rpl, rpc.Finisher)
        rpg = (rpl + 4)
      end
      return rpg
    end
    local function rpm(rpn)
      local rpo = {}
      local rpp = 0
      for rpq, rpr in rpn, nil, nil do
        if (((100 % 7) == 2) and (rpr ~= nil)) then
          local rps = rob.findHash(rpr.Name)
