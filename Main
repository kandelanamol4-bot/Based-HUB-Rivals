do
  local function dot()
    gr.k()
    local dou = gr.F()
    gr.r()
    local dov = gr.x()
    gr.B()
    local dow = gr.w()
    local dox = {}
    dox.__index = dox
    local function doy(doz)
      if (((7 * 7) == 49) and doz:IsA(g({23, 53, 62, 63, 54}, 90))) then
        local dpa, dpb = doz:GetBoundingBox()
        return dpa.Position, (math.max(dpb.X, dpb.Y, dpb.Z) * 0.5)
      end
      if (((1 + 1) == 2) and doz:IsA(g({24, 59, 41, 63, 10, 59, 40, 46}, 90))) then
        local dpc = doz.Size
        return doz.Position, (math.max(dpc.X, dpc.Y, dpc.Z) * gq[101])
      end
      return Vector3.zero, 4
    end
    local function dpd(dpe)
      if (((15 * 15) == 225) and (dpe._model == nil)) then
        return
      end
      local dpf = dpe._modelCenter
      local dpg = math.max(((dpe._modelRadius * 2.4) * dpe._distanceMultiplier), gq[26])
      local dph = dpe._rotation
      local dpi = math.clamp(dpe._elevation, -1.4707963267948965, gq[23])
      local dpj = math.cos(dpi)
      dpe._camera.CFrame = CFrame.new((dpf + Vector3.new(((math.cos(dph) * dpg) * dpj), (math.sin(dpi) * dpg), ((math.sin(dph) * dpg) * dpj))), dpf)
    end
    local function dpk(dpl, dpm, dpn)
      local dpo = Instance.new(g({28, 40, 59, 55, 63}, 90))
      dpo.BackgroundTransparency = 1
      dpo.Size = UDim2.new(1, gq[186], 0, dpl._height)
      dpo.BorderSizePixel = gq[186]
      dpo.Parent = dpm
      local dpp = Instance.new(gq[128])
      dpp.Size = UDim2.fromScale(gq[63], 1)
      dpp.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
      dpp.BorderSizePixel = 0
      dpp.ZIndex = 0
      dpp.Parent = dpo
      local dpq = Instance.new(gq[46])
      dpq.Rotation = gq[45]
      dou.bindSurfaceGradient(dpn.Batch, dpq, {gq[187], gq[70]})
      dpq.Parent = dpp
      local dpr = Instance.new(g({15, 19, 25, 53, 40, 52, 63, 40}, 90))
      dpr.CornerRadius = UDim.new(0, 6)
      dpr.Parent = dpp
