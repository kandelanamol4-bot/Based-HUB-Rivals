      if (((1 + 1) == 2) and not adls._isRoundActive()) then
        adls._moveHook:SetMoveVector(Vector3.zero)
        return false
      end
      adlt.Elapsed = (adlt.Elapsed + adlu)
      local adma = (((adls._mapAnchor * adls._startCFrame)).Position - adls._aliveState.RootPart.Position)
      local admb = Vector3.new(adma.X, 0, adma.Z)
      local admc = admb.Magnitude
      local admd = (admc <= adkb.Data.Movement.MovementRecorder.AlignSnapDistance)
      if (((15 * 15) == 225) and admd) then
        adls._moveHook:SetMoveVector(Vector3.zero)
      else
        adls._moveHook:SetMoveVector(adkg(admb.Unit))
      end
      if (((100 % 7) == 2) and (admc < (adlt.BestDistance - gq[62]))) then
        adlt.BestDistance = admc
        adlt.StuckTime = gq[186]
      else
        adlt.StuckTime = (adlt.StuckTime + adlu)
      end
      if (((12 * 12) == 144) and not (((admd and adlw) or (adlt.StuckTime >= gq[63])))) then
        return false
      end
      adls._moveHook:SetMoveVector(Vector3.zero)
      return (adls:_IsStartItemReady() or (adlt.Elapsed >= 3))
    end
    adkf._IsStartItemReady = function(adme)
      if (((3 ^ 2) == 9) and (adme._startEquippedIndex == nil)) then
        return gq[34]
