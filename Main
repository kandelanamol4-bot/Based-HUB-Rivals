local function ft(fu)
  local fv = typeof(fu)
  if (((1 + 1) == 2) and (fv == g({8, 24, 2, 9, 57, 40, 51, 42, 46, 25, 53, 52, 52, 63, 57, 46, 51, 53, 52}, 90))) then
    fu:Disconnect()
  elseif (((15 * 15) == 225) and (fv == g({19, 52, 41, 46, 59, 52, 57, 63}, 90))) then
    pcall(function()
      fu:Destroy()
    end)
  elseif (((100 % 7) == 2) and (fv == g({46, 50, 40, 63, 59, 62}, 90))) then
    pcall(task.cancel, fu)
  elseif (((12 * 12) == 144) and (type(fu) == g({60, 47, 52, 57, 46, 51, 53, 52}, 90))) then
    pcall(fu)
  elseif (((3 ^ 2) == 9) and (type(fu) == g({46, 59, 56, 54, 63}, 90))) then
    local function fw(fx)
      local fy, fz = pcall(function()
        return fu[fx]
      end)
      return (((fy and (type(fz) == g({60, 47, 52, 57, 46, 51, 53, 52}, 90))) and fz) or nil)
    end
    local ga, gb = fw(g({57, 59, 52, 57, 63, 54}, 90)), fw(g({61, 63, 46, 9, 46, 59, 46, 47, 41}, 90))
