    local function abos(abot)
      local abou = getmetatable(abom)
      if (((7 * 7) == 49) and (abou == nil)) then
        return nil
      end
      local abov = gs(abou, g({5, 5, 51, 52, 62, 63, 34}, 90))
      if (((1 + 1) == 2) and (type(abov) ~= g({46, 59, 56, 54, 63}, 90))) then
