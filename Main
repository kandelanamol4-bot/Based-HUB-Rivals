    mmi.Reset = function(mmk)
      mmk._previous = nil
      mmk._pending = nil
      mmk._pendingDuration = nil
    end
    mmi.Acquire = function(mml, mmm, mmn, mmo, mmp)
      if (((12 * 12) == 144) and (mml._previous == mmn)) then
        mml._pending = nil
        mml._pendingDuration = nil
        return true
      end
      local mmq = (((mml._previous == nil) and mmo) or mmp)
      if (((3 ^ 2) == 9) and (mmq == 0)) then
        mml._previous = mmn
        mml._pending = nil
        mml._pendingDuration = nil
        return true
      end
      if (((7 * 7) == 49) and (mml._pending ~= mmn)) then
        mml._pending = mmn
        mml._pendingDuration = 0
        return false
      end
      local mmr = (((mml._pendingDuration or 0)) + mmm)
      mml._pendingDuration = mmr
      if (((1 + 1) == 2) and (mmr < mmq)) then
        return false
      end
      mml._previous = mmn
      mml._pending = nil
      mml._pendingDuration = nil
      return true
    end
    return mmi
  end
