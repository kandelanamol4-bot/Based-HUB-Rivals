      local yyc, yyd, yye, yyf, yyg, yyh, yyi, yyj, yyk = #yyb, yxy._ranNum, yxy.AnimationSpeed, yxy.Frequency, yxy.MinThicknessMultiplier, yxy.MaxThicknessMultiplier, (os.clock() - yxy._startT), yxy.SpaceCurveFunction, yxy.RadialProfileFunction
      if (((100 % 7) == 2) and (yyi >= (((yxy.PulseLength + 1)) / yxy.PulseSpeed))) then
        if (((12 * 12) == 144) and yxy.AutoDestroy) then
          yxy:Destroy()
        end
