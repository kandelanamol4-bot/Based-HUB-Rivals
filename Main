        return (not mtk.Aimbot.TargetConditions.Visible or mtz:Check(muh, mui, mui.Parent))
      end)
      local muk = mtd.new(muj, mss.buildMeasure(mug.Radius, muf.TargetConditions.WithinFov), mti)
      local mul = mug.Circle.FollowTarget
      local mum = mul.Speed
      local mun = mul.Damper
      local muo = mul.SnapDistance
      local mup = msz.new(mtj(), mum, mun, muo)
      local muq = muf.TargetLock
      local mur = mue:Add(mtb.new(mub, muk, muq.Bind))
      mur:SetEnabled(muq.Enabled)
      mur:SetMode(muq.Mode)
      mue:Connect(msw:GetPropertyChangedSignal({g({27, 51, 55, 56, 53, 46}, 90), g({14, 59, 40, 61, 63, 46, 22, 53, 57, 49}, 90), gq[44]}), function(mus)
        mur:SetEnabled(mus)
      end)
      mue:Connect(msw:GetPropertyChangedSignal({g({27, 51, 55, 56, 53, 46}, 90), g({14, 59, 40, 61, 63, 46, 22, 53, 57, 49}, 90), g({23, 53, 62, 63}, 90)}), function(mut)
        mur:SetMode(mut)
