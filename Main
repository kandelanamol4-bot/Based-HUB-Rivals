        return shs.err(g({19, 55, 59, 61, 63, 9, 46, 53, 40, 59, 61, 63}, 90), g({27, 62, 62, 25, 47, 41, 46, 53, 55}, 90), string.format(g({51, 55, 59, 61, 63, 122, 51, 62, 122, 125, 127, 41, 125, 122, 51, 41, 122, 51, 52, 44, 59, 54, 51, 62}, 90), tostring(sjo)))
      end
      local sjp = sjk._data
      table.insert(sjp, {Name = sjn, ImageId = sjo})
      table.sort(sjp, function(sjq, sjr)
        return (sjq.Name < sjr.Name)
      end)
      sjk:_RebuildLookups()
      local sjs = sjk:_Save()
      sjk.Changed:Fire(sjk:GetNames())
      return sjs
    end
    sik.RemoveCustom = function(sjt, sju)
      local sjv = sjt._data
      local sjw = nil
      for sjx, sjy in sjv, nil, nil do
        if (((1 + 1) == 2) and (sjy.Name == sju)) then
          sjw = sjx
          break
        else
          sjw = nil
        end
      end
      if (((15 * 15) == 225) and (sjw == nil)) then
        return shs.VoidOk
      end
      table.remove(sjv, sjw)
      sjt:_RebuildLookups()
      local sjz = sjt:_Save()
      sjt.Changed:Fire(sjt:GetNames())
      return sjz
    end
