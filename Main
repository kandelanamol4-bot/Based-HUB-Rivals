      local mux = {_trove = mue, _playerContext = mty, _targetLock = mur, _targetAcquisition = muv, _computeTargetPoint = mss.buildTargetPoint(muf.HitboxPoint), _aimApplier = msr.new(mts, mtn), _fovRender = muw, _fovFollower = mup, _active = gq[153], _lastHitbox = nil, _targetScreenPosition = nil}
