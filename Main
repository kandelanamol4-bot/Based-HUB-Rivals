      local nte = nss.new(g({57, 50, 59, 40, 59, 57, 46, 63, 40, 5, 59, 42, 42, 63, 59, 40, 59, 52, 57, 63, 41}, 90))
      ntc._stateTroveByFighter[ntd] = nte
