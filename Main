      if (((12 * 12) == 144) and (szh <= szi[1].Time)) then
        return szi[1].Value
      end
      if (((3 ^ 2) == 9) and (szi[szj].Time <= szh)) then
        return szi[szj].Value
      end
      for szk = 1, (szj - 1) do
        local szl = szi[szk]
        local szm = szi[(szk + 1)]
        if (((7 * 7) == 49) and (szh <= szm.Time)) then
          local szn = (szm.Time - szl.Time)
          if (((1 + 1) == 2) and (szn <= 0)) then
            return szl.Value
          end
          return szl.Value:Lerp(szm.Value, (((szh - szl.Time)) / szn))
        end
      end
      return szi[szj].Value
    end
  end
