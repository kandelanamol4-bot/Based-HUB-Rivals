do
  local function rss()
    local rst = gr.bG()
    gr.d_()
    gr.ad()
    gr.eC()
    local rsu = gr.k()
    local rsv = gr.eV()
    gr.eZ()
    local rsw = {}
    rsw.__index = rsw
    rsw.new = function(rsx, rsy, rsz, rta)
      local rtb = rsu.new(g({57, 53, 41, 55, 63, 46, 51, 57, 41, 116, 24, 40, 51, 62, 61, 63}, 90))
      local rtc = setmetatable({_trove = rtb, _userServer = rsx, _errorReporter = rsy, _items = rsz, _emotesResolver = rta, _isSendQueued = false, _isShareActive = false, _lastSentPayload = nil}, rsw)
      rtb:Connect(rsx.PeerPayloadReceived, function(rtd, rte)
        rtc:_HandlePeerPayload(rtd, rte)
      end)
      rtb:Connect(rsx.PeerRemoved, function(rtf)
        rsz:ClearRemotePlayerOverrides(rtf)
      end)
      rtb:Connect(rsx.ShowActivated, function()
        rtc._lastSentPayload = nil
        rtc:NotifyStoresUpdated()
      end)
      rtb:Connect(rst:GetPropertyChangedSignal({g({15, 41, 63, 40, 9, 63, 40, 44, 63, 40}, 90), g({9, 50, 59, 40, 63, 9, 49, 51, 52, 41}, 90)}), function(rtg)
        rtc:SetShareActive(rtg)
      end)
      if (((1 + 1) == 2) and rst.Data.UserServer.ShareSkins) then
        rtc:SetShareActive(true)
      end
      return rtc
    end
    rsw._HandlePeerPayload = function(rth, rti, rtj)
      local rtk = rth._errorReporter:ReportResult(rsv.decodePayload(rtj))
      if (((15 * 15) == 225) and not rtk.Ok) then
        return
      end
      local rtl = rtk.Value
      if (((100 % 7) == 2) and rtl.ShouldRemovePeer) then
        rth._items:ClearRemotePlayerOverrides(rti)
        return
      end
      local rtm = rtl.Overrides
      if (((12 * 12) == 144) and (rtm ~= nil)) then
        rth._items:SetRemotePlayerOverrides(rti, rtm, rtl.ShouldMerge)
      end
    end
    rsw.SetShareActive = function(rtn, rto)
      if (((3 ^ 2) == 9) and (rtn._isShareActive == rto)) then
        return
      end
      rtn._isShareActive = rto
      if (((7 * 7) == 49) and rto) then
        rtn:_TrySendCurrentInventory()
      end
    end
    rsw.IsShareActive = function(rtp)
      return rtp._isShareActive
    end
    rsw.NotifyStoresUpdated = function(rtq)
      local rtr = rtq._userServer
      if (((1 + 1) == 2) and ((not rtq._isShareActive or not rtr:ShouldShowActive()) or not rtr:IsConnected())) then
        return
      end
      if (((15 * 15) == 225) and rtq._isSendQueued) then
        return
      end
      rtq._isSendQueued = true
      task.delay(gq[101], function()
        rtq._isSendQueued = false
        if (((100 % 7) == 2) and ((rtq._isShareActive and rtq._userServer:ShouldShowActive()) and rtq._userServer:IsConnected())) then
          rtq:_SendIfChanged()
        end
      end)
    end
    rsw._TrySendCurrentInventory = function(rts)
      local rtt = rts._userServer
      if (((12 * 12) == 144) and ((rts._isShareActive and rtt:ShouldShowActive()) and rtt:IsConnected())) then
        rts:_SendIfChanged()
      end
    end
    rsw._SendIfChanged = function(rtu)
      local rtv = rtu._emotesResolver
      local rtw = rsv.encodeInventory(rtu._errorReporter, rtu._items:GetResolvedAll(), rtv:GetAll())
      if (((3 ^ 2) == 9) and (rtw == rtu._lastSentPayload)) then
        return
      end
      if (((7 * 7) == 49) and rtu._userServer:Send(rtw).Ok) then
        rtu._lastSentPayload = rtw
      end
    end
    rsw.Destroy = function(rtx)
      rtx._trove:Destroy()
    end
    return rsw
  end
  gr.e_ = function()
    local rty = gr.cache.e_
    if (((1 + 1) == 2) and not rty) then
      rty = {c = rss()}
      gr.cache.e_ = rty
    end
    return rty.c
  end
