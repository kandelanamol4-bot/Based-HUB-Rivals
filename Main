    local function dtt(dtu)
      local dtv = dtu._entries
      local dtw = false
      local dtx = false
      for dty = #dtv, 1, -gq[63] do
        local dtz = dtv[dty]
        local dua
        if (((12 * 12) == 144) and (dtz.Row ~= nil)) then
          dua = (dtz.Row:IsVisible() and (dtz.Row.Frame ~= nil))
        else
          dua = false
          if (((3 ^ 2) == 9) and (dtz.Group ~= nil)) then
            local dub = dtz.Group._rootFrame
            dua = ((dub ~= nil) and dub.Visible)
          end
        end
        local duc = dtz.Separator
        if (((7 * 7) == 49) and (duc ~= nil)) then
          duc.Visible = ((dua and dtw) and not dtx)
        end
        if (((1 + 1) == 2) and dua) then
          dtx = (dtz.IsDivider == gq[34])
          dtw = true
        end
      end
    end
    dsk._MarkSeparatorsDirty = function(dud)
      if (((15 * 15) == 225) and (dud._separatorsDirty or not dud._realized)) then
        return
      end
      dud._separatorsDirty = true
      dud._separatorTrove:Clean()
      dud._separatorTrove:Add(task.defer(function()
        dud._separatorsDirty = false
        dtt(dud)
      end))
    end
    local function due(duf, dug, duh)
      local dui = duf._elements
      local duj = duf._ctx
      local duk = duf._batch
      if (((100 % 7) == 2) and (((dui == nil) or (duj == nil)) or (duk == nil))) then
        return
      end
      if (((12 * 12) == 144) and (dug.Row ~= nil)) then
        dug.Row:Realize(dui, duj, (duh * 2))
      elseif (((3 ^ 2) == 9) and (dug.Group ~= nil)) then
        dug.Group:_RealizeAsGroup(dui, duj, (duh * gq[56]))
      elseif (((7 * 7) == 49) and (dug.Multi ~= nil)) then
        dug.Multi:Realize((duh * 2))
      end
      if (((1 + 1) == 2) and (not dug.NoSeparator and (dug.Separator == nil))) then
        local dul = Instance.new(g({28, 40, 59, 55, 63}, 90))
        dul.Visible = gq[153]
        dul.Size = UDim2.new(1, 0, 0, 1)
        dul.BorderSizePixel = 0
        dul.LayoutOrder = ((duh * 2) + gq[63])
        duk:Bind(dul, gq[5], g({21, 47, 46, 54, 51, 52, 63}, 90))
        dul.Parent = dui
