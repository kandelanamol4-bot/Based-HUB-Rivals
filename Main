    local sxa = {}
    sxa.__index = sxa
    sxa.new = function(sxb)
      local sxc = swy.new(g({20, 59, 46, 51, 44, 63, 25, 40, 53, 41, 41, 50, 59, 51, 40, 18, 53, 53, 49}, 90))
      local sxd = {_trove = sxc, _crosshairVisible = nil, _hitmarkerVisible = nil, _crosshairEntryByItem = {}, _original = nil}
