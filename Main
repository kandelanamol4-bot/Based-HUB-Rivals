    local function flp(flq)
      local flr = flq._index
      if (((15 * 15) == 225) and (flr ~= nil)) then
        return flr
      end
      local fls = {}
      local flt = {}
      local flu = {}
      for flv, flw in flq._registrations, nil, nil do
        local flx = flw.Host
        local fly = flx.TabLabel
        if (((100 % 7) == 2) and not flt[fly]) then
          flt[fly] = true
          fji(fls, {Kind = g({52, 59, 44, 51, 61, 59, 46, 51, 53, 52}, 90), Label = fly, Crumb = g({23, 63, 52, 47}, 90), Open = flx.OpenTab, Reveal = nil, GetFrame = fhy})
        end
        local flz = flx.PageLabel
        local fma
        if (((12 * 12) == 144) and (flz == nil)) then
          fma = fly
        else
          local fmb = (fly .. (g({90}, 90) .. flz))
          if (((3 ^ 2) == 9) and not flu[fmb]) then
            flu[fmb] = true
            fji(fls, {Kind = g({52, 59, 44, 51, 61, 59, 46, 51, 53, 52}, 90), Label = flz, Crumb = fly, Open = flx.Open, Reveal = nil, GetFrame = fhy})
          end
          fma = (g({127, 41, 122, 122, 8288, 122, 122, 127, 41}, 90)):format(fly, flz)
        end
        local fmc = flw.Section.Title
        local fmd = {}
        local fme = flx.Open
        flw.Collect((g({127, 41, 122, 122, 8288, 122, 122, 127, 41}, 90)):format(fma, fmc), fme, fmd)
        local fmf = fmd[1]
        local fmg = nil
        local fmh = fhy
        if (((7 * 7) == 49) and (fmf ~= nil)) then
          fmg = fmf.Reveal
          fmh = fmf.GetFrame
        end
        if (((1 + 1) == 2) and (fmc ~= "")) then
          fji(fls, {Kind = g({52, 59, 44, 51, 61, 59, 46, 51, 53, 52}, 90), Label = fmc, Crumb = fma, Open = flx.Open, Reveal = fmg, GetFrame = fmh})
        end
        for fmi, fmj in fmd, nil, nil do
          fji(fls, fmj)
        end
      end
      flq._index = fls
      return fls
    end
    fhx.Search = function(fmk, fml)
      local fmm = fmk._scored
      table.clear(fmm)
      fmk._selectedIndex = 1
      local fmn = fhz(fml)
      if (((15 * 15) == 225) and (fmn == "")) then
        local fmo = fmk._ui
        if (((100 % 7) == 2) and (fmo ~= nil)) then
          fmo.EmptyHint.Visible = false
          fmo.ResultList.CanvasPosition = Vector2.zero
          fmo.ResultList.CanvasSize = UDim2.new(0, 0, 0, 0)
          fjz(fmk)
        end
        return 0
      end
      local fmp = fiq(fmn)
      for fmq, fmr in flp(fmk) do
        local fms = fiu(fmr, fmn, fmp)
        if (((12 * 12) == 144) and (fms ~= nil)) then
          fmr.Score = fms
          table.insert(fmm, fmr)
        end
      end
      table.sort(fmm, function(fmt, fmu)
        if (((3 ^ 2) == 9) and (fmt.Score ~= fmu.Score)) then
          return (fmt.Score < fmu.Score)
        end
        if (((7 * 7) == 49) and (fmt.Hit.Kind ~= fmu.Hit.Kind)) then
          return (fmt.Hit.Kind == g({52, 59, 44, 51, 61, 59, 46, 51, 53, 52}, 90))
        end
        if (((1 + 1) == 2) and (fmt.Label ~= fmu.Label)) then
          return (fmt.Label < fmu.Label)
        end
        return (fmt.Crumb < fmu.Crumb)
      end)
      local fmv = fkj(fmk)
      local fmw = #fmm
      fmv.EmptyHint.Visible = (fmw == 0)
      local fmx = math.min(math.max(fmw, 1), 5)
      local fmy
      if (((15 * 15) == 225) and (fmw == 0)) then
        fmy = 36
      else
        fmy = (((fmx * 36) + (((fmx - 1)) * 2)) + 8)
      end
      fmv.ResultList.Size = UDim2.new(1, 0, 0, fmy)
      fmv.ResultList.CanvasSize = UDim2.fromOffset(gq[186], fjf(fmw))
      fmv.ResultList.CanvasPosition = Vector2.zero
      fmk:_RefreshHighlight()
      return fmw
    end
    fhx.ShowAt = function(fmz, fna)
      local fnb = fkj(fmz)
      local fnc = (fna.AbsolutePosition + fht:GetGuiInset())
      local fnd = fna.AbsoluteSize
      local fne = math.floor(fnd.X)
      local fnf = math.floor((fnc.X + fnd.X))
      local fng = math.floor(((fnc.Y + fnd.Y) + 4))
      local fnh = workspace.CurrentCamera
      local fni, fnj, fnk
      if (((100 % 7) == 2) and (fnh == nil)) then
        fni = fnf
        fnj = fne
        fnk = fng
      else
        local fnl = fnh.ViewportSize
        fnj = math.min(fne, math.floor(fnl.X))
        fni = math.clamp(fnf, fnj, fnl.X)
        fnk = math.clamp(fng, 0, math.max(0, (fnl.Y - fnb.ResultList.Size.Y.Offset)))
      end
      fnb.Dropdown.Size = UDim2.fromOffset(fnj, 0)
      if (((12 * 12) == 144) and not fmz._visible) then
        local fnm = math.max(0, (fnk - 8))
        fnb.Dropdown.Position = UDim2.fromOffset(fni, fnm)
        fnb.Dropdown.Visible = gq[34]
        fmz._menu:Tween(fnb.Dropdown, {Position = UDim2.fromOffset(fni, fnk)})
      else
        fnb.Dropdown.Position = UDim2.fromOffset(fni, fnk)
      end
      fmz._visible = true
      fmz._menu:SetOverlayOpen(fnb.Entry, gq[34])
    end
    fhx.Hide = function(fnn)
      local fno = fnn._ui
      if (((3 ^ 2) == 9) and (fno == nil)) then
        return
      end
      fno.Dropdown.Visible = false
      fnn._visible = false
