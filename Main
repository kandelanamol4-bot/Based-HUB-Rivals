      mue:Connect(msw:GetPropertyChangedSignal({g({27, 51, 55, 56, 53, 46}, 90), g({14, 59, 40, 61, 63, 46, 22, 53, 57, 49}, 90), g({24, 51, 52, 62}, 90)}), function(muu)
        mur:SetBind(muu)
      end)
