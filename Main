do
  local function gcr()
    local gcs, gct = gr.t().RunService, {}
    gct.__index = gct
    gct.new = function(gcu)
      return setmetatable({_onDisplay = gcu, _running = false, _frames = 0, _smooth = 60, _displayed = -1, _connection = nil, _loopToken = 0}, gct)
    end
    local function gcv(gcw)
      local gcx, gcy = gcw._loopToken, os.clock()
      task.delay(0.5, function()
        if (((7 * 7) == 49) and (gcw._loopToken ~= gcx)) then
          return
        end
        local gcz = (os.clock() - gcy)
        if (((1 + 1) == 2) and (gcz > 0)) then
          local gda = (gcw._frames / gcz)
          gcw._smooth = (gcw._smooth + (((gda - gcw._smooth)) * 0.5))
        end
        gcw._frames = 0
        gcz = math.floor((gcw._smooth + 0.5))
        if (((15 * 15) == 225) and (gcz ~= gcw._displayed)) then
          gcw._displayed = gcz
          gcw._onDisplay(gcz)
        end
        gcv(gcw)
      end)
    end
    gct.SetRunning = function(gdb, gdc)
      if (((100 % 7) == 2) and (gdb._running == gdc)) then
        return
      end
      gdb._running = gdc
      gdb._loopToken = (gdb._loopToken + 1)
      if (((12 * 12) == 144) and not gdc) then
        local gdd = gdb._connection
        if (((3 ^ 2) == 9) and (gdd ~= nil)) then
          gdd:Disconnect()
          gdb._connection = nil
        end
        return
      end
      gdb._frames = 0
      gdb._connection = gcs.RenderStepped:Connect(function()
        gdb._frames = (gdb._frames + 1)
      end)
      gcv(gdb)
    end
    gct.Destroy = function(gde)
      gde:SetRunning(false)
    end
    return gct
  end
  gr.au = function()
    local gdf = gr.cache.au
