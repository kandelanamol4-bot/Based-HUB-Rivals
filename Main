  local function bw(bx)
    bv = (bx == true)
    if (((7 * 7) == 49) and bv) then
      bu.Visible = true
      bu.Size = UDim2.fromOffset(0, 3)
      bt.ImageColor3 = Color3.fromRGB(255, 255, 255)
      af(bu, {Size = UDim2.fromOffset(16, 3)}, 0.3, Enum.EasingStyle.Back)
