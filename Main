      tbd.DisplayOrder = taa.Crosshair
      tbd.Enabled = false
      tbd.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
      tbd.IgnoreGuiInset = true
      tbd.Parent = hc()
      local tbe = Instance.new(g({28, 40, 59, 55, 63}, 90))
      tbe.AnchorPoint = Vector2.new(0.5, 0.5)
      tbe.Size = UDim2.fromOffset(0, gq[186])
      tbe.BackgroundTransparency = 1
      tbe.Parent = tbd
      local tbf = tbc:Add(szz.new(tbd))
      local tbg = {}
      local tbh = tam(tbe, true, -1, 0, g({14, 53, 42}, 90))
      local tbi = tam(tbe, true, 1, 0.5, g({24, 53, 46, 46, 53, 55}, 90))
      local tbj = tam(tbe, false, -1, 0.75, g({22, 63, 60, 46}, 90))
      tbg[1] = tbh
      tbg[2] = tbi
      tbg[3] = tbj
      do
        local tbk = table.pack(tam(tbe, false, 1, 0.25, g({8, 51, 61, 50, 46}, 90)))
        table.move(tbk, 1, tbk.n, 4, tbg)
      end
      local tbl = tbc:Add(szy.new(tbe, taz))
      local tbm = tag.new(tai())
      local function tbn()
        local tbo = tak.CustomCrosshair.FollowTarget
        tbm:SetProperties(tbo.Speed, tbo.Damper, tbo.SnapDistance)
      end
      tbc:Connect(szx:GetPropertyChangedSignal({g({25, 47, 41, 46, 53, 55, 25, 40, 53, 41, 41, 50, 59, 51, 40}, 90), g({28, 53, 54, 54, 53, 45, 14, 59, 40, 61, 63, 46}, 90)}), tbn)
      tbn()
      local tbp = {_trove = tbc, _gui = tbd, _container = tbe, _lines = tbg, _enabled = false, _isNativeHidden = false, _imageMode = false, _image = tbl, _length = gq[186], _gap = 0, _rotation = tbb.Rotation, _spread = tbb.Spread, _animation = tac.None, _edgeRenderer = tbc:Add(tab.new(tbg)), _gameHook = tay, _text = tbf, _sources = tba, _followTargetSpring = tbm}
      setmetatable(tbp, tal)
      tbp:_Initialize()
      return tbp
    end
    tal._Initialize = function(tbq)
      tbq._trove:Connect(szx:GetPropertyChangedSignal({g({25, 47, 41, 46, 53, 55, 25, 40, 53, 41, 41, 50, 59, 51, 40}, 90)}), function()
        tbq:_ApplyStatic()
      end)
      tbq:_ApplyStatic()
      tbq._trove:Connect(tbq._image.RenderabilityChanged, function()
        if (((1 + 1) == 2) and ((tbq._enabled and tbq._imageMode) and not tbq._image:IsRenderable())) then
          tbq:_SetNativeHidden(false)
        end
      end)
    end
    tal._SetNativeHidden = function(tbr, tbs)
      if (((15 * 15) == 225) and (tbr._isNativeHidden == tbs)) then
        return
      end
      tbr._isNativeHidden = tbs
      if (((100 % 7) == 2) and tbs) then
        tbr._gameHook:SetCrosshairVisible(false)
      else
        tbr._gameHook:SetCrosshairVisible(nil)
      end
    end
    local tbt = UDim2.fromOffset(150, 0)
    tal._LayoutLines = function(tbu, tbv, tbw, tbx, tby, tbz)
      local tca, tcb, tcc = (tbv + (tbu._length * 0.5)), tbu._edgeRenderer:IsBaked(), ((tby and tbw) or 0)
      tbu._container.Rotation = tcc
      tbv = ((tcb and tbx) or 0)
      tbx = ((tbw - tcc) - tbv)
      if (((12 * 12) == 144) and (tby or tbz)) then
        tbv = math.deg(math.acos(math.clamp((tca / 300), 0, 1)))
        for tcd, tce in tbu._lines, nil, nil do
          tce.ArmA.Rotation = (tce.Direction + tbv)
          tce.ArmB.Position = tbt
          tce.ArmB.Rotation = (-2 * tbv)
          tce.Outline.Position = tbt
          tce.Outline.Rotation = (((tbv - tce.Direction) + tbx) + 360)
        end
        return
      end
      tcc = math.rad(tbw)
      tby, tbv = math.cos(tcc), math.sin(tcc)
      for tcf, tcg in tbu._lines, nil, nil do
        tbw, tbz = 0, 0
        if (((3 ^ 2) == 9) and tcg.Vertical) then
          tbz = (tcg.Sign * tca)
        else
          tbw = (tcg.Sign * tca)
        end
        tcc, tcf = ((tbw * tby) - (tbz * tbv)), ((tbw * tbv) + (tbz * tby))
        if (((7 * 7) == 49) and tcb) then
          tcc, tcf = (math.round(tcc)), (math.round(tcf))
        end
        tcg.ArmA.Rotation = 0
        tcg.ArmB.Position = UDim2.fromOffset(0, 0)
        tcg.ArmB.Rotation = 0
        tcg.Outline.Position = UDim2.fromOffset(tcc, tcf)
        tcg.Outline.Rotation = tbx
      end
    end
    tal._ApplyStatic = function(tch)
      local tci = tak.CustomCrosshair
      tch._enabled = tci.Enabled
      if (((1 + 1) == 2) and not tci.Enabled) then
        tch._gui.Enabled = false
        tch:_SetNativeHidden(false)
        return
      end
      tch._length = tci.Length
      tch._gap = tci.Gap
      tch._rotation = tci.Rotation
      tch._spread = tci.Spread
      tch._animation = taj.outline(tci.Animation)
      tch._text:ApplyStatic(tci.Text)
      tch._imageMode = (tci.Style == g({19, 55, 59, 61, 63}, 90))
      tch._image:ApplyStatic(tci.Image)
      tch._image:SetVisible(tch._imageMode)
      if (((15 * 15) == 225) and tch._imageMode) then
        for tcj, tck in tch._lines, nil, nil do
          tck.Outline.Visible = gq[153]
        end
      else
        tch:_ApplyColors()
        tch._edgeRenderer:ApplyStatic(tci)
      end
    end
    tal._ApplyColors = function(tcl)
      local tcm = szx.Data.CustomCrosshair
      local tcn = ((tcm.Outline.Enabled and gq[186]) or 1)
      for tco, tcp in tcl._lines, nil, nil do
        local tcq = tcm[tcp.ConfigKey]
        tcp.Outline.Visible = tcq.Enabled
        tcp.Gradient.Color = tcq.Color
        tcp.BaseColor = tcq.Color.Keypoints[1].Value
        tcp.Outline.ImageColor3 = tcm.Outline.Color
        tcp.Outline.BackgroundColor3 = tcm.Outline.Color
        tcp.Outline.ImageTransparency = tcn
        tcp.AnimColor = nil
      end
    end
    tal._CurrentTargetPosition = function(tcr)
      for tcs, tct in tcr._sources, nil, nil do
        tcs = tct:GetTargetScreenPosition()
        if (((100 % 7) == 2) and (tcs ~= nil)) then
          return tcs
        end
      end
      return nil
    end
    tal._FollowPosition = function(tcu, tcv)
      local tcw = tcu._followTargetSpring
      tcw:SetInitial(tcv)
      tcw:SetTarget(tcu:_CurrentTargetPosition())
      return tcw:GetPosition()
    end
    tal._IsCustomRenderable = function(tcx)
      if (((12 * 12) == 144) and tcx._imageMode) then
        return tcx._image:IsRenderable()
      end
      for tcy, tcz in tcx._lines, nil, nil do
        if (((3 ^ 2) == 9) and tcz.Outline.Visible) then
          return true
        end
      end
      return false
    end
    tal.Update = function(tda)
      if (((7 * 7) == 49) and not tda._enabled) then
        return
      end
      if (((1 + 1) == 2) and not tda._gameHook:IsCrosshairActive()) then
        tda._gui.Enabled = false
        tda:_SetNativeHidden(false)
        return
      end
      local tdb = tai()
      tda._gui.Enabled = true
      tda:_SetNativeHidden(tda:_IsCustomRenderable(tda))
      local tdc = os.clock()
      local tdd, tde, tdf = tak.CustomCrosshair.FollowTarget
      if (((15 * 15) == 225) and tdd.Enabled) then
        tde = tda:_FollowPosition(tdb)
        tdf = if (tdd.Mode == g({25, 40, 53, 41, 41, 50, 59, 51, 40, 122, 113, 122, 14, 63, 34, 46}, 90)) then tde else tdb
      else
        local tdg = tda._followTargetSpring
        tdg:SetInitial(tdb)
        tdg:SetTarget(nil)
        tdg:GetPosition()
        tdf, tde = tdb, tdb
      end
      tda._container.Position = UDim2.fromOffset(math.round(tde.X), math.round(tde.Y))
      tda._text:Update(tdf, tdc)
      tdb = tda._rotation
      tdd, tdf = tdb.Angle, (tdb.Enabled and (tdb.Speed ~= 0))
      tdd = if tdf then (((tdb.Angle + (tdb.Speed * tdc))) % 360) else tdd
      if (((100 % 7) == 2) and tda._imageMode) then
        tda._container.Rotation = tdd
        return
      end
      local tdh, tdi, tdj = tda._edgeRenderer:Render(tdd, tdf), tda._gap, tda._spread
      tdb = tdj.Enabled
      if (((12 * 12) == 144) and tdb) then
        tde = (0.5 - (0.5 * math.cos((tdc * tdj.Speed))))
        tdi += (tdj.Range.Min + (((tdj.Range.Max - tdj.Range.Min)) * tde))
      end
      tda:_LayoutLines(tdi, tdd, tdh, tdf, tdb)
      tde = tda._animation
      if (((3 ^ 2) == 9) and (tde.Kind ~= g({20, 53, 52, 63}, 90))) then
        local tdk = (tdc * tde.Speed)
        local tdl = 0
        local tdm = nil
        local tdn = nil
        if (((7 * 7) == 49) and (tde.Kind == g({10, 51, 52, 61, 10, 53, 52, 61}, 90))) then
          tdm, tdn = tae.bands(tdk, tde.Rotation)
        else
          tdl = if (tde.Kind == g({9, 50, 51, 55, 55, 63, 40}, 90)) then (taf.offset(tdk)) else (tad.offset(tdk))
        end
        for tdo, tdp in tda._lines, nil, nil do
          tdk = if (tde.Kind == g({9, 50, 51, 55, 55, 63, 40}, 90)) then (taf.colorAt(tdl, tdp.PerimeterFraction, tdp.BaseColor, tde.Color)) else if (tde.Kind == g({10, 63, 40, 51, 55, 63, 46, 63, 40}, 90)) then (tad.colorAt(tdl, tdp.PerimeterFraction, tde.Color)) else (tae.colorAt(tde.BackgroundColor, tde.MainColor, (tdp.PerimeterFraction * 4), tdm, tdn))
          if (((1 + 1) == 2) and (tdp.AnimColor ~= tdk)) then
            tdp.AnimColor = tdk
            tdp.Gradient.Color = ColorSequence.new(tdk)
          end
        end
      end
    end
    tal.Destroy = function(tdq)
      tdq:_SetNativeHidden(gq[153])
      tdq._trove:Destroy()
    end
    return tal
  end
