      mue:Connect(msw:GetPropertyChangedSignal({g({27, 51, 55, 56, 53, 46}, 90), g({14, 59, 40, 61, 63, 46, 25, 53, 52, 62, 51, 46, 51, 53, 52, 41}, 90)}), function(mvf)
        muj:SetConditions(mvf)
        muk:SetMeasure(mss.buildMeasure(mtk.Aimbot.Fov.Radius, mvf.WithinFov))
      end)
      mue:Connect(msw:GetPropertyChangedSignal({g({27, 51, 55, 56, 53, 46}, 90), g({14, 59, 40, 61, 63, 46, 18, 51, 46, 56, 53, 34, 63, 41}, 90)}), muz)
      mue:Connect(msw:GetPropertyChangedSignal({g({27, 51, 55, 56, 53, 46}, 90), g({18, 51, 46, 56, 53, 34, 9, 63, 54, 63, 57, 46, 51, 53, 52}, 90)}), mva)
