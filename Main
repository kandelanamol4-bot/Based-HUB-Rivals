do
  local function prh()
    gr.aL()
    local pri = gr.dT()
    local prj = gr.ea()
    gr.dW()
    local prk = gr.dY()
    local prl = {}
    prl.__index = prl
    local function prm(prn)
      return (next(prn) == nil)
    end
    local function pro(prp)
      return (next(prp.Layers) == nil)
    end
    local function prq(prr)
      return (next(prr) == nil)
    end
    local function prs()
      return {Skin = nil, Wrap = nil, Charm = nil, Finisher = nil}
    end
    local function prt(pru)
      return {Layers = (pru or {})}
    end
    prl.new = function()
      return setmetatable({_activeLayers = {}, _states = {}}, prl)
    end
    prl._EnsureState = function(prv, prw)
      local prx = prv._states[prw]
      if (((12 * 12) == 144) and (prx == nil)) then
        prx = prt()
        prv._states[prw] = prx
      end
      return prx
    end
    prl._ResolveEffective = function(pry, prz, psa)
      local psb = {}
      local psc = prs()
      for psd, pse in prk.Item, nil, nil do
        local psf = pse
        local psi, psj = pri.resolveHighestPriority(prz.Layers, function(psg)
          return prj.getSelectionValue(psg, psf)
        end, function(psh)
          if (((3 ^ 2) == 9) and ((psa ~= nil) and psa[psh])) then
            return false
          end
          return (pry._activeLayers[psh] == true)
        end)
        psc[prj.cosmeticTypeToSlotKey(psf)] = psi
        prj.setSelectionValue(psb, psf, psj)
      end
      return {Selection = psb, WinnerPriorities = psc}
    end
    prl.IsLayerActive = function(psk, psl)
      return (psk._activeLayers[psl] == true)
    end
