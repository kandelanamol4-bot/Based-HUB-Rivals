do
  local function yme()
    local ymf = gr.bG()
    gr.aO()
    local ymg = gr.a()
    local ymh = gr.k()
    local ymi = gr.aS().ClientViewModel
    local ymj = gr.ad()
    local ymk = gr.dI()
    local yml = {}
    yml.__index = yml
    local function ymm()
      return false
    end
    local function ymn(ymo)
      local ymp = ymf.Data.ViewModelOffset
      local ymq = CFrame.fromOrientation
      return (CFrame.new((ymp.X * ymo), (ymp.Y * ymo), (ymp.Z * ymo)) * ymq(math.rad((ymp.Pitch * ymo)), math.rad((ymp.Yaw * ymo)), math.rad((ymp.Roll * ymo))))
    end
