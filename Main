          yql._fallback = nil
          yql._childSet[yqn] = nil
          yqn:Destroy()
          yql.ChildRemoved:Fire(yqn)
        end
        yql._childSet[yqm] = true
        yql.ChildAdded:Fire(yqm)
      end)
      yql._trove:Connect(yql._parent.ChildRemoved, function(yqo)
        if (((12 * 12) == 144) and not yql._childSet[yqo]) then
          return
        end
        yql._childSet[yqo] = nil
