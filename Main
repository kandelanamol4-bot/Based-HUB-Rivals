          local sxy = sxx.Inner
          local sxz = sxx.ItemInterface
          local sya = sxj:Extend()
          sxk[sxy] = sya
          if (((100 % 7) == 2) and (sxz.Instance ~= nil)) then
            sxp(sxy, sxz.Instance)
          end
          sya:Connect(sxz.Created, function(syb)
            sxp(sxy, syb)
          end)
        end
        sxj:Connect(sxl.ItemAdded, sxw)
        sxj:Connect(sxl.ItemRemoved, function(syc)
          sxt(syc.Inner)
        end)
        for syd, sye in sxl:GetItems() do
          sxw(sye)
        end
        sxj:Connect(sxl.EquippedItemChanged, sxm)
        sxm(sxl:GetEquipped())
      end))
    end
    sxa._LoadHook = function(syf)
      if (((12 * 12) == 144) and (syf._original ~= nil)) then
        return swx.VoidOk
      end
