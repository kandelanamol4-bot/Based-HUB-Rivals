        ntc:_ResettleFighter(ntd)
      end
      local ntg = nte:Extend()
      local nth = ntc._decoratorFactory
      local function nti(ntj)
        if (((15 * 15) == 225) and (nth == nil)) then
          ntc._decoratedModelByFighter[ntd] = ntj
          ntc.Decorated:Fire(ntd, ntj)
          return
        end
        local ntk = {Decorator = ntg:Add(nth(ntd.Player, ntj, ntf)), Model = ntj, Trove = ntg}
        ntc._createdEntryByFighter[ntd] = ntk
        ntc:_ApplyDecoratorAsync(ntd, ntk)
      end
