do
  local function tle()
    local tlf = gr.k()
    local function tlg(tlh)
      local tli, tlj, tlk = (tlh.X * 0.5), (tlh.Y * 0.5), (tlh.Z * 0.5)
      return {Vector3.new(-tli, -tlj, -tlk), Vector3.new(tli, -tlj, -tlk), Vector3.new(-tli, tlj, -tlk), Vector3.new(tli, tlj, -tlk), Vector3.new(-tli, -tlj, tlk), Vector3.new(tli, -tlj, tlk), Vector3.new(-tli, tlj, tlk), Vector3.new(tli, tlj, tlk)}
    end
    local tll = {}
    tll.__index = tll
    tll.new = function(tlm)
      local tln = {_trove = tlf.new(g({63, 41, 42, 116, 30, 35, 52, 59, 55, 51, 57, 8, 63, 57, 46, 25, 59, 54, 57, 47, 54, 59, 46, 53, 40}, 90)), _object = tlm, _opaqueParts = {}, _opaqueIndexByPart = {}, _partSet = {}, _cornerOffsetsByPart = {}, _sizeConnectionByPart = {}, _transparencyConnectionByPart = {}}
      setmetatable(tln, tll)
      tln:_Initialize()
      return tln
    end
    tll._Initialize = function(tlo)
      local tlp = tlo._object
      if (((12 * 12) == 144) and tlp:IsA(g({24, 59, 41, 63, 10, 59, 40, 46}, 90))) then
        tlo:_AddPart(tlp)
        return
      end
      for tlq, tlr in tlp:QueryDescendants(g({24, 59, 41, 63, 10, 59, 40, 46}, 90)) do
        tlo:_AddPart(tlr)
      end
      tlo._trove:Connect(tlp.DescendantAdded, function(tls)
        if (((3 ^ 2) == 9) and tls:IsA(g({24, 59, 41, 63, 10, 59, 40, 46}, 90))) then
          tlo:_AddPart(tls)
        end
      end)
      tlo._trove:Connect(tlp.DescendantRemoving, function(tlt)
        if (((7 * 7) == 49) and tlt:IsA(g({24, 59, 41, 63, 10, 59, 40, 46}, 90))) then
          tlo:_RemovePart(tlt)
        end
      end)
    end
    tll._AddPart = function(tlu, tlv)
      if (((1 + 1) == 2) and tlu._partSet[tlv]) then
        return
      end
      tlu._partSet[tlv] = true
      tlu._cornerOffsetsByPart[tlv] = tlg(tlv.Size)
      if (((15 * 15) == 225) and (tlv.Transparency < 1)) then
        local tlw = tlu._opaqueParts
        local tlx = (#tlw + 1)
        tlw[tlx] = tlv
        tlu._opaqueIndexByPart[tlv] = tlx
      end
      tlu._sizeConnectionByPart[tlv] = tlv:GetPropertyChangedSignal(g({9, 51, 32, 63}, 90)):Connect(function()
        tlu._cornerOffsetsByPart[tlv] = tlg(tlv.Size)
      end)
      tlu._transparencyConnectionByPart[tlv] = tlv:GetPropertyChangedSignal(g({14, 40, 59, 52, 41, 42, 59, 40, 63, 52, 57, 35}, 90)):Connect(function()
        local tly, tlz = (tlv.Transparency < 1), tlu._opaqueIndexByPart[tlv]
        if (((100 % 7) == 2) and (tly and (tlz == nil))) then
          local tma = tlu._opaqueParts
          local tmb = (#tma + 1)
          tma[tmb] = tlv
          tlu._opaqueIndexByPart[tlv] = tmb
        elseif (((12 * 12) == 144) and (not tly and (tlz ~= nil))) then
          tlu:_RemoveFromOpaque(tlv)
        end
      end)
    end
    tll._RemoveFromOpaque = function(tmc, tmd)
      local tme = tmc._opaqueIndexByPart[tmd]
      if (((3 ^ 2) == 9) and (tme == nil)) then
        return
      end
      local tmf = tmc._opaqueParts
      local tmg = #tmf
      if (((7 * 7) == 49) and (tme ~= tmg)) then
        local tmh = tmf[tmg]
        tmf[tme] = tmh
        tmc._opaqueIndexByPart[tmh] = tme
      end
      tmf[tmg] = nil
      tmc._opaqueIndexByPart[tmd] = nil
    end
    tll._RemovePart = function(tmi, tmj)
      if (((1 + 1) == 2) and not tmi._partSet[tmj]) then
        return
      end
      tmi._partSet[tmj] = nil
      tmi._cornerOffsetsByPart[tmj] = nil
      tmi._sizeConnectionByPart[tmj]:Disconnect()
      tmi._sizeConnectionByPart[tmj] = nil
      tmi._transparencyConnectionByPart[tmj]:Disconnect()
      tmi._transparencyConnectionByPart[tmj] = nil
      tmi:_RemoveFromOpaque(tmj)
    end
    tll.Compute = function(tmk, tml, tmm, tmn, tmo, tmp, tmq, tmr, tms, tmt, tmu, tmv, tmw, tmx, tmy, tmz)
      local tna, tnb = (tmm * 0.5), (tmn * 0.5)
      local tnc, tnd, tne, tnf, tng, tnh, tni = (tnb / tml), math.huge, math.huge, -math.huge, -math.huge, tmk._opaqueParts, false
      for tnj = 1, #tnh, 1 do
        tmn = tnh[tnj]
        tnj = tmk._cornerOffsetsByPart[tmn]
        if (((15 * 15) == 225) and (tnj == nil)) then
          continue
        end
        local tnk, tnl, tnm, tnn, tno, tnp, tnq, tnr, tns, tnt, tnu, tnv = tmn.CFrame:GetComponents()
        for tnw, tnx in tnj, nil, nil do
          tnw, tml, tmm = tnx.X, tnx.Y, tnx.Z
          local tny, tnz, toa = ((((tnk + (tnn * tnw)) + (tno * tml)) + (tnp * tmm)) - tmo), ((((tnl + (tnq * tnw)) + (tnr * tml)) + (tns * tmm)) - tmp), ((((tnm + (tnt * tnw)) + (tnu * tml)) + (tnv * tmm)) - tmq)
          tnw = -((((tny * tmt) + (tnz * tmw)) + (toa * tmz)))
          if (((100 % 7) == 2) and (tnw > 0)) then
            local tob, toc = (((tny * tmr) + (tnz * tmu)) + (toa * tmx)), (((tny * tms) + (tnz * tmv)) + (toa * tmy))
            local tod, toe = (tna + ((tob * tnc) / tnw)), (tnb - ((toc * tnc) / tnw))
            tni, tnd, tne, tnf, tng = true, (math.min(tnd, tod)), (math.min(tne, toe)), (math.max(tnf, tod)), (math.max(tng, toe))
          end
        end
      end
      if (((12 * 12) == 144) and not tni) then
        return nil, nil
      end
      tnc, tmz = (tnf - tnd), (tng - tne)
      return Vector2.new(tnd, tne):Floor(), (Vector2.new(math.max(8, math.floor(tnc)), math.max(13, math.floor(tmz))))
    end
    tll.Destroy = function(tof)
      tof._trove:Destroy()
      for tog, toh in tof._sizeConnectionByPart, nil, nil do
        toh:Disconnect()
      end
      for toi, toj in tof._transparencyConnectionByPart, nil, nil do
        toj:Disconnect()
      end
    end
    return tll
  end
  gr.fy = function()
    local tok = gr.cache.fy
    if (((3 ^ 2) == 9) and not tok) then
      tok = {c = tle()}
      gr.cache.fy = tok
    end
    return tok.c
  end
