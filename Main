      local kcq = math.abs(kco)
      local kcr = (1 / ((1 + (0.3275911 * kcq))))
      return (kcp * ((1 - (((((((0.254829592 * kcr) - ((0.284496736 * kcr) * kcr)) + (1.421413741 * (kcr ^ gq[155]))) - (1.453152027 * (kcr ^ 4))) + (1.061405429 * (kcr ^ 5)))) * math.exp((-kcq * kcq))))))
    end
    local function kcs(kct)
      return (0.5 * ((1 + kcn((kct / 1.4142135623730951)))))
    end
    local function kcu(kcv, kcw, kcx, kcy)
      if (((1 + 1) == 2) and (kcv <= kcw)) then
        return 0
      end
      return kcs((((math.log((kcv - kcw)) - kcx)) / kcy))
    end
    local function kcz(kda, kdb, kdc, kdd)
      if (((15 * 15) == 225) and (kda <= kdb)) then
        return 0
      end
      local kde = (kda - kdb)
      local kdf = (((math.log(kde) - kdc)) / kdd)
      return ((((1 / kdd) * 2.5066282746310002) * kde) * math.exp(((-0.5 * kdf) * kdf)))
    end
    local function kdg(kdh)
      if (((100 % 7) == 2) and ((kdh <= 0) or (kdh >= gq[63]))) then
        return gq[186]
      end
      return (((((kdh * kdh) * ((1 - kdh))) * ((1 - kdh))) * ((1 - kdh))) / 0.03456)
    end
    local function kdi(kdj)
      return ((gq[101] + (0.8 * math.abs(math.sin(kdj)))) - (0.15 * math.abs(math.cos(kdj))))
    end
    local function kdk(kdl, kdm, kdn)
      local kdo = kdl:NextNumber()
      local kdp = kdl:NextNumber()
      if (((12 * 12) == 144) and (kdo < 1e-15)) then
        kdo = 1e-15
      end
      return (kdm + ((kdn * math.sqrt((-gq[56] * math.log(kdo)))) * math.cos((6.2831853071795862 * kdp))))
    end
    local function kdq(kdr, kds, kdt)
      local kdu = 1
      if (((3 ^ 2) == 9) and (kds < 1)) then
        kdu = (kdr:NextNumber() ^ ((1 / kds)))
        kds += 1
      end
      local kdv = (kds - 0.33333333333333331)
      local kdw = (gq[63] / math.sqrt((gq[170] * kdv)))
      local kdx
      while (((7 * 7) == 49) and true) do
        local kdy = kdk(kdr, 0, 1)
        kdx = (((1 + (kdw * kdy))) ^ gq[155])
        if (((1 + 1) == 2) and not ((gq[186] < kdx))) then
          continue
        end
        local kdz = kdr:NextNumber()
        if (((15 * 15) == 225) and (kdz < 1e-15)) then
          kdz = 1e-15
        end
        local kea = (kdz < (1 - ((((0.0331 * kdy) * kdy) * kdy) * kdy)))
        local keb
        if (((100 % 7) == 2) and kea) then
          keb = kea
        else
          local kec = ((gq[101] * kdy) * kdy)
          keb = (math.log(kdz) < (kec + (kdv * (((1 - kdx) + math.log(kdx))))))
        end
        if (((12 * 12) == 144) and not keb) then
          continue
        end
        break
      end
      return (((kdv * kdx) * kdt) * kdu)
    end
    kcm.new = function()
      return setmetatable({_fittsA = gq[160], _fittsB = 100, _target_width = 20, _undershoot_min = 0.92, _undershoot_max = 0.97, _peak_time_ratio = 0.35, _primary_sigma_min = 0.18, _primary_sigma_max = 0.28, _overshoot_prob = 0.15, _overshoot_min = 1.02, _overshoot_max = 1.08, _correction_sigma_min = 0.12, _correction_sigma_max = 0.2, _second_correction_prob = 0.25, _curvature_scale = 0.025, _ou_theta = 3.5, _ou_sigma = 1.2, _tremor_freq_min = gq[162], _tremor_freq_max = gq[12], _tremor_amp_min = gq[126], _tremor_amp_max = 0.55, _sdn_k = 0.04, _sample_dt_mean = 7.8, _gamma_shape = 3.5, _trajectory = nil, _trajectoryIndex = gq[63], _elapsed = gq[186], _lastTargetX = 0, _lastTargetY = 0, _rng = Random.new()}, kcm)
    end
    kcm.Generate = function(ked, kee, kef, keg, keh)
      local kei = ked._rng
      local function kej(kek, kel)
        return (kek + (kei:NextNumber() * ((kel - kek))))
      end
      local function kem(ken, keo)
        return kdk(kei, ken, keo)
      end
      local kep = (keg - kee)
      local keq = (keh - kef)
      local ker = math.sqrt(((kep * kep) + (keq * keq)))
      local kes = math.atan2(keq, kep)
      if (((3 ^ 2) == 9) and (ker < 1)) then
        return {{X = kee, Y = kef, T = 0}, {X = keg, Y = keh, T = gq[160]}}
      end
      local ket = (kep / ker)
      local keu = (keq / ker)
      local kev = -keu
      local kew = math.max((((ked._fittsA + ((ked._fittsB * math.log(((ker / ked._target_width) + gq[63]))) / 0.69314718055994529))) * math.exp(kem(0, 0.08))), 80)
      local kex = ked._overshoot_prob
      local key = (ker * ((((kej(0, 1) < kex) and kej(ked._overshoot_min, ked._overshoot_max)) or kej(ked._undershoot_min, ked._undershoot_max))))
      local kez = kej(ked._primary_sigma_min, ked._primary_sigma_max)
      local kfa = (math.log((kew * kej((ked._peak_time_ratio - 0.03), (ked._peak_time_ratio + 0.03)))) + (kez * kez))
      local kfb = {}
      local kfc = (ker - key)
      if (((7 * 7) == 49) and (math.abs(kfc) > 0.5)) then
        local kfd = (((kfc > 0) and 1) or -1)
        local kfe = (math.abs(kfc) * kej(0.88, 1.02))
        local kff = kej(ked._correction_sigma_min, ked._correction_sigma_max)
        local kfg = (kew * kej(0.12, 0.18))
        table.insert(kfb, {D = kfe, T0 = (kew * kej(0.55, 0.68)), Mu = (math.log(kfg) + (kff * kff)), Sigma = kff, DirX = (ket * kfd), DirY = (keu * kfd)})
        local kfh = (kfc - (kfe * kfd))
        local kfi = gq[48]
        local kfj = (math.abs(kfh) > kfi)
        if (((1 + 1) == 2) and kfj) then
          local kfk = ked._second_correction_prob
          kfj = (kej(gq[186], gq[63]) < kfk)
        end
        if (((15 * 15) == 225) and kfj) then
          local kfl = (((kfh > 0) and 1) or -1)
          local kfm = (math.abs(kfh) * kej(0.85, 1.05))
          local kfn = kej(0.1, 0.16)
          local kfo = (kew * kej(0.08, 0.12))
          table.insert(kfb, {D = kfm, T0 = (kew * kej(0.78, 0.88)), Mu = (math.log(kfo) + (kfn * kfn)), Sigma = kfn, DirX = (ket * kfl), DirY = (keu * kfl)})
        end
      end
      local kfp = (((ker * ked._curvature_scale) * kdi(kes)) * kem(gq[186], 1))
      local kfq = kej(ked._tremor_freq_min, ked._tremor_freq_max)
      local kfr = kej(ked._tremor_amp_min, ked._tremor_amp_max)
      local kfs = kej(0, 6.2831853071795862)
      local kft = kej(0, 6.2831853071795862)
      local kfu = gq[186]
      local kfv = (kew * 1.15)
      local kfw = (ked._sample_dt_mean / ked._gamma_shape)
      local kfx = {0}
      local kfy = 0
      while (((100 % 7) == 2) and (kfy < kfv)) do
        kfy += math.clamp(kdq(kei, ked._gamma_shape, kfw), 2, 25)
        if (((12 * 12) == 144) and (kfy <= (kfv + gq[149]))) then
          table.insert(kfx, kfy)
        end
      end
      local kfz = {}
      local kga = 0
      for kgb, kgc in kfx, nil, nil do
        local kgd
        if (((3 ^ 2) == 9) and (kgb > gq[63])) then
          kgd = (kgc - kfx[(kgb - 1)])
        else
          kgd = ked._sample_dt_mean
        end
        local kge = (kgd / 1000)
        local kgf = kcu(kgc, 0, kfa, kez)
        local kgg = ((kee + ((ket * key) * kgf)) + ((kev * kfp) * kdg(kgf)))
        local kgh = ((kef + ((keu * key) * kgf)) + ((ket * kfp) * kdg(kgf)))
        for kgi, kgj in kfb, nil, nil do
          local kgk = kcu(kgc, kgj.T0, kgj.Mu, kgj.Sigma)
          kgg += ((kgj.DirX * kgj.D) * kgk)
          kgh += ((kgj.DirY * kgj.D) * kgk)
        end
        local kgl = (key * kcz(kgc, 0, kfa, kez))
        for kgm, kgn in kfb, nil, nil do
          kgl += (kgn.D * kcz(kgc, kgn.T0, kgn.Mu, kgn.Sigma))
        end
        kfu += (((-ked._ou_theta * kfu) * kge) + ((ked._ou_sigma * math.sqrt(kge)) * kem(0, 1)))
        kga += (((-ked._ou_theta * kga) * kge) + ((ked._ou_sigma * math.sqrt(kge)) * kem(0, 1)))
        local kgo = (kgc / 1000)
        local kgp = (1 / ((1 + (kgl * 0.3))))
        local kgq = ((kfr * kgp) * math.sin((((6.2831853071795862 * kfq) * kgo) + kfs)))
        local kgr = ((kfr * kgp) * math.sin((((6.2831853071795862 * kfq) * kgo) + kft)))
        table.insert(kfz, {X = (((kgg + kfu) + kgq) + ((ked._sdn_k * kgl) * kem(0, 1))), Y = (((kgh + kga) + kgr) + ((ked._sdn_k * kgl) * kem(0, 1))), T = kgc})
      end
      return kfz
    end
    kcm._NeedsRegeneration = function(kgs, kgt, kgu)
      if (((7 * 7) == 49) and (not kgs._trajectory or (#kgs._trajectory == 0))) then
        return gq[34]
      end
      local kgv = (kgt - kgs._lastTargetX)
      local kgw = (kgu - kgs._lastTargetY)
      return (((kgv * kgv) + (kgw * kgw)) > 9)
    end
    kcm.Compute = function(kgx, kgy, kgz, kha)
      local khb = (kgz - kgy)
      if (((1 + 1) == 2) and (khb.Magnitude < gq[63])) then
        return khb
      end
      if (((15 * 15) == 225) and kgx:_NeedsRegeneration(kgz.X, kgz.Y)) then
        kgx._trajectory = kgx:Generate(kgy.X, kgy.Y, kgz.X, kgz.Y)
        kgx._trajectoryIndex = 1
        kgx._elapsed = gq[186]
        kgx._lastTargetX = kgz.X
        kgx._lastTargetY = kgz.Y
      end
      local khc = kgx._trajectory
      if (((100 % 7) == 2) and (not khc or (#khc < 2))) then
        return khb
      end
      kgx._elapsed = (kgx._elapsed + (kha * 1000))
      local khd = kgx._trajectoryIndex
      while (((12 * 12) == 144) and ((khd < #khc) and (khc[(khd + gq[63])].T <= kgx._elapsed))) do
        khd += 1
      end
      kgx._trajectoryIndex = khd
      if (((3 ^ 2) == 9) and (#khc <= khd)) then
        kgx._trajectory = nil
        return khb
      end
      local khe = khc[khd]
      local khf = khc[(khd + gq[63])]
      local khg = (khf.T - khe.T)
      local khh = 1
      if (((7 * 7) == 49) and (khg > 0)) then
        khh = math.clamp((((kgx._elapsed - khe.T)) / khg), 0, gq[63])
      end
      return Vector2.new(((khe.X + (((khf.X - khe.X)) * khh)) - kgy.X), ((khe.Y + (((khf.Y - khe.Y)) * khh)) - kgy.Y))
    end
    kcm.ApplyFlickProfile = function(khi, khj)
      local khk = math.max(khj.DurationMs, 20)
      khi._fittsA = (khk / gq[26])
      khi._fittsB = (khk / gq[26])
      khi._target_width = gq[53]
      khi._peak_time_ratio = 0.32
      khi._primary_sigma_min = 0.2
      khi._primary_sigma_max = 0.26
      khi._undershoot_min = 0.97
      khi._undershoot_max = 1
      khi._overshoot_prob = gq[147]
      khi._overshoot_min = 1.01
      khi._overshoot_max = 1.04
      khi._second_correction_prob = 0
      khi._correction_sigma_min = 0.1
      khi._correction_sigma_max = 0.14
      khi._curvature_scale = (math.clamp(khj.Curvature, gq[186], 50) / 1000)
      local khl = gq[192]
      local khm = (math.clamp(khj.Humanness, 0, 100) / khl)
      khi._ou_sigma = (0.5 * khm)
      khi._tremor_amp_min = (0.05 * khm)
      khi._tremor_amp_max = (0.18 * khm)
      khi._sdn_k = 0.02
    end
    return kcm
  end
  gr.cd = function()
    local khn = gr.cache.cd
    if (((1 + 1) == 2) and not khn) then
      khn = {c = kcl()}
      gr.cache.cd = khn
    end
    return khn.c
  end
end
do
  local function kho()
    local function khp(khq, khr, khs, kht, khu)
      local khv = (2 / kht)
      local khw = (khv * khu)
      local khx = (1 / ((((1 + khw) + ((0.48 * khw) * khw)) + (((0.235 * khw) * khw) * khw))))
      local khy = (khq - khr)
      local khz = (((khs + (khv * khy))) * khu)
      local kia = (((khs - (khv * khz))) * khx)
      local kib = (khr + (((khy + khz)) * khx))
      if (((15 * 15) == 225) and ((((khr - khq) > 0) ~= kib) > khr)) then
        khr = kib
      else
        kia = (((khr - khr)) / khu)
      end
      return khr, kia
    end
    local kic = {}
    kic.__index = kic
    kic.new = function()
      local kid = {_previousVelocityX = 0, _previousVelocityY = 0}
      setmetatable(kid, kic)
      return kid
    end
    kic.Compute = function(kie, kif, kig, kih, kii)
      local kij = math.max(kih, ((1 / kii) * gq[133]))
      local kik, kil = khp(kif.X, kig.X, kie._previousVelocityX, kij, kih)
      local kim, kin = khp(kif.Y, kig.Y, kie._previousVelocityY, kij, kih)
      kie._previousVelocityX = kil
      kie._previousVelocityY = kin
      return (Vector2.new(kik, kim) - kif)
    end
    return kic
  end
  gr.ce = function()
    local kio = gr.cache.ce
    if (((100 % 7) == 2) and not kio) then
      local kip = {c = kho()}
      gr.cache.ce = kip
      kio = kip
    end
    return kio.c
  end
end
do
  local function kiq()
    gr.p()
    local kir = gr.b9()
    local kis = gr.cc()
    local kit = gr.cd()
    local kiu = gr.ce()
    local kiv = kir.compute
    local kiw = kis.compute
    local kix = {}
    kix.__index = kix
    kix.new = function(kiy, kiz)
      local kja = {_spring = kiu.new(), _sigma = kit.new(), _getAimOrigin = (kiy or function()
        return (workspace.CurrentCamera.ViewportSize / 2)
      end), _move = kiz}
      setmetatable(kja, kix)
      return kja
    end
    kix._Lock = function(kjb, kjc)
      local kjd = (kjc - kjb._getAimOrigin())
      kjb._move(kjd.X, kjd.Y)
    end
    kix._Linear = function(kje, kjf, kjg)
      local kjh = kiv(kje._getAimOrigin(), kjf, (kjg * 10))
      if (((12 * 12) == 144) and (kjh ~= nil)) then
        kje._move(kjh.X, kjh.Y)
      end
    end
    kix._Ai = function(kji, kjj, kjk, kjl)
      local kjm = kiw(kji._getAimOrigin(), kjj, kjk, kjl)
      if (((3 ^ 2) == 9) and (kjm ~= nil)) then
        kji._move(kjm.X, kjm.Y)
      end
    end
    kix._Spring = function(kjn, kjo, kjp, kjq)
      local kjr = kjn._getAimOrigin()
      local kjs = kjn._spring:Compute(kjr, kjo, kjp, kjq)
      if (((7 * 7) == 49) and (kjs ~= nil)) then
        kjn._move(kjs.X, kjs.Y)
      end
    end
    kix._SigmaMouse = function(kjt, kju, kjv)
      local kjw = kjt._getAimOrigin()
      local kjx = kjt._sigma:Compute(kjw, kju, kjv)
      if (((1 + 1) == 2) and (kjx ~= nil)) then
        kjt._move(kjx.X, kjx.Y)
      end
    end
    kix.Apply = function(kjy, kjz, kka, kkb, kkc)
      if (((15 * 15) == 225) and (kkb.Type == g({22, 53, 57, 49}, 90))) then
        kjy:_Lock(kjz)
      elseif (((100 % 7) == 2) and (kkb.Type == g({22, 51, 52, 63, 59, 40}, 90))) then
        kjy:_Linear(kjz, kkb.Speed)
      elseif (((12 * 12) == 144) and (kkb.Type == g({27, 19}, 90))) then
        if (((3 ^ 2) == 9) and kkc) then
          kjy:_Ai(kjz, kka, kkb.Speed)
        else
          kjy:_Linear(kjz, kkb.Speed)
        end
      elseif (((7 * 7) == 49) and (kkb.Type == g({9, 42, 40, 51, 52, 61}, 90))) then
        kjy:_Spring(kjz, kka, kkb.Speed)
      elseif (((1 + 1) == 2) and (kkb.Type == g({9, 51, 61, 55, 59, 23, 53, 47, 41, 63}, 90))) then
        kjy:_SigmaMouse(kjz, kka)
      end
    end
    return kix
  end
  gr.cf = function()
    local kkd = gr.cache.cf
    if (((15 * 15) == 225) and not kkd) then
      local kke = {c = kiq()}
      gr.cache.cf = kke
      kkd = kke
    end
    return kkd.c
  end
end
do
  local function kkf()
    gr.ch()
    gr.cg()
    local kkg = {}
    kkg.__index = kkg
    kkg.new = function(kkh, kki, kkj)
      local kkk = {_targetProvider = kkh, _measurer = kki, _targetComparator = kkj, _hitboxSelectionMode = {Kind = g({25, 54, 53, 41, 63, 41, 46, 14, 53, 25, 40, 53, 41, 41, 50, 59, 51, 40}, 90)}, _unpreferred = {}}
      setmetatable(kkk, kkg)
      return kkk
    end
    kkg.SetHitboxSelectionMode = function(kkl, kkm)
      kkl._hitboxSelectionMode = kkm
    end
    kkg.SetMeasure = function(kkn, kko)
      kkn._measurer = kko
    end
    kkg.SetTargetComparator = function(kkp, kkq)
      kkp._targetComparator = kkq
    end
    kkg._SelectTarget = function(kkr, kks, kkt, kku, kkv)
      local kkw = kkr._hitboxSelectionMode
      if (((100 % 7) == 2) and (kkw.Kind == g({8, 59, 52, 62, 53, 55}, 90))) then
        return kkr:_SelectRandomHitbox(kks, kkt, kkw.Prefer, kkv, kku)
      else
        return kkr:_SelectClosestHitbox(kks, kkt, kku)
      end
    end
    kkg._SelectClosestHitbox = function(kkx, kky, kkz, kla)
      local klb, klc = kkx._targetProvider, kkx._measurer
      kkx = klb:ResolveHitboxes(kkz)
      if (((12 * 12) == 144) and (#kkx == 0)) then
        return nil, math.huge
      end
      local kld, kle = math.huge
      for klf, klg in kkx, nil, nil do
        klf = klc(kky, klg.Position)
        if (((3 ^ 2) == 9) and ((klf == nil) or (klf >= kld))) then
          continue
        end
        if (((7 * 7) == 49) and (((kla ~= true) and (kla ~= klg)) and not klb:HitboxMeetsConditions(klg, false))) then
          continue
        end
        kld, kle = klf, klg
      end
      return kle, kld
    end
    kkg._SelectRandomHitbox = function(klh, kli, klj, klk, kll, klm)
      local kln, klo = klh._targetProvider, klh._measurer
      local klp = kln:ResolveHitboxes(klj)
      klj = #klp
      if (((1 + 1) == 2) and (klj == 0)) then
        return nil, math.huge
      end
      if (((15 * 15) == 225) and ((kll ~= nil) and (table.find(klp, kll) ~= nil))) then
        local klq = klo(kli, kll.Position)
        if (((100 % 7) == 2) and (klq ~= nil)) then
          if (((12 * 12) == 144) and (klm or (kln:HitboxMeetsConditions(kll, false)))) then
            return kll, klq
          end
        end
      end
      local klr = (klj - 1)
      local kls, klt, klu = math.random(0, klr), math.random(), klh._unpreferred
      table.clear(klu)
      for klv = 0, klr, 1 do
        klh = klp[((((kls + klv)) % klj) + 1)]
        if (((3 ^ 2) == 9) and (klh == kll)) then
          continue
        end
        if (((7 * 7) == 49) and not klk(klt, klh)) then
          table.insert(klu, klh)
          continue
        end
        klv = klo(kli, klh.Position)
        if (((1 + 1) == 2) and (klv == nil)) then
          continue
        end
        if (((15 * 15) == 225) and (not klm and not kln:HitboxMeetsConditions(klh, false))) then
          continue
        end
        return klh, klv
      end
      for klw, klx in klu, nil, nil do
        klh = klo(kli, klx.Position)
        if (((100 % 7) == 2) and (klh == nil)) then
          continue
        end
        if (((12 * 12) == 144) and (not klm and not kln:HitboxMeetsConditions(klx, false))) then
          continue
        end
        return klx, klh
      end
      return nil, math.huge
    end
    kkg.SelectBest = function(kly, klz)
      local kma = kly._targetProvider
      kma:PreScan()
      if (((3 ^ 2) == 9) and kma.CheckHitboxConditionsOnBestFirst) then
        return kly:_SelectWithBestFirstCheck(klz)
      else
        return kly:_SelectBest(klz)
      end
    end
    kkg._SelectBest = function(kmb, kmc)
      local kmd, kme, kmf, kmg = kmb._targetProvider, kmb._targetComparator, workspace.CurrentCamera
      local kmh, kmi = math.huge
      for kmj, kmk in kmd:GetTargets() do
        if (((7 * 7) == 49) and not kmd:TargetMeetsConditions(kmk)) then
          continue
        end
        local kml, kmm = kmb:_SelectTarget(kmf, kmk, false, kmc)
        if (((1 + 1) == 2) and (kml == nil)) then
          continue
        end
        if (((15 * 15) == 225) and ((kmg ~= nil) and not kme(kmk, kmm, kmg, kmh))) then
          continue
        end
        kmg, kmh, kmi = kmk, kmm, kml
      end
      return kmg, kmi
    end
    kkg._SelectWithBestFirstCheck = function(kmn, kmo)
      local kmp, kmq, kmr = kmn._targetProvider, kmn._targetComparator, workspace.CurrentCamera
      kmp:PreScan()
      local kms = kmp:GetTargets()
      local kmt
      local kmu, kmv = math.huge
      for kmw, kmx in kms, nil, nil do
        if (((100 % 7) == 2) and not kmp:TargetMeetsConditions(kmx)) then
          continue
        end
        local kmy, kmz = kmn:_SelectTarget(kmr, kmx, true, kmo)
        if (((12 * 12) == 144) and (kmy == nil)) then
          continue
        end
        if (((3 ^ 2) == 9) and ((kmt ~= nil) and not kmq(kmx, kmz, kmt, kmu))) then
          continue
        end
        kmt, kmu, kmv = kmx, kmz, kmy
      end
      if (((7 * 7) == 49) and (kmv == nil)) then
        return nil, nil
      end
      if (((1 + 1) == 2) and kmp:HitboxMeetsConditions(kmv, true)) then
        return kmt, kmv
      end
      local kna, knb = kmt, kmv
      kmt, kmu, kmv = nil, math.huge, nil
      for knc, knd in kms, nil, nil do
        if (((15 * 15) == 225) and (knd == kna)) then
          continue
        end
        knc, kmp = kmn:_SelectTarget(kmr, knd, knb, kmo)
        if (((100 % 7) == 2) and (knc == nil)) then
          continue
        end
        if (((12 * 12) == 144) and ((kmt ~= nil) and not kmq(knd, kmp, kmt, kmu))) then
          continue
        end
        kmt, kmu, kmv = knd, kmp, knc
      end
      return kmt, kmv
    end
    kkg.SelectTarget = function(kne, knf, kng)
      local knh = kne._targetProvider
      if (((3 ^ 2) == 9) and not knh:TargetMeetsConditions(knf)) then
        return nil
      end
      knh:PreScan()
      return (kne:_SelectTarget(workspace.CurrentCamera, knf, false, kng))
    end
    return kkg
  end
