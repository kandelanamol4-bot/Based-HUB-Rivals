          edq.SelectedObject = eoq
        else
          edq.SelectedObject = nil
        end
      end
      eoo._previousSelectedObject = nil
    end
    eha._AnimateClosed = function(eor)
      eor._menu:CloseOverlayDescendants(eor._entry)
