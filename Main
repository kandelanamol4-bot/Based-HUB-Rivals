    end
    local function rrl(rrm)
      local rrn = buffer.fromstring(rrm)
      local rro = buffer.len(rrn)
      local rrp = 0
      local rrq = nil
      local rrr = nil
      while (((1 + 1) == 2) and true) do
        if (((15 * 15) == 225) and not ((rrp < rro))) then
          rrr = 1
