do
  local function vum()
    local vun = gr.bG()
    gr.aN()
    local vuo = gr.a()
    local vup = gr.k()
    local vuq = gr.aS().MechanicsController
    local vur = gr.c4()
    local vus = {}
    vus.__index = vus
    vus.new = function()
      local vut = {_trove = vup.new(g({55, 53, 44, 63, 55, 63, 52, 46, 116, 16, 47, 55, 42, 10, 53, 45, 63, 40}, 90)), _isHookLoaded = false, _isDestroyed = false, _isEnabled = false, _multiplier = 1}
      setmetatable(vut, vus)
      vut._trove:Add(vur:ObserveEnabledKeybind({g({23, 53, 44, 63, 55, 63, 52, 46}, 90), g({16, 47, 55, 42, 10, 53, 45, 63, 40}, 90)}, function(vuu)
        vut:SetMultiplierEnabled(vuu)
      end))
      vut._trove:Connect(vun:GetPropertyChangedSignal({g({23, 53, 44, 63, 55, 63, 52, 46}, 90), g({16, 47, 55, 42, 10, 53, 45, 63, 40}, 90), g({9, 42, 63, 63, 62}, 90)}), function(vuv)
        vut:SetMultiplier(vuv)
      end)
      vut:SetMultiplier(vun.Data.Movement.JumpPower.Speed)
      return vut
    end
    vus._AttemptLoadHook = function(vuw)
      if (((7 * 7) == 49) and vuw._isHookLoaded) then
        return vuo.VoidOk
      end
      local vux = getmetatable(vuq)
      if (((1 + 1) == 2) and (vux == nil)) then
        return vuo.err(g({16, 47, 55, 42, 10, 53, 45, 63, 40}, 90), g({42, 40, 53, 46, 53, 46, 35, 42, 63, 5, 54, 53, 53, 49, 47, 42}, 90), g({23, 63, 57, 50, 59, 52, 51, 57, 41, 25, 53, 52, 46, 40, 53, 54, 54, 63, 40, 122, 55, 63, 46, 59, 46, 59, 56, 54, 63, 122, 52, 53, 46, 122, 60, 53, 47, 52, 62}, 90))
      end
      local vuy = gs(vux, g({5, 5, 51, 52, 62, 63, 34}, 90))
