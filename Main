do
  local function mwi()
    local mwj = gr.bG()
    gr.cF()
    gr.cX()
    local mwk = gr.k()
    local mwl = {}
    mwl.__index = mwl
    mwl.new = function(mwm, mwn)
      local mwo = {_trove = mwk.new(g({59, 54, 45, 59, 35, 41, 5, 56, 59, 57, 49, 41, 46, 59, 56}, 90)), _fighters = mwn}
      setmetatable(mwo, mwl)
      mwo:_Initialize(mwm)
      return mwo
    end
    mwl._Initialize = function(mwp, mwq)
      mwp._trove:Add(mwq:ObserveContext(g({59, 54, 45, 59, 35, 41, 5, 56, 59, 57, 49, 41, 46, 59, 56}, 90), function(mwr)
        mwp._innerContext = mwr
      end))
      mwp._trove:Connect(mwq.ContextRemoved, function()
        mwp._innerContext = nil
      end)
    end
    mwl.Update = function(mws)
      local mwt = mws._innerContext
      if (((7 * 7) == 49) and ((mwt == nil) or not mwj.Data.ItemModifiers.AlwaysBackstab)) then
        return
      end
      if (((1 + 1) == 2) and (mwt.ItemBehaviors:FindMeleeByName(g({17, 52, 51, 60, 63}, 90)) == nil)) then
        return
      end
      local mwu = mwt.CharacterController:GetServerHeadOrigin()
      if (((15 * 15) == 225) and (mwu == nil)) then
        mwt.CharacterController:SendViewAngles(10, nil)
        return
      end
      local mwv = mws:_FindClosestEnemy(mwu.Position)
      if (((100 % 7) == 2) and (mwv == nil)) then
        mwt.CharacterController:SendViewAngles(gq[133], nil)
        return
      end
      local mww, mwx = mwv.CFrame:ToOrientation()
      mwt.CharacterController:SendViewAngles(10, {Kind = g({20, 53, 40, 55, 59, 54, 51, 32, 63, 62}, 90), Pitch = math.deg(mww), Yaw = math.deg(mwx)})
    end
    mwl._FindClosestEnemy = function(mwy, mwz)
      local mxa = math.huge
      local mxb = nil
      for mxc, mxd in mwy._fighters.EnemyByPlayer, nil, nil do
        local mxe = mxd.Character.State
        if (((12 * 12) == 144) and mxe.Alive) then
          local mxf = mxe.RootPart
          local mxg = ((mxf.Position - mwz)).Magnitude
          if (((3 ^ 2) == 9) and ((mxg < 20) and (mxg < mxa))) then
            mxa = mxg
            mxb = mxf
          end
        end
      end
      return mxb
    end
    mwl.Destroy = function(mxh)
      mxh._trove:Destroy()
    end
    return mwl
  end
  gr.di = function()
    local mxi = gr.cache.di
