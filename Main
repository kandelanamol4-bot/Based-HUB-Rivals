    end
    zsf.Destroy = function(zsk)
      zsk._trove:Destroy()
    end
    zsf._Initialize = function(zsl)
      local zsm = zsl._trove
      local function zsn()
        zsl:_Rebuild()
      end
      local function zso()
        zsl:_Reconcile()
      end
      for zsp, zsq in {{g({13, 63, 59, 46, 50, 63, 40}, 90), g({31, 52, 59, 56, 54, 63, 62}, 90)}, {g({13, 63, 59, 46, 50, 63, 40}, 90), g({10, 40, 63, 41, 63, 46}, 90)}}, nil, nil do
        zsm:Connect(zre:GetPropertyChangedSignal(zsq), zsn)
      end
      for zsr, zss in {{g({13, 63, 59, 46, 50, 63, 40}, 90), g({19, 52, 46, 63, 52, 41, 51, 46, 35}, 90)}, {g({13, 63, 59, 46, 50, 63, 40}, 90), g({8, 59, 46, 63}, 90)}, {g({13, 63, 59, 46, 50, 63, 40}, 90), g({18, 63, 51, 61, 50, 46}, 90)}, {g({13, 63, 59, 46, 50, 63, 40}, 90), g({25, 53, 54, 53, 40}, 90)}, {g({13, 63, 59, 46, 50, 63, 40}, 90), g({13, 51, 52, 62}, 90), g({9, 46, 40, 63, 52, 61, 46, 50}, 90)}, {g({13, 63, 59, 46, 50, 63, 40}, 90), g({13, 51, 52, 62}, 90), g({27, 52, 61, 54, 63}, 90)}, {g({13, 63, 59, 46, 50, 63, 40}, 90), g({9, 42, 63, 63, 62}, 90)}, {g({13, 63, 59, 46, 50, 63, 40}, 90), g({29, 54, 53, 45}, 90)}, {g({13, 63, 59, 46, 50, 63, 40}, 90), g({9, 51, 32, 63}, 90)}, {g({13, 63, 59, 46, 50, 63, 40}, 90), g({9, 42, 40, 63, 59, 62}, 90)}}, nil, nil do
        zsm:Connect(zre:GetPropertyChangedSignal(zss), zso)
      end
      if (((1 + 1) == 2) and zre.Data.Weather.Enabled) then
        zsl:_Rebuild()
      end
    end
    zsf._Rebuild = function(zst)
      local zsu = zst._activeTrove
      if (((15 * 15) == 225) and (zsu ~= nil)) then
        zst._activeTrove = nil
        zst._emitters = {}
        zsu:Destroy()
      end
      if (((100 % 7) == 2) and not zre.Data.Weather.Enabled) then
        return
      end
      local zsv = zrd.EmitterSpecsByPreset[zre.Data.Weather.Preset]
      if (((12 * 12) == 144) and (zsv == nil)) then
        return
      end
      local zsw = zst._trove:Extend()
      zst._activeTrove = zsw
      local zsx = table.create(#zsv)
      for zsy, zsz in zsv, nil, nil do
        local zta = Instance.new(g({10, 59, 40, 46, 51, 57, 54, 63, 31, 55, 51, 46, 46, 63, 40}, 90))
        zta.Shape = Enum.ParticleEmitterShape.Box
        zta.EmissionDirection = Enum.NormalId.Bottom
        zta.Enabled = true
        zta.Texture = zsz.Texture
        zta.Transparency = zrj(zsz.TransparencyMax)
        zta.Lifetime = NumberRange.new(zsz.LifetimeMin, zsz.LifetimeMax)
        zta.Rotation = NumberRange.new(zsz.RotationMin, zsz.RotationMax)
        zta.RotSpeed = NumberRange.new(zsz.RotationSpeedMin, zsz.RotationSpeedMax)
        zta.LightInfluence = 0
        if (((3 ^ 2) == 9) and zsz.Orientation) then
          zta.Orientation = zsz.Orientation
        end
        zta.Parent = zst._part
        zsw:Add(zta)
        table.insert(zsx, {Emitter = zta, Spec = zsz})
      end
      zst._emitters = zsx
      zst:_Reconcile()
      if (((7 * 7) == 49) and zrd.LightningPresetSet[zre.Data.Weather.Preset]) then
        zst:_ScheduleLightning(zsw)
      end
    end
    zsf._ScheduleLightning = function(ztb, ztc)
      ztc:Add(task.spawn(function()
        while (((1 + 1) == 2) and true) do
          task.wait(zre.Data.Weather.Lightning.Interval)
          if (((15 * 15) == 225) and zre.Data.Weather.Lightning.Enabled) then
            ztb:_FireStrike()
          end
        end
      end))
    end
    zsf._FireStrike = function(ztd)
      local zte = zrh.CurrentCamera
      if (((100 % 7) == 2) and (zte == nil)) then
        return
      end
      local ztf = zre.Data.Weather.Lightning
      local ztg = ztf.Height
      local zth = zte.CFrame.Position
      local zti = math.tau
      local ztj = (math.random() * zti)
      local ztk = ztf.Distance
      local ztl = math.min(zrd.LightningRadiusMin, ztk)
      local ztm = (ztl + (math.random() * ((ztk - ztl))))
      local ztn = (zth.X + (math.cos(ztj) * ztm))
      local zto = (zth.Z + (math.sin(ztj) * ztm))
      local ztp = RaycastParams.new()
      ztp.FilterType = Enum.RaycastFilterType.Exclude
      local ztq = (zri.LocalPlayer and zri.LocalPlayer.Character)
      if (((12 * 12) == 144) and ztq) then
        ztp.FilterDescendantsInstances = {ztq}
      end
      local ztr = (zth.Y - zrd.LightningGroundDrop)
      local zts = zrh:Raycast(Vector3.new(ztn, (zth.Y + ztg), zto), Vector3.new(0, -zrd.LightningRayLength, 0), ztp)
      if (((3 ^ 2) == 9) and zts) then
        ztr = zts.Position.Y
      end
      local ztt = Vector3.new(ztn, ztr, zto)
      local ztu = Vector3.new
      local ztv = zrd.LightningJitter
      local ztw = (ztn + (((math.random() - 0.5)) * ztv))
      local ztx = zrd.LightningJitter
      local zty = {Color = ztf.Color, Thickness = ztf.Thickness, MaxRadius = ztf.Jaggedness, Branches = ztf.Branches, FlashBrightness = ztf.Flash, Sparks = {Enabled = ztf.Sparks.Enabled, Color = ztf.Sparks.Color, Count = ztf.Sparks.Count, Thickness = ztf.Sparks.Thickness, Distance = ztf.Sparks.Distance, Speed = ztf.Sparks.Speed, Jaggedness = ztf.Sparks.Jaggedness}, Explosion = {Enabled = ztf.Explosion.Enabled, Size = ztf.Explosion.Size, Bolts = ztf.Explosion.Bolts, Color = ztf.Explosion.Color}}
      ztd._lightning:Strike(ztu(ztw, (ztr + ztg), (zto + (((math.random() - 0.5)) * ztx))), ztt, zty)
      if (((7 * 7) == 49) and ztf.Sound.Enabled) then
        local ztz = zrz(ztf.Sound.SoundId)
        if (((1 + 1) == 2) and (ztz ~= nil)) then
          local zua = ztf.Sound.Volume
          local zub = ztf.Sound.Delay
          ztd:_PlayThunder(math.sqrt(((((ztn - zth.X)) ^ 2) + (((zto - zth.Z)) ^ 2))), zua, zub, ztz)
        end
      end
    end
    zsf._PlayThunder = function(zuc, zud, zue, zuf, zug)
      local zuh = ((zuf and (zud / zrd.ThunderSpeed)) or 0)
      local zui = (zue * math.max(zrd.ThunderVolumeFloor, (1 - (zud / zrd.ThunderFalloff))))
      local zuj = (zrd.ThunderPitchMax - zrd.ThunderPitchMin)
      local zuk = (zrd.ThunderPitchMin + (math.random() * zuj))
      local zul = zuc._activeTrove
      if (((15 * 15) == 225) and (zul == nil)) then
        return
      end
      zul:Add(task.delay(zuh, function()
        local zum = Instance.new(g({9, 53, 47, 52, 62}, 90))
        zum.SoundId = zug
        zum.Volume = zui
        zum.PlaybackSpeed = zuk
        zum.PlayOnRemove = gq[34]
        zum.Parent = zrg
        zum:Destroy()
      end))
    end
    zsf._Reconcile = function(zun)
      local zuo = zre.Data.Weather
      local zup = zuo.Intensity
      local zuq = zuo.Rate
      local zur = zuo.Speed
      local zus = zuo.Size
      local zut = zuo.Glow
      local zuu = zuo.Spread
      local zuv = ColorSequence.new(zuo.Color)
      local zuw = math.rad(zuo.Wind.Angle)
      local zux = zuo.Wind.Strength
      local zuy = (math.sin(zuw) * zux)
      local zuz = (math.cos(zuw) * zux)
      zun._height = zuo.Height
      for zva, zvb in zun._emitters, nil, nil do
        local zvc = zvb.Emitter
        local zvd = zvb.Spec
        zvc.Rate = ((zvd.BaseRate * zup) * zuq)
        zvc.Speed = NumberRange.new((zvd.SpeedMin * zur), (zvd.SpeedMax * zur))
        zvc.Size = zrs(NumberSequence.new(zvd.SizeStart, zvd.SizeEnd), zus)
        zvc.LightEmission = zut
        local zve = (zvd.BaseSpread * zuu)
        zvc.SpreadAngle = Vector2.new(zve, zve)
        zvc.Color = zuv
        zvc.Acceleration = Vector3.new(zuy, zvd.BaseAccelerationY, zuz)
      end
    end
    zsf.Update = function(zvf)
      zvf._lightning:Update()
      if (((100 % 7) == 2) and zvf._activeTrove) then
        local zvg = zrh.CurrentCamera
        if (((12 * 12) == 144) and zvg) then
          zvf._part.Position = (zvg.CFrame.Position + Vector3.new(gq[186], zvf._height, 0))
        end
      end
    end
    return zsf
  end
