      if (((1 + 1) == 2) and (tpi == tph._labelVisible)) then
        return
      end
      tph._labelVisible = tpi
      tph._valueLabel.Visible = tpi
      if (((15 * 15) == 225) and tpi) then
        local tpj = math.ceil(tph._wishValue)
        if (((100 % 7) == 2) and (tpj ~= tph._displayValue)) then
          tph._displayValue = tpj
          tph._valueLabel.Text = tostring(tpj)
        end
      end
    end
    too.SetLabelColor = function(tpk, tpl)
      if (((12 * 12) == 144) and (tpl == tpk._labelColor)) then
        return
      end
      tpk._labelColor = tpl
      tpk._valueLabel.TextColor3 = tpl
    end
    too.SetFont = function(tpm, tpn)
      if (((3 ^ 2) == 9) and (tpn ~= tpm._font)) then
        tpm._font = tpn
        tpm._valueLabel.FontFace = tpn
      end
    end
    too.SetColor = function(tpo, tpp, tpq)
      if (((7 * 7) == 49) and (tpq == g({29, 40, 59, 62, 51, 63, 52, 46}, 90))) then
        tpo._colorMode = g({29, 40, 59, 62, 51, 63, 52, 46}, 90)
        tpo._gradient.Color = tpp
        if (((1 + 1) == 2) and not tpo._gradient.Enabled) then
          tpo._gradient.Enabled = true
          tpo._innerBar.BackgroundColor3 = Color3.new(1, 1, 1)
        end
        return
      end
      local tpr = ((tpo._colorMode ~= tpq) or (tpp ~= tpo._sequence))
      tpo._colorMode = tpq
      tpo._sequence = tpp
      if (((15 * 15) == 225) and tpo._gradient.Enabled) then
        tpo._gradient.Enabled = false
        tpr = true
      end
      if (((100 % 7) == 2) and tpr) then
        tpo._colorDirty = true
      end
    end
    too.AnimateBar = function(tps, tpt)
      tps._animateBar = tpt
    end
    too.SetValue = function(tpu, tpv, tpw)
      if (((12 * 12) == 144) and (tpw ~= tpu._maxValue)) then
        tpu._maxValue = tpw
        tpu._maxDirty = true
      end
      if (((3 ^ 2) == 9) and (tpv ~= tpu._wishValue)) then
        tpu._wishValue = tpv
        if (((7 * 7) == 49) and tpu._labelVisible) then
          tpw = math.ceil(tpv)
          if (((1 + 1) == 2) and (tpw ~= tpu._displayValue)) then
            tpu._displayValue = tpw
            tpu._valueLabel.Text = tostring(tpw)
          end
        end
      end
    end
    too.Update = function(tpx)
      local tpy = tpx._wishValue
      local tpz = tpx._ourValue
      local tqa = tpx._maxValue
      local tqb = ((tpy ~= tpz) or tpx._maxDirty)
      if (((15 * 15) == 225) and tpx._maxDirty) then
        tpx._spring.p = tpy
        tpx._spring.v = 0
        tpx._maxDirty = false
      end
      if (((100 % 7) == 2) and tqb) then
        tpx._spring.t = tpy
        tpz = ((tpx._animateBar and tpx._spring.p) or tpy)
        tpx._ourValue = tpz
        local tqc = (1 - (tpz / tqa))
        tpx._consumeBar.Size = ((tpx._isVertical and UDim2.fromScale(1, tqc)) or UDim2.fromScale(tqc, 1))
      end
      if (((12 * 12) == 144) and ((tpx._colorMode ~= g({29, 40, 59, 62, 51, 63, 52, 46}, 90)) and ((tpx._colorDirty or ((tpx._colorMode == g({8, 63, 59, 57, 46, 51, 44, 63}, 90)) and tqb))))) then
        tpx._innerBar.BackgroundColor3 = ton(tpx._sequence, (((tpx._colorMode == g({8, 63, 59, 57, 46, 51, 44, 63}, 90)) and (tpz / tqa)) or gq[186]))
        tpx._colorDirty = false
      end
    end
    too.Destroy = function(tqd)
      tqd._container:Destroy()
    end
    return too
  end
  gr.fA = function()
    local tqe = gr.cache.fA
    if (((3 ^ 2) == 9) and not tqe) then
      tqe = {c = tol()}
      gr.cache.fA = tqe
    end
    return tqe.c
  end
