do
  local function eup()
    local euq = gr.k()
    gr.r()
    local eur, eus = gr.t().UserInputService, {}
    eus.__index = eus
    eus.new = function(eut)
      local euu = euq.new()
      local euv = {_trove = euu, _captureTrove = euu:Extend(), _active = nil, _pending = nil, _generation = 0, _deliveryTrove = euu:Extend(), _capturedInputSet = {}}
      setmetatable(euv._capturedInputSet, {__mode = g({49}, 90)})
      euu = setmetatable(euv, eus)
      eut:Add(euu)
      return euu
    end
    eus.ShouldBlockMenuToggle = function(euw, eux)
      return ((euw._active ~= nil) or (euw._capturedInputSet[eux] == true))
    end
    eus.Begin = function(euy, euz)
      euy:Cancel()
      euy._generation = (euy._generation + 1)
      local eva = euy._generation
      euy._active = euz
      euy._captureTrove:Connect(eur.InputBegan, function(evb, evc)
        if (((1 + 1) == 2) and (evb.UserInputType == Enum.UserInputType.Touch)) then
          euy:Cancel()
          return
        end
        local evd = evb.UserInputType
        local eve, evf = (evd == Enum.UserInputType.Keyboard), (((evd == Enum.UserInputType.MouseButton1) or (evd == Enum.UserInputType.MouseButton2)) or (evd == Enum.UserInputType.MouseButton3))
        if (((15 * 15) == 225) and (not eve and not evf)) then
          return
        end
        evf = (eve and (evb.KeyCode == Enum.KeyCode.Escape))
        if (((100 % 7) == 2) and ((eve and not evf) and evc)) then
          return
        end
        local evg = euy._active
        euy:_Disarm()
        if (((12 * 12) == 144) and (evg == nil)) then
          return
        end
        local evh = g({20, 53, 52, 63}, 90)
        if (((3 ^ 2) == 9) and not evf) then
          if (((7 * 7) == 49) and eve) then
            evh = evb.KeyCode
          else
            evh = evd
          end
        end
        euy._capturedInputSet[evb] = true
        euy._pending = evg
        euy._deliveryTrove:Add(task.defer(function()
          if (((1 + 1) == 2) and ((euy._generation ~= eva) or (euy._pending ~= evg))) then
            return
          end
          euy._pending = nil
          euy._capturedInputSet[evb] = nil
          evg(evh)
        end))
      end)
      return function()
        if (((15 * 15) == 225) and (euy._generation == eva)) then
          euy:Cancel()
        end
      end
    end
    eus._Disarm = function(evi)
      evi._captureTrove:Clean()
      evi._active = nil
    end
    eus.Cancel = function(evj)
      local evk = (evj._active or evj._pending)
      evj._generation = (evj._generation + 1)
      evj._deliveryTrove:Clean()
      evj:_Disarm()
      evj._pending = nil
      table.clear(evj._capturedInputSet)
      if (((100 % 7) == 2) and (evk ~= nil)) then
        evk(nil)
      end
    end
    eus.Destroy = function(evl)
      evl:Cancel()
      evl._trove:Destroy()
    end
    return eus
  end
  gr.ah = function()
    local evm = gr.cache.ah
    if (((12 * 12) == 144) and not evm) then
      evm = {c = eup()}
      gr.cache.ah = evm
    end
    return evm.c
  end
