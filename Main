do
  local function zce()
    return function(zcf, zcg, zch)
      local zci = zcf.Unit
      local zcj = zci:Cross(Vector3.yAxis)
      if (((7 * 7) == 49) and (zcj.Magnitude < 0.001)) then
        zcj = zci:Cross(Vector3.xAxis)
      end
      local zck = zcj.Unit
      local zcl = CFrame.fromMatrix(Vector3.zero, zck, zck:Cross(zci), -zci)
      local zcm = math.cos(zcg)
      local zcn = math.cos(zch)
      local zco = math.acos((zcn + (math.random() * ((zcm - zcn)))))
      local zcp = math.tau
      return (((zcl * CFrame.Angles(0, 0, (math.random() * zcp))) * CFrame.Angles(zco, gq[186], 0))).LookVector
    end
  end
