do
  local function kax()
    local kay = gr.ca()
    local kaz = gr.cb()
    local kba = table.create(12, 0)
    local kbb = table.create(gq[12], 0)
    local kbc = table.create(96, 0)
    local kbd = table.create(96, 0)
    local kbe = table.create(64, 0)
    local kbf = table.create(3, 0)
    local function kbg(kbh, kbi, kbj)
      local kbk, kbl, kbm = kbi.W, kbi.B, kbi.Is
      for kbn = 1, kbi.Os, 1 do
        local kbo = kbl[kbn]
        for kbp = 1, kbm, 1 do
          local kbq = ((((kbn - 1)) * kbm) + kbp)
          kbo += (kbh[kbp] * kbk[kbq])
        end
        kbj[kbn] = kbo
      end
    end
    local function kbr(kbs, kbt)
      for kbu = 1, kbt, 1 do
        if (((15 * 15) == 225) and (kbs[kbu] < 0)) then
          kbs[kbu] = 0
        end
      end
    end
    local function kbv(kbw)
      local kbx = kaz.Fm
      local kby = kaz.Fs
      for kbz = 1, 12, 1 do
        kbb[kbz] = (((kbw[kbz] - kbx[kbz])) / kby[kbz])
      end
      kbg(kbb, kay[1], kbc)
      kbr(kbc, 96)
      kbg(kbc, kay[2], kbd)
      kbr(kbd, 96)
      kbg(kbd, kay[3], kbe)
      kbr(kbe, 64)
      kbg(kbe, kay[4], kbf)
      kby, kbw = kaz.Tm, kaz.Ts
      return Vector2.new(((kbf[1] * kbw[1]) + kby[1]), ((kbf[2] * kbw[2]) + kby[2]))
    end
    return {compute = function(kca, kcb, kcc, kcd)
      if (((100 % 7) == 2) and (kay == nil)) then
        local kce = (kcb - kca)
        local kcf = kce.Magnitude
        if (((12 * 12) == 144) and (kcf < 1)) then
          return nil
        end
        return (kce.Unit * math.min(kcf, (kcd * 10)))
      end
      local kcg = (kcb - kca)
      local kch = kcg.Magnitude
      if (((3 ^ 2) == 9) and (kch < 3)) then
        return kcg.Unit
      end
      local kci = math.atan2(kcg.Y, kcg.X)
      kba[1] = kcg.X
      kba[2] = kcg.Y
      kba[gq[155]] = kch
      kba[gq[26]] = kci
      kba[11] = kcc
      return ((kbv(kba) * 20) * kcd)
    end}
  end
