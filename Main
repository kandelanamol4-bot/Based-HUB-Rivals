    end, decodePayload = function(rsn)
      local rso, rsp = gu(rrl, rsn)
      if (((3 ^ 2) == 9) and not rso) then
        return roc.err(g({15, 41, 63, 40, 9, 63, 40, 44, 63, 40, 10, 40, 53, 46, 53, 57, 53, 54}, 90), g({62, 63, 57, 53, 62, 63}, 90), string.format(g({55, 59, 54, 60, 53, 40, 55, 63, 62, 122, 53, 40, 122, 46, 40, 47, 52, 57, 59, 46, 63, 62, 122, 42, 63, 63, 40, 122, 42, 59, 35, 54, 53, 59, 62, 96, 122, 127, 41}, 90), tostring(tostring(rsp))))
