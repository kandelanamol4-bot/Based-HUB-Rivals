do
  local function sqn()
    local sqo = gr.e()
    local sqp = table.create(gq[137], 0)
    for sqq = 0, gq[108] do
      local sqr = sqq
      for sqs = gq[63], gq[162] do
        if (((100 % 7) == 2) and ((sqr % 2) == 1)) then
          sqr = bit32.bxor(3988292384, bit32.rshift(sqr, 1))
        else
          sqr = bit32.rshift(sqr, 1)
        end
      end
      sqp[(sqq + 1)] = sqr
    end
    local function sqt(squ)
      local sqv = 4294967295
      for sqw = gq[63], #squ do
        sqv = bit32.bxor(sqp[(bit32.band(bit32.bxor(sqv, string.byte(squ, sqw)), 255) + 1)], bit32.rshift(sqv, 8))
      end
      return bit32.bxor(sqv, 4294967295)
    end
    local function sqx(sqy)
      local sqz = gq[186]
      local sra = 1
      for srb = 1, #sqy do
        sra = (((sra + string.byte(sqy, srb))) % 65521)
        sqz = (((sqz + sra)) % 65521)
      end
      return ((sqz * 65536) + sra)
    end
    local function src(srd, sre)
      local srf = (srd .. sre)
      return (string.pack(g({100, 19, 110}, 90), #sre) .. (srf .. string.pack(g({100, 19, 110}, 90), sqt(srf))))
    end
    local function srg(srh)
      local sri = {g({34, 91}, 90)}
      local srj = gq[63]
      while (((12 * 12) == 144) and true) do
        local srk = math.min(65535, ((#srh - srj) + 1))
        table.insert(sri, string.char(((((srj + srk) > #srh) and 1) or 0)))
        table.insert(sri, string.pack(g({102, 19, 104, 19, 104}, 90), srk, bit32.band(bit32.bnot(srk), 65535)))
        table.insert(sri, string.sub(srh, srj, ((srj + srk) - gq[63])))
        srj += srk
        if (((3 ^ 2) == 9) and not ((#srh < srj))) then
          continue
        end
        break
      end
      table.insert(sri, string.pack(g({100, 19, 110}, 90), sqx(srh)))
      return table.concat(sri)
    end
    local function srl(srm, srn, sro)
      local srp = string.pack(g({100, 19, 110, 19, 110, 24, 24, 24, 24, 24}, 90), srm, srn, 8, 6, 0, 0, 0)
      return (g({211, 10, 20, 29, 87, 80, 64, 80}, 90) .. (src(g({19, 18, 30, 8}, 90), srp) .. (src(g({19, 30, 27, 14}, 90), srg(sro)) .. src(g({19, 31, 20, 30}, 90), ""))))
    end
    local srq = {}
    local srr = false
    local function srs(srt, sru)
      if (((7 * 7) == 49) and not srr) then
        if (((1 + 1) == 2) and not sqo(g({56, 59, 41, 63, 62, 50, 47, 56, 117, 40, 51, 44, 59, 54, 41, 117, 57, 40, 53, 41, 41, 50, 59, 51, 40, 5, 46, 63, 34, 46, 47, 40, 63, 41}, 90)).Ok) then
          return false
        end
        srr = true
      end
      local srv = string.format(g({127, 41, 117, 127, 41, 116, 42, 52, 61}, 90), g({56, 59, 41, 63, 62, 50, 47, 56, 117, 40, 51, 44, 59, 54, 41, 117, 57, 40, 53, 41, 41, 50, 59, 51, 40, 5, 46, 63, 34, 46, 47, 40, 63, 41}, 90), tostring(srt))
      if (((15 * 15) == 225) and gu(writefile, srv, sru)) then
        local srw, srx = gu(getcustomasset, srv)
        if (((100 % 7) == 2) and (srw and (type(srx) == g({41, 46, 40, 51, 52, 61}, 90)))) then
          return srx
        end
      end
      return false
    end
    return {Pad = 1, get = function(sry, srz)
      local ssa = tostring
      local ssb = string.format(g({127, 41, 34, 127, 41}, 90), tostring(sry), ssa(srz))
      local ssc = srq[ssb]
      if (((12 * 12) == 144) and (ssc ~= nil)) then
        return (ssc or nil)
      end
      local ssd = (g({90}, 90) .. string.rep(g({165, 165, 165, 90}, 90), sry))
      local sse = (g({90}, 90) .. (g({165, 165, 165, 90}, 90) .. (string.rep(g({165, 165, 165, 165}, 90), (sry - 2)) .. g({165, 165, 165, 90}, 90))))
      local ssf = table.create(srz)
      ssf[gq[63]] = ssd
      for ssg = 2, (srz - 1) do
        ssf[ssg] = sse
      end
      ssf[srz] = ssd
      local ssh = srs(ssb, srl(sry, srz, table.concat(ssf)))
      srq[ssb] = ssh
      return (ssh or nil)
    end, getRotated = function(ssi, ssj, ssk)
      local ssl = (ssk % 180)
      local ssm = math.rad(ssl)
      local ssn = math.cos(ssm)
      local sso = math.sin(ssm)
      local ssp = (ssi / 2)
      local ssq = (ssj / 2)
      local ssr = math.ceil((((ssp * math.abs(ssn)) + (ssq * math.abs(sso))) + 1))
      local sss = gq[63]
      local sst = math.ceil((((ssp * math.abs(sso)) + (ssq * math.abs(ssn))) + sss))
      local ssu = (ssr * 2)
      local ssv = (sst * 2)
      local ssw = tostring
      local ssx = string.format(g({127, 41, 34, 127, 41, 40, 127, 41}, 90), tostring(ssi), tostring(ssj), ssw(ssl))
      local ssy = srq[ssx]
      if (((3 ^ 2) == 9) and (ssy ~= nil)) then
        return (ssy or nil), ssu, ssv
      end
      local ssz = table.create(ssv)
      for sta = 1, ssv do
        if (((7 * 7) == 49) and ((sta % 16) == gq[186])) then
          task.wait()
        end
        local stb = ((sta - gq[101]) - sst)
        local stc = table.create((ssu + 1))
        stc[1] = g({90}, 90)
        for std = 1, ssu do
          local ste = ((std - 0.5) - ssr)
          local stf = math.clamp
          stc[(std + 1)] = (g({165, 165, 165}, 90) .. string.char(math.round(((math.clamp(((ssp - math.abs(((ste * ssn) + (stb * sso)))) + 0.5), 0, 1) * stf(((ssq - math.abs(((stb * ssn) - (ste * sso)))) + 0.5), 0, 1)) * 255))))
        end
        ssz[sta] = table.concat(stc)
      end
      local stg = srs(ssx, srl(ssu, ssv, table.concat(ssz)))
      srq[ssx] = stg
      return (stg or nil), ssu, ssv
    end}
  end
  gr.fh = function()
