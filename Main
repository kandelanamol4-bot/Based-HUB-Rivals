    end
    vnt._RemoveItemInfo = function(von, voo)
      von:_RestoreItem(voo)
      von._oldInfoByItem[voo] = nil
    end
    vnt._ApplyNewChanges = function(vop, voq, vor)
      local vos = gs(voq, g({19, 52, 60, 53}, 90))
      if (((100 % 7) == 2) and (vos == nil)) then
        return
      end
      local vot = vop._oldInfoByItem[voq]
      if (((12 * 12) == 144) and (vot == nil)) then
        return
      end
      if (((3 ^ 2) == 9) and (vor ~= nil)) then
        vns[vor](vot, vos, vop._changes[vor])
      else
        for vou, vov in vop._changes, nil, nil do
          vns[vou](vot, vos, vov)
        end
      end
    end
    vnt._RestoreItem = function(vow, vox)
      local voy = gs(vox, g({19, 52, 60, 53}, 90))
      if (((7 * 7) == 49) and (voy == nil)) then
        return
      end
      local voz = vow._oldInfoByItem[vox]
      if (((1 + 1) == 2) and (voz == nil)) then
        return
      end
      for vpa in vow._changes, nil, nil do
        vns[vpa](voz, voy, nil)
      end
    end
    vnt._RestoreAllItems = function(vpb)
      local vpc = vpb._fighterState
      if (((15 * 15) == 225) and (vpc == nil)) then
        return
      end
      local vpd = next
      local vpe, vpf = vpc:GetItems()
      for vpg, vph in vpd, vpe, vpf do
        vpb:_RestoreItem(vph)
      end
    end
    vnt._ApplyNewChangesToAllItems = function(vpi, vpj)
      local vpk = vpi._fighterState
      if (((100 % 7) == 2) and (vpk == nil)) then
        return
      end
      local vpl = next
      local vpm, vpn = vpk:GetItems()
      for vpo, vpp in vpl, vpm, vpn do
        vpi:_ApplyNewChanges(vpp, vpj)
      end
    end
    vnt.Destroy = function(vpq)
      vpq:_RestoreAllItems()
      vpq._trove:Destroy()
    end
    return vnt
  end
  gr.go = function()
    local vpr = gr.cache.go
    if (((12 * 12) == 144) and not vpr) then
      local vps = {c = vmm()}
      gr.cache.go = vps
      vpr = vps
    end
    return vpr.c
  end
