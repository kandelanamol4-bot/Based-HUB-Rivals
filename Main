    end
    xhr._RebuildIndexes = function(xhy)
      local xhz = {}
      local xia = {}
      for xib, xic in xhy._data, nil, nil do
        table.insert(xhz, xib)
        xia[xib] = xic
      end
      table.sort(xhz)
      xhy._names = xhz
      xhy._presetByName = xia
    end
    xhr.GetNames = function(xid)
      return table.clone(xid._names)
    end
    xhr.FindPreset = function(xie, xif)
      return (((xif ~= nil) and xie._presetByName[xif]) or nil)
    end
    xhr._Save = function(xig)
      xig._configManager:SetData(xig._data)
      local xih = xig._configManager:SaveToFile(g({41, 49, 35, 56, 53, 34, 63, 41, 116, 48, 41, 53, 52}, 90))
