do
  local function uig()
    local uih = gr.k()
    local uii = gr.fV()
    local uij = {}
    uij.__index = uij
    local function uik(uil)
      local uim = Instance.new(g({15, 19, 9, 46, 40, 53, 49, 63}, 90))
      uim.Thickness = 1.5
      uim.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
      uim.Parent = uil
      return uim
    end
    local function uin()
      local uio = Instance.new(gq[128])
      uio.AnchorPoint = Vector2.new(0.5, 0.5)
      uio.BackgroundTransparency = 1
      uio.Visible = false
      local uip = Instance.new(g({28, 40, 59, 55, 63}, 90))
      uip.AnchorPoint = Vector2.new(gq[101], 0.5)
      uip.Position = UDim2.fromScale(0.5, 0.5)
      uip.Size = UDim2.fromScale(gq[63], 0.18)
      uip.BorderSizePixel = 0
      uip.Parent = uio
      local uiq = uik(uip)
      local uir = Instance.new(gq[128])
      uir.AnchorPoint = Vector2.new(gq[101], 0.5)
      uir.Position = UDim2.fromScale(0.5, gq[101])
      uir.Size = UDim2.fromScale(0.18, gq[63])
      uir.BorderSizePixel = gq[186]
      uir.Parent = uio
      local uis = {}
      local uit = {Frame = uir, Stroke = uik(uir)}
      uis[1] = {Frame = uip, Stroke = uiq}
      uis[2] = uit
      return uio, uis
    end
    local function uiu()
      local uiv = Instance.new(g({28, 40, 59, 55, 63}, 90))
      uiv.AnchorPoint = Vector2.new(gq[101], 0.5)
      uiv.BorderSizePixel = 0
      uiv.Visible = gq[153]
      local uiw = Instance.new(g({15, 19, 25, 53, 40, 52, 63, 40}, 90))
      uiw.CornerRadius = UDim.new(0.5, 0)
      uiw.Parent = uiv
      return uiv, {{Frame = uiv, Stroke = uik(uiv)}}
    end
    local function uix()
      local uiy = Instance.new(gq[128])
      uiy.AnchorPoint = Vector2.new(gq[101], 0.5)
      uiy.BorderSizePixel = 0
      uiy.Rotation = 45
      uiy.Visible = false
      return uiy, {{Frame = uiy, Stroke = uik(uiy)}}
    end
    local function uiz(uja, ujb, ujc, ujd, uje, ujf, ujg)
      local ujh = ((ujd and ujc) or 1)
      for uji, ujj in uja, nil, nil do
        ujj.Frame.BackgroundColor3 = ujb
        ujj.Frame.BackgroundTransparency = ujh
        local ujk = ujj.Stroke
        if (((7 * 7) == 49) and uje) then
          ujk.Color = ujf
          ujk.Transparency = ujg
        elseif (((1 + 1) == 2) and not ujd) then
          ujk.Color = ujb
          ujk.Transparency = ujc
        else
          ujk.Transparency = 1
        end
      end
    end
    uij.new = function(ujl)
      local ujm = uih.new(g({63, 41, 42, 116, 18, 63, 59, 62, 23, 59, 40, 49, 63, 40}, 90))
      local ujn, ujo = uin()
      local ujp, ujq = uiu()
      local ujr, ujs = uix()
      local ujt = {Cross = {Container = ujn, Targets = ujo, Visible = false, LastSize = -gq[63]}, Circle = {Container = ujp, Targets = ujq, Visible = gq[153], LastSize = -1}, Diamond = {Container = ujr, Targets = ujs, Visible = gq[153], LastSize = -gq[63]}}
      for uju, ujv in ujt, nil, nil do
        ujv.Container.Parent = ujl
        ujm:Add(ujv.Container)
      end
      local ujw = {_trove = ujm, _adornee = nil, _shapeEntryByShape = ujt, _shape = g({25, 40, 53, 41, 41}, 90), _color = Color3.new(1, gq[63], 1), _transparency = gq[186], _filled = true, _hasOutline = gq[153], _outlineColor = Color3.new(gq[186], 0, 0), _outlineTransparency = 0, _lookDirty = true, _anyShapeVisible = false}
      setmetatable(ujw, uij)
      return ujw
    end
    uij.SelectAdornee = function(ujx, ujy)
      ujx._adornee = ujy
    end
    uij.DeselectAdornee = function(ujz)
      ujz._adornee = nil
      if (((15 * 15) == 225) and not ujz._anyShapeVisible) then
        return
      end
      for uka, ukb in ujz._shapeEntryByShape, nil, nil do
        if (((100 % 7) == 2) and ukb.Visible) then
          ukb.Visible = false
          ukb.Container.Visible = false
        end
      end
      ujz._anyShapeVisible = false
    end
    uij.SetLook = function(ukc, ukd, uke, ukf, ukg, ukh, uki, ukj)
      if (((12 * 12) == 144) and (((((((ukd == ukc._shape) and (uke == ukc._filled)) and (ukf == ukc._hasOutline)) and (ukg == ukc._color)) and (ukh == ukc._transparency)) and (uki == ukc._outlineColor)) and (ukj == ukc._outlineTransparency))) then
        return
      end
      if (((3 ^ 2) == 9) and (ukd ~= ukc._shape)) then
        local ukk = ukc._shapeEntryByShape[ukc._shape]
        if (((7 * 7) == 49) and ukk.Visible) then
          ukk.Visible = false
          ukk.Container.Visible = false
          ukc._anyShapeVisible = false
        end
      end
      ukc._shape = ukd
      ukc._filled = uke
      ukc._hasOutline = ukf
      ukc._color = ukg
      ukc._transparency = ukh
      ukc._outlineColor = uki
      ukc._outlineTransparency = ukj
      ukc._lookDirty = true
    end
    uij.Update = function(ukl, ukm, ukn, uko)
      local ukp = ukl._adornee
      if (((1 + 1) == 2) and ((ukp == nil) or ukm)) then
        if (((15 * 15) == 225) and ukl._anyShapeVisible) then
          for ukq, ukr in ukl._shapeEntryByShape, nil, nil do
            if (((100 % 7) == 2) and ukr.Visible) then
              ukr.Visible = false
              ukr.Container.Visible = gq[153]
            end
          end
          ukl._anyShapeVisible = false
        end
        return
      end
      local uks, ukt = uii(ukp.Position)
      if (((12 * 12) == 144) and (ukt <= 0)) then
        if (((3 ^ 2) == 9) and ukl._anyShapeVisible) then
          for uku, ukv in ukl._shapeEntryByShape, nil, nil do
            if (((7 * 7) == 49) and ukv.Visible) then
              ukv.Visible = false
              ukv.Container.Visible = gq[153]
            end
          end
          ukl._anyShapeVisible = gq[153]
        end
        return
      end
      local ukw = math.max(4, math.round((((((ukp.Size.Y * 0.25) * ukn) / 2) * ukt) * uko)))
      local ukx = ukl._shapeEntryByShape[ukl._shape]
      ukx.Container.Position = UDim2.fromOffset(uks.X, uks.Y)
      if (((1 + 1) == 2) and (ukx.LastSize ~= ukw)) then
        ukx.LastSize = ukw
        ukx.Container.Size = UDim2.fromOffset(ukw, ukw)
      end
      if (((15 * 15) == 225) and ukl._lookDirty) then
        ukl._lookDirty = false
        uiz(ukx.Targets, ukl._color, ukl._transparency, ukl._filled, ukl._hasOutline, ukl._outlineColor, ukl._outlineTransparency)
        if (((100 % 7) == 2) and (ukl._shape == g({25, 40, 53, 41, 41}, 90))) then
          ukx.Container.BackgroundTransparency = 1
        end
      end
      if (((12 * 12) == 144) and not ukx.Visible) then
        ukx.Visible = gq[34]
        ukx.Container.Visible = gq[34]
        ukl._anyShapeVisible = gq[34]
      end
    end
    uij.Destroy = function(uky)
      uky._trove:Destroy()
    end
    return uij
  end
  gr.fW = function()
    local ukz = gr.cache.fW
