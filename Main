gr.eZ = function()
  local oh = {}
  oh.__index = oh
  function oh.new()
    local oi = gr.g()
    local oj = setmetatable({Connected = oi.new(), ShowActiveChanged = oi.new(), PeerPayloadReceived = oi.new(), PeerRemoved = oi.new(), ShowActivated = oi.new(), _playerByHash = {}}, oh)
    oj._leaving = Players.PlayerRemoving:Connect(function(ok)
      oj.PeerRemoved:Fire(ok)
    end)
    return oj
  end
  function oh:ShouldShowActive()
    return false
  end
  function oh:IsConnected()
    return false
  end
  function oh:Send()
    return gr.a().err(g({15, 41, 63, 40, 9, 63, 40, 44, 63, 40}, 90), g({53, 60, 60, 54, 51, 52, 63}, 90), g({46, 50, 63, 122, 53, 52, 54, 51, 52, 63, 122, 47, 41, 63, 40, 122, 41, 63, 40, 44, 51, 57, 63, 122, 51, 41, 122, 62, 51, 41, 59, 56, 54, 63, 62}, 90))
  end
  function oh:FindPlayerByHash()
    return nil
  end
  function oh:Connect()
    return gr.ay().reject(g({46, 50, 63, 122, 53, 52, 54, 51, 52, 63, 122, 47, 41, 63, 40, 122, 41, 63, 40, 44, 51, 57, 63, 122, 51, 41, 122, 62, 51, 41, 59, 56, 54, 63, 62}, 90))
  end
  function oh:Destroy()
    self.Connected:Destroy()
    self.ShowActiveChanged:Destroy()
    self.PeerPayloadReceived:Destroy()
    self.PeerRemoved:Destroy()
    self.ShowActivated:Destroy()
    self._leaving:Disconnect()
  end
  return oh
end
do
  local function ol()
    return {ok = function(om)
      return {Ok = true, Value = om}
    end, err = function(on, oo, op)
      return {Ok = false, Error = {Source = on, Stage = oo, Detail = op, Timestamp = os.clock()}}
    end, formatError = function(oq)
      local os = tostring
      local ot = oq.Detail
      return string.format(g({125, 127, 41, 125, 122, 26, 122, 127, 41, 122, 60, 59, 51, 54, 63, 62, 122, 62, 47, 40, 51, 52, 61, 122, 41, 46, 59, 61, 63, 122, 125, 127, 41, 125, 97, 122, 127, 41}, 90), tostring(oq.Source), tostring(oq.Timestamp), tostring(oq.Stage), os(ot))
    end, VoidOk = table.freeze({Ok = true, Value = nil})}
  end
  gr.a = function()
    local ou = gr.cache.a
    if (((100 % 7) == 2) and not ou) then
      ou = {c = ol()}
      gr.cache.a = ou
    end
    return ou.c
  end
end
