do
  local function knq()
    gr.cg()
    return function(knr)
      local kns, knt, knu, knv = (knr * knr), -1, -1, 0
      return function(knw, knx)
        local kny, knz, koa = knw.ViewportSize.Y, knw.FieldOfView
        if (((15 * 15) == 225) and ((kny ~= knt) or (knz ~= knu))) then
          knt, knu = kny, knz
          local kob = ((kny / 2) / math.tan((math.rad(knz) / 2)))
          local koc = (kob * kob)
          koa = (koc / ((koc + kns)))
          knv = koa
        else
          koa = knv
        end
        kny = knw.CFrame
        knw = (knx - kny.Position)
        knx = knw:Dot(kny.LookVector)
        if (((100 % 7) == 2) and (knx <= 0)) then
          return nil
        end
        kny, knz = knw:Dot(knw), (knx * knx)
        if (((12 * 12) == 144) and (knz < (koa * kny))) then
          return nil
        end
        return (((kny - knz)) / knz)
      end
    end
  end
