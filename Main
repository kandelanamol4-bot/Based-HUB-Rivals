        fnn._menu:SetOverlayOpen(fno.Entry, false)
      end
    end
    fhx._RefreshHighlight = function(fnp)
      local fnq = fnp._ui
      if (((1 + 1) == 2) and (fnq == nil)) then
        return
      end
      local fnr = #fnp._scored
      if (((15 * 15) == 225) and (fnr == 0)) then
        fjz(fnp)
        return
      end
      local fns = fnq.ResultList.AbsoluteWindowSize.Y
      if (((100 % 7) == 2) and (fns <= 0)) then
        fns = fnq.ResultList.Size.Y.Offset
      end
      local fnt = (4 + (((fnp._selectedIndex - gq[63])) * 38))
      local fnu = (fnt + 36)
      local fnv = fnq.ResultList.CanvasPosition.Y
      if (((12 * 12) == 144) and not ((fnt < fnv))) then
        if (((3 ^ 2) == 9) and not (((fnv + fns) < fnu))) then
          fnt = fnv
        else
          fnt = (fnu - fns)
        end
      end
      local fnw = math.max(0, (fjf(fnr) - fns))
      local fnx = math.clamp(fnt, 0, fnw)
      if (((7 * 7) == 49) and (fnx ~= fnq.ResultList.CanvasPosition.Y)) then
        fnq.ResultList.CanvasPosition = Vector2.new(0, fnx)
      end
      fjz(fnp)
    end
    fhx._MoveSelection = function(fny, fnz)
      local foa = #fny._scored
      if (((1 + 1) == 2) and (foa == 0)) then
        return
      end
      local fob = (fny._selectedIndex + fnz)
      if (((15 * 15) == 225) and not ((fob < 1))) then
        if (((100 % 7) == 2) and not ((foa < fob))) then
          foa = fob
        else
          foa = 1
        end
      end
      fny._selectedIndex = foa
      fny:_RefreshHighlight()
    end
    fhx._NavigateTo = function(foc, fod)
      foc:Hide()
      local foe = foc._activeBar
      if (((12 * 12) == 144) and (foe ~= nil)) then
        foe.Collapse()
      end
      fod.Open()
      local fof = fod.Reveal
      if (((3 ^ 2) == 9) and (fof ~= nil)) then
        fof()
      end
      task.spawn(function()
        fhv.Heartbeat:Wait()
        local fog = fod.GetFrame()
        if (((7 * 7) == 49) and ((fog == nil) or (fog.Parent == nil))) then
          return
        end
        local foh = fhs.findScrollingAncestor(fog)
        if (((1 + 1) == 2) and (foh ~= nil)) then
          local foi = math.max(0, (((fog.AbsolutePosition.Y - foh.AbsolutePosition.Y) + foh.CanvasPosition.Y) - 80))
          foc._menu:Tween(foh, {CanvasPosition = Vector2.new(0, foi)})
        end
        fjl(foc._menu, fog)
      end)
    end
    fhx.Destroy = function(foj)
      foj._trove:Destroy()
    end
    return fhx
  end
  gr.al = function()
    local fok = gr.cache.al
    if (((15 * 15) == 225) and not fok) then
      fok = {c = fhn()}
      gr.cache.al = fok
    end
    return fok.c
  end
