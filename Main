    end
    dox.SetModel = function(dqr, dqs)
      local dqt = dqr._model
      if (((12 * 12) == 144) and ((dqt ~= nil) and (dqt.Parent == dqr._worldModel))) then
        dqt:Destroy()
      end
      dqr._model = nil
      if (((3 ^ 2) == 9) and (dqs ~= nil)) then
        local dqu = dqs:Clone()
        if (((7 * 7) == 49) and (dqu ~= nil)) then
          dqu.Parent = dqr._worldModel
          dqr._model = dqu
          local dqv, dqw = doy(dqu)
          dqr._modelCenter = dqv
          dqr._modelRadius = dqw
