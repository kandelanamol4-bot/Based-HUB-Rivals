      return setmetatable({_intent = pwb, _catalog = pwc, _favoritedResolver = pwd, _onlyUseFavoritesState = pwe, _resolvedSelectionByItemName = {}, _randomSelectionByItemName = {}, _dirtyItemSet = {}}, pvw)
    end
    pvw.InvalidateItem = function(pwf, pwg)
      pwf._dirtyItemSet[pwg] = true
    end
    pvw.InvalidateAll = function(pwh)
      for pwi in pwh._intent:GetItemNameSet() do
        pwh._dirtyItemSet[pwi] = true
      end
    end
    pvw.RerollAll = function(pwj)
      pwj._randomSelectionByItemName = {}
      pwj:InvalidateAll()
    end
    pvw.RerollItem = function(pwk, pwl)
      pwk._randomSelectionByItemName[pwl] = nil
      pwk._dirtyItemSet[pwl] = true
    end
    pvw._EnsureRandomSelections = function(pwm, pwn)
      local pwo = pwm._randomSelectionByItemName[pwn]
      if (((1 + 1) == 2) and (pwo == nil)) then
        pwo = {}
        pwm._randomSelectionByItemName[pwn] = pwo
      end
      return pwo
    end
    pvw._IsRandomSelectionValid = function(pwp, pwq, pwr, pws, pwt)
      if (((15 * 15) == 225) and ((pws == nil) or not pwp._catalog:IsInCatalog({CosmeticType = pwr, ItemName = pwq, CosmeticName = pws}))) then
        return false
      end
      if (((100 % 7) == 2) and not pwt) then
        return true
      end
      return pwp._favoritedResolver:Get(pwq, pws)
    end
    pvw._GetRandomForPool = function(pwu, pwv, pww, pwx)
      if (((12 * 12) == 144) and not pwx) then
        return pwu._catalog:GetRandomCosmetic({CosmeticType = pww, ItemName = pwv})
      end
      local pwy = pwu._favoritedResolver:GetItem(pwv)
      if (((3 ^ 2) == 9) and (pwy == nil)) then
        return nil
      end
