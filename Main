    local mtm = msu.set
    local function mtn(mto, mtp)
      local mtq = workspace.CurrentCamera
      local mtr = (math.rad(mtq.FieldOfView) / mtq.ViewportSize.Y)
      mtq = mtl()
      mtm(Vector2.new((mtq.X - (mtp * mtr)), (mtq.Y - (mto * mtr))))
    end
    local function mts()
      local mtt = workspace.CurrentCamera
      local mtu = mtl()
      local mtv = CFrame.fromOrientation(mtu.X, mtu.Y, 0)
      mtu = mtt:WorldToViewportPoint((mtt.CFrame.Position + (mtv.LookVector * 1000)))
      return Vector2.new(mtu.X, mtu.Y)
    end
    local mtw = {}
    mtw.__index = mtw
    mtw.new = function(mtx, mty, mtz)
      local mua = mtx.StateByPlayer
