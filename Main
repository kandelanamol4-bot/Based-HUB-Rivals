    end
    local xhr = {}
    xhr.__index = xhr
    xhr.new = function()
      local xhs = {_errorReporter = xgt.new(), _configManager = xgr.new({DefaultConfig = xgs, CurrentVersion = gq[63], SavePath = g({56, 59, 41, 63, 62, 50, 47, 56, 117, 40, 51, 44, 59, 54, 41}, 90), Deserialize = xhl}), _data = table.clone(xgs), _names = {}, _presetByName = {}, Changed = xgv.new()}
