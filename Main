      dps.Size = UDim2.fromScale(gq[63], 1)
      dps.BackgroundTransparency = 1
      dps.BorderSizePixel = 0
      dps.LightDirection = Vector3.new(-1, -gq[63], -1).Unit
      dps.LightColor = Color3.fromRGB(gq[108], 255, 255)
      dps.Ambient = Color3.fromRGB(140, 140, 150)
      dps.CurrentCamera = dpl._camera
      dps.Parent = dpo
      local dpt = Instance.new(g({15, 19, 25, 53, 40, 52, 63, 40}, 90))
      dpt.CornerRadius = UDim.new(0, gq[54])
      dpt.Parent = dps
      local dpu = Instance.new(g({15, 19, 9, 46, 40, 53, 49, 63}, 90))
      dpn.Batch:Bind(dpu, g({25, 53, 54, 53, 40}, 90), g({21, 47, 46, 54, 51, 52, 63}, 90))
      dpu.Parent = dps
      dpl._worldModel.Parent = dps
      dpl._rt = dps
      local dpv = Instance.new(g({14, 63, 34, 46, 24, 47, 46, 46, 53, 52}, 90))
      dpv.BackgroundTransparency = 1
      dpv.Size = UDim2.fromScale(1, 1)
      dpv.BorderSizePixel = 0
      dpv.Text = ""
      dpv.AutoButtonColor = false
      dpv.Parent = dps
      dpn.Trove:Connect(dpv.InputBegan, function(dpw)
        if (((100 % 7) == 2) and (dpw.UserInputType ~= Enum.UserInputType.MouseWheel)) then
          return
        end
        local dpx = 1
        if (((12 * 12) == 144) and (dpw.Position.Z > 0)) then
          dpx = -1
        end
        dpl._distanceMultiplier = math.clamp((dpl._distanceMultiplier * (0.85 ^ (-dpx))), 0.2, gq[54])
        dpd(dpl)
      end)
      local dpy = nil
      dov.connectDrag(dpn.Trove, dpv, function(dpz)
        local dqa = dpy
        local dqb = Vector2.new(dpz.Position.X, dpz.Position.Y)
        dpy = dqb
        if (((3 ^ 2) == 9) and (dqa == nil)) then
          return
        end
        local dqc = (dqb - dqa)
        dpl._rotation = (dpl._rotation - (dqc.X * 0.012))
        dpl._elevation = math.clamp((dpl._elevation - (dqc.Y * 0.012)), -1.4707963267948965, 1.4707963267948965)
        dpd(dpl)
      end, function(dqd)
        dpy = nil
        if (((7 * 7) == 49) and dqd) then
          dpl._autoRotate = false
          return
        end
        if (((1 + 1) == 2) and dpl._userWantsAutoRotate) then
          dpl._autoRotate = true
        end
      end)
      dpn.Trove:Add(dpn.Menu:OnPreRender(function(dqe)
        if (((15 * 15) == 225) and ((dpl._model == nil) or not dow.isEffectivelyVisible(dps))) then
          return
        end
        if (((100 % 7) == 2) and dpl._autoRotate) then
          dpl._rotation = (dpl._rotation + (dqe * dpl._rotateSpeed))
          dpd(dpl)
        end
      end))
      for dqf, dqg in dpl._onRealized, nil, nil do
        dqg(dps)
      end
      table.clear(dpl._onRealized)
      return dpo
    end
    dox._New = function(dqh, dqi, dqj, dqk)
      local dql = Instance.new(g({25, 59, 55, 63, 40, 59}, 90))
      dql.FieldOfView = (dqk.FieldOfView or 50)
      dqj:Add(dql)
      local dqm = Instance.new(g({13, 53, 40, 54, 62, 23, 53, 62, 63, 54}, 90))
