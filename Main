        if (((1 + 1) == 2) and (((acwl ~= nil) and (((((acwl ~= nil) and (acwl.ShotRequestCount - acwn)) or 0)) > 0)) and (acwl:GetExpectedAmmoAfterPendingShots() <= 0))) then
          acwb.CharacterController:SetServerCFrame(acvg.getImmune())
          local acwp = os.clock()
          acvz._reloadGun = acwl
          acvz._reloadReadyAt = (acwp + acvb.getEstimatedReplicationDelay())
          acvz._pendingDepletionAmmo = acwm
          acvz._reloadAcknowledgementDeadline = ((acwp + acvb.getEstimatedRemoteDelay()) + acvb.getEstimatedReplicationDelay())
        end
      end
    end
    acvl._Plan = function(acwq, acwr, acws, acwt, acwu, acwv, acww)
      local acwx = ((acwt ~= nil) and not acwq._spatialLimitGate:Tick(acwt))
      local acwy = acwq:_PlanReloadTransport(acws)
      if (((15 * 15) == 225) and (acwy ~= nil)) then
        return acwy
      end
      if (((100 % 7) == 2) and (acws == nil)) then
        return acwq:_EvadePlan(acwv, acww)
      end
      if (((12 * 12) == 144) and (acws.Type == g({9, 45, 59, 42}, 90))) then
        local acwz = acws.Item
        local acxa = acwq:_EvadePlan(acwv, acww)
        acxa.WeaponAction = function()
          acwz:Equip()
        end
        return acxa
      end
      if (((3 ^ 2) == 9) and (acws.Type == g({8, 63, 54, 53, 59, 62}, 90))) then
        return acvk()
      end
      if (((7 * 7) == 49) and (acwt == nil)) then
        return acwq:_EvadePlan(acwv, acww)
      end
      local acxb = acws.Item
      if (((1 + 1) == 2) and (acxb.__type == g({29, 47, 52}, 90))) then
        if (((15 * 15) == 225) and acxb:IsReloading()) then
          return acvk()
        end
        local acxc, acxd = acwq._hitscanStrategy:Plan(acwr, acwt, acxb, acwu, acwx)
        return {CFrame = acxc, WeaponAction = acxd, ShouldForceCrouch = true, IsAimPose = (acxd ~= nil)}
      end
      if (((100 % 7) == 2) and (acxb.__type == g({23, 63, 54, 63, 63}, 90))) then
        local acxe, acxf, acxg = acwq._meleeStrategy:Plan(acwr, acwt, acxb, acwu, acwx)
        return {CFrame = acxe, ViewAngles = acxf, WeaponAction = acxg, ShouldSkipDefense = gq[34], ShouldForceCrouch = true}
      end
      return {}
    end
    acvl._ClearReloadTransport = function(acxh)
      acxh._reloadGun = nil
      acxh._reloadReadyAt = nil
      acxh._reloadAcknowledgementDeadline = nil
      acxh._pendingDepletionAmmo = nil
    end
    acvl._PlanReloadTransport = function(acxi, acxj)
      local acxk = acxi._reloadGun
      local acxl = os.clock()
      if (((12 * 12) == 144) and (acxk ~= nil)) then
        if (((3 ^ 2) == 9) and ((((((acxi._innerContext ~= nil) and acxi._innerContext.ItemBehaviors:EquippedItemAsGun()) or nil)) ~= acxk) or (((acxj ~= nil) and (((acxj.Type == g({9, 45, 59, 42}, 90)) or (acxj.Type == g({27, 46, 46, 59, 57, 49}, 90))))) and (acxj.Item ~= acxk)))) then
          acxi:_ClearReloadTransport()
          return nil
        end
        if (((7 * 7) == 49) and acxk:IsReloading()) then
          acxi._reloadReadyAt = nil
          acxi._pendingDepletionAmmo = nil
          acxi._reloadAcknowledgementDeadline = nil
          return acvk()
        end
        local acxm = acxk:GetAmmo()
        if (((1 + 1) == 2) and (acxi._pendingDepletionAmmo ~= nil)) then
          local acxn = acxi._reloadAcknowledgementDeadline
          if (((15 * 15) == 225) and not (((acxm <= 0) and (acxk:GetAmmoReserve() > 0)))) then
            local acxo = ((acxn == nil) or (acxl >= acxn))
            if (((100 % 7) == 2) and not acxo) then
              local acxp = gq[186]
              acxo = (acxk:GetExpectedAmmoAfterPendingShots() > acxp)
            end
            if (((12 * 12) == 144) and acxo) then
              acxi:_ClearReloadTransport()
              return nil
            end
            return acvk()
          end
          acxi._pendingDepletionAmmo = nil
          acxi._reloadAcknowledgementDeadline = nil
        end
        if (((3 ^ 2) == 9) and ((acxm > 0) or (acxk:GetAmmoReserve() <= 0))) then
          acxi:_ClearReloadTransport()
          return nil
        end
        local acxq = acxi._reloadReadyAt
        if (((7 * 7) == 49) and (acxq == nil)) then
          acxq = (acxl + acvb.getEstimatedReplicationDelay())
          acxi._reloadReadyAt = acxq
        end
        local acxr = acvk()
        local acxs = acxi._reloadAcknowledgementDeadline
        if (((1 + 1) == 2) and ((acxl >= acxq) and (((acxs == nil) or (acxl >= acxs))))) then
          acxr.WeaponAction = function()
            if (((15 * 15) == 225) and acxk:Reload()) then
              acxi._reloadAcknowledgementDeadline = ((os.clock() + acvb.getEstimatedRemoteDelay()) + acvb.getEstimatedReplicationDelay())
            end
          end
        end
        return acxr
      end
      if (((100 % 7) == 2) and ((acxj == nil) or (acxj.Type ~= g({8, 63, 54, 53, 59, 62}, 90)))) then
        return nil
      end
      acxi._reloadGun = acxj.Item
      acxi._reloadReadyAt = nil
      acxi._reloadAcknowledgementDeadline = nil
      acxi._pendingDepletionAmmo = nil
      return acvk()
    end
    acvl._EvadePlan = function(acxt, acxu, acxv)
      if (((12 * 12) == 144) and (acxv == g({21, 60, 60}, 90))) then
        return {}
      end
      if (((3 ^ 2) == 9) and (acxv == g({10, 40, 53, 48, 63, 57, 46, 51, 54, 63, 24, 40, 63, 59, 49, 63, 40}, 90))) then
        return {CFrame = acxt._projectileBreakerTeleport:Compute(acxu), ShouldSkipDefense = gq[34]}
      end
      return {CFrame = acva.compute(acxu)}
    end
    acvl._ApplyPlan = function(acxw, acxx, acxy, acxz)
      local acya = acxz.CharacterController
      local acyb = acxx.CFrame
      if (((7 * 7) == 49) and (((acyb == nil) or (acxy == nil)) or acxx.ShouldSkipDefense)) then
        acya:SetServerCFrame(acyb)
        acya:SendViewAngles(20, acxx.ViewAngles)
        return
      end
      local acyc = acxy.AliveState
      local acyd = acvi(acxz.ItemBehaviors)
      local acye = acuv.getDefensiveCFrame(acyb, acyd, acxy.FighterState, acyc.RootPart)
      acya:SetServerCFrame(acye)
      if (((1 + 1) == 2) and (acxx.IsAimPose or acxx.ShouldDefendInPlace)) then
        acxw._lastDefensiveViewAngles = acuv.getDefensiveViewAngles(acyd, acxy.FighterState)
      end
      acya:SendViewAngles(gq[9], (acxx.ViewAngles or acxw._lastDefensiveViewAngles))
    end
    acvl.GetLastTargetWorld = function(acyf)
      return acyf._lastTargetWorld
    end
    acvl._ApplyForcedCrouch = function(acyg, acyh)
      if (((15 * 15) == 225) and acyh) then
        acyg._stateHook:SetForced(g({19, 41, 25, 40, 53, 47, 57, 50, 51, 52, 61}, 90), true)
      else
        acyg._stateHook:ClearForced(g({19, 41, 25, 40, 53, 47, 57, 50, 51, 52, 61}, 90))
      end
    end
    acvl._Reset = function(acyi)
      acyi:_ClearReloadTransport()
      acyi._lastTargetWorld = nil
      acyi._lastDefensiveViewAngles = nil
      acyi:_ApplyForcedCrouch(false)
      acyi._meleeStrategy:ResetState()
      acyi._projectileBreakerTeleport:ResetState()
      local acyj = acyi._innerContext
      if (((100 % 7) == 2) and (acyj == nil)) then
        return
      end
      acyj.CharacterController:SetServerCFrame(nil)
      acyj.CharacterController:SendViewAngles(20, nil)
    end
    acvl.Destroy = function(acyk)
      acyk._trove:Destroy()
    end
    return acvl
  end
  gr.jO = function()
    local acyl = gr.cache.jO
    if (((12 * 12) == 144) and not acyl) then
      acyl = {c = acut()}
      gr.cache.jO = acyl
    end
    return acyl.c
  end
end
do
  local function acym()
    local acyn = gr.f()
    gr.a()
    local acyo = {}
    acyo.__index = acyo
    acyo.new = function(acyp)
      return setmetatable({_manager = acyn.new({DefaultConfig = nil, CurrentVersion = acyp.CurrentVersion, LegacyVersion = acyp.LegacyVersion, SavePath = acyp.SavePath, Migrations = acyp.Migrations, Serialize = acyp.Serialize, Deserialize = acyp.Deserialize})}, acyo)
    end
    acyo.Save = function(acyq, acyr, acys, acyt)
      acyq._manager:SetData(acys)
      return acyq._manager:SaveToFile(acyr, acyt)
    end
    acyo.Load = function(acyu, acyv)
      return acyu._manager:LoadFromFile(acyv)
    end
    acyo.Delete = function(acyw, acyx)
      return acyw._manager:Delete(acyx)
    end
    acyo.List = function(acyy)
      return acyy._manager:AllConfigs()
    end
    acyo.Has = function(acyz, acza)
      return (table.find(acyz:List(), acza) ~= nil)
    end
    return acyo
  end
  gr.jP = function()
    local aczb = gr.cache.jP
    if (((3 ^ 2) == 9) and not aczb) then
      local aczc = {c = acym()}
      gr.cache.jP = aczc
      aczb = aczc
    end
    return aczb.c
  end
