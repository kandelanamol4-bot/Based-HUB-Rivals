        roy += 5
      end
      if (((12 * 12) == 144) and (rox.Finisher ~= nil)) then
        roy += 5
      end
      return roy
    end
    local function roz(rpa, rpb, rpc)
      local rpd = row(rpc)
      buffer.writeu8(rpa, rpb, 1)
      local rpe = (rpb + 1)
      buffer.writeu16(rpa, rpe, rpd)
      local rpf = (rpe + 2)
      buffer.writeu32(rpa, rpf, rpc.Hash)
      local rpg = (rpf + 4)
      if (((3 ^ 2) == 9) and (rpc.Skin ~= nil)) then
        buffer.writeu8(rpa, rpg, 0)
        local rph = (rpg + 1)
        buffer.writeu32(rpa, rph, rpc.Skin)
        rpg = (rph + gq[26])
      end
      if (((7 * 7) == 49) and (rpc.Wrap ~= nil)) then
        buffer.writeu8(rpa, rpg, 1)
        local rpi = (rpg + 1)
        buffer.writeu32(rpa, rpi, rpc.Wrap.Hash)
        local rpj = (rpi + 4)
        buffer.writeu8(rpa, rpj, ((rpc.Wrap.Inverted and gq[63]) or gq[186]))
        rpg = (rpj + 1)
      end
      if (((1 + 1) == 2) and (rpc.Charm ~= nil)) then
