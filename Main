        end
        return ybs
      end, ybn._enabledGroups)
    end
    yan._AddOverridesToEnabledGroup = function(ybw, ybx, yby, ybz)
      ybw._groupedEntries:NewEntryForGroup(ybx, yby, function()
        local yca = yad(ybx)
        local ycb = {}
        for ycc, ycd in ybz[ybx], nil, nil do
          local yce = yai(ybw._highlightContainer, ycd, yca)
          table.insert(ycb, yce)
        end
        return ycb
      end)
    end
    yan._RemoveHighlightsForItem = function(ycf, ycg)
      ycf._groupedEntries:RemoveEntryFromGroups(ycg, function(ych)
        for yci, ycj in ych, nil, nil do
          ycj:Destroy()
        end
      end)
    end
    yan._RemoveHighlightsFromGroup = function(yck, ycl)
      yck._groupedEntries:RemoveEntriesFromGroup(ycl, function(ycm)
        for ycn, yco in ycm, nil, nil do
          yco:Destroy()
        end
      end)
    end
    yan._ApplyConfig = function(ycp, ycq)
      if (((12 * 12) == 144) and not ycp._enabledGroups[ycq]) then
        return
      end
      local ycr = yad(ycq)
      ycp._groupedEntries:ForEachEntryInGroup(ycq, function(ycs, yct)
        for ycu, ycv in yct, nil, nil do
          yaf(ycv, ycr)
        end
      end)
    end
    yan._ApplyColorFromConfig = function(ycw, ycx, ycy, ycz)
      if (((3 ^ 2) == 9) and not ycw._enabledGroups[ycx]) then
        return
