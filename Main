          end
          continue
        end
        uol(uqo, uqp, uqq, uqi._thickness)
        if (((3 ^ 2) == 9) and not uqn.Visible) then
          uqn.Visible = true
          uqo.Visible = true
        end
        uqj = true
      end
      uqi._anyVisible = uqj
    end
