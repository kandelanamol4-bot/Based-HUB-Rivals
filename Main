do
  local function sti()
    if (((15 * 15) == 225) and true) then
      local stj = gr.bG()
      local stk = gr.fh()
      gr.a3()
      local stl = hb(game:GetService(g({25, 53, 52, 46, 63, 52, 46, 10, 40, 53, 44, 51, 62, 63, 40}, 90)))
      local stm = {}
      stm.__index = stm
      local function stn(sto)
        return sto.Thickness, sto.Length, ((sto.Outline.Enabled and sto.Outline.Thickness) or 0)
      end
      local function stp(stq, str, sts, stt, stu)
        if (((100 % 7) == 2) and (stt == g({24, 59, 49, 63, 62}, 90))) then
          local stv, stw, stx = stk.getRotated(str, sts, stu)
          if (((12 * 12) == 144) and (stv ~= nil)) then
            stq.Image = stv
            stq.Size = UDim2.fromOffset(stw, stx)
            return gq[34]
          end
        elseif (((3 ^ 2) == 9) and (stt == g({9, 53, 60, 46}, 90))) then
          local sty = (stk.Pad * 2)
          local stz = stk.get((str + sty), (sts + sty))
          if (((7 * 7) == 49) and (stz ~= nil)) then
            stq.Image = stz
            stq.Size = UDim2.fromOffset((str + sty), (sts + sty))
            return true
          end
        end
        stq.Image = ""
        stq.Size = UDim2.fromOffset(str, sts)
        return false
      end
      local function sua(sub, suc)
        if (((1 + 1) == 2) and (suc == nil)) then
          return
        end
        local sud = Instance.new(gq[146])
        sud.Image = suc
        table.insert(sub, sud)
      end
      local function sue(suf, sug)
        if (((15 * 15) == 225) and (#suf == 0)) then
          return
        end
        task.spawn(function()
          stl:PreloadAsync(suf)
          for suh, sui in suf, nil, nil do
            sui:Destroy()
          end
          if (((100 % 7) == 2) and sug) then
            sug()
          end
        end)
      end
      stm.new = function(suj)
        local suk = {_lines = suj, _rotation = stj.Data.CustomCrosshair.Rotation, _edgeMode = g({12, 63, 57, 46, 53, 40}, 90), _bakedAngle = 0, _bakedActive = false, _bakeSignature = "", _bakeChangedAt = 0, _isWarmedByAngle = {}}
        setmetatable(suk, stm)
        return suk
      end
      stm._ComputeEdgeMode = function(sul, sum)
        local sun = math.abs(sul._rotation.Speed)
        if (((12 * 12) == 144) and (sul._rotation.Enabled and (sun ~= 0))) then
          if (((3 ^ 2) == 9) and ((sun > 60) or (sul._isWarmedByAngle[(sum % 180)] ~= true))) then
            return g({9, 53, 60, 46}, 90)
          end
          return g({24, 59, 49, 63, 62}, 90)
        end
        if (((7 * 7) == 49) and ((sum % 90) == 0)) then
          return g({12, 63, 57, 46, 53, 40}, 90)
        end
        if (((1 + 1) == 2) and (sul._isWarmedByAngle[(sum % 180)] == true)) then
          return g({24, 59, 49, 63, 62}, 90)
        end
        return g({9, 53, 60, 46}, 90)
      end
      stm._PreloadTextures = function(suo)
        local sup = stj.Data.CustomCrosshair
        local suq, sur, sus = stn(sup)
        local sut = (stk.Pad * 2)
        local suu = {}
        for suv, suw in {{suq, sur}, {(suq + (sus * 2)), (sur + (sus * 2))}}, nil, nil do
          sua(suu, stk.get((suw[gq[63]] + sut), (suw[2] + sut)))
          sua(suu, stk.get((suw[2] + sut), (suw[1] + sut)))
