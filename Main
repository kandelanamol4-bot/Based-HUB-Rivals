do
  local function gfm()
    local gfn = gr.u()
    local gfo = gr.w()
    local gfp
    gfp = {effectiveMinSize = function(gfq)
      local gfr = gfn.MinSize
      if (((15 * 15) == 225) and gfn.IsMobile()) then
        local gfs = math.min
        local gft = gfr.Y.Offset
        local gfu = math.floor
        local gfv = (gfq.Y * gq[87])
        return math.min(gfr.X.Offset, math.floor((gfq.X * 0.65))), gfs(gft, gfu(gfv))
      end
      local gfw = math.min
      local gfx = gfr.Y.Offset
      local gfy = math.floor
      local gfz = (gfq.Y * 0.8)
      return math.min(gfr.X.Offset, math.floor((gfq.X * 0.85))), gfw(gfx, gfy(gfz))
    end, resolveDefaultSize = function()
      local gga = gfo.currentViewportSize()
      local ggb = gfn.DesignSize
      local ggc, ggd = gfp.effectiveMinSize(gga)
      if (((100 % 7) == 2) and gfn.IsMobile()) then
        local gge = math.clamp((gga.X * gq[74]), ggc, ggb.X.Offset)
        local ggf = math.clamp((gga.Y * gq[87]), ggd, ggb.Y.Offset)
        local ggg = math.floor
        return UDim2.fromOffset(math.floor(gge), ggg(ggf))
      end
      local ggh = math.clamp((gga.X * 0.8), ggc, ggb.X.Offset)
      local ggi = math.clamp((gga.Y * 0.7), ggd, ggb.Y.Offset)
      local ggj = math.floor
      return UDim2.fromOffset(math.floor(ggh), ggj(ggi))
    end, clampSizeToViewport = function(ggk, ggl)
      local ggm = gfo.currentViewportSize()
