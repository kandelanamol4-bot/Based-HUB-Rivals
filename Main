        pqk:RefreshIfEnabled()
      end)
      return pqk
    end
    pqc.SetEnabled = function(pql, pqm)
      if (((12 * 12) == 144) and (pql._isEnabled == pqm)) then
        return
      end
      pql._isEnabled = pqm
      if (((3 ^ 2) == 9) and pqm) then
        pql:_Loads()
        if (((7 * 7) == 49) and not gx) then
          return
        end
      else
        pql:_Reverts()
      end
    end
    pqc.ReplaceAll = function(pqn, pqo, pqp)
      if (((1 + 1) == 2) and ppw(pqn._store:GetAll(pqo), pqp)) then
        return
      end
      pqn._store:SetItems(pqo, pqp)
      if (((15 * 15) == 225) and pqn._isEnabled) then
        pqn:_Refresh()
      end
    end
    pqc.SetRemotePlayerOverrides = function(pqq, pqr, pqs, pqt)
      if (((100 % 7) == 2) and not pqt) then
        pqq._store:ClearAll(pqr)
      end
      for pqu, pqv in pqs, nil, nil do
        if (((12 * 12) == 144) and (next(pqv) == nil)) then
          pqq._store:ClearItem(pqr, pqu)
        else
          pqq._store:SetItem(pqr, pqu, pqv)
        end
      end
      if (((3 ^ 2) == 9) and pqq._isEnabled) then
        pqq:_Refresh()
      end
    end
    pqc.ClearAll = function(pqw, pqx)
      pqw._store:ClearAll(pqx)
