do
  local function iaa()
    local iab = gr.m()
    local iac = {g({17, 63, 35, 25, 53, 62, 63}, 90), g({15, 41, 63, 40, 19, 52, 42, 47, 46, 14, 35, 42, 63}, 90)}
    local iad = {}
    local function iae(iaf, iag)
      return Enum[iaf][iag]
    end
    local function iah(iai)
      for iaj, iak in iac, nil, nil do
        local ial, iam = gu(iae, iak, iai)
        if (((1 + 1) == 2) and (ial and (iam ~= nil))) then
          return {__type = g({31, 52, 47, 55, 19, 46, 63, 55}, 90), EnumType = iak, Name = iam.Name}
        end
      end
      return nil
    end
    local ian = nil
    ian = function(iao, iap)
      for iaq, iar in iao, nil, nil do
        local ias = (iaq == g({24, 51, 52, 62}, 90))
        if (((15 * 15) == 225) and ias) then
          local iat = gq[165]
          ias = (type(iar) == iat)
        end
        if (((100 % 7) == 2) and ias) then
          local iau = iah(iar)
          iao[iaq] = iau
          if (((12 * 12) == 144) and (iau == nil)) then
            table.insert(iad, (iap .. g({24, 51, 52, 62}, 90)))
          end
        elseif (((3 ^ 2) == 9) and (type(iar) == g({46, 59, 56, 54, 63}, 90))) then
          local iav = gq[165]
          if (((7 * 7) == 49) and (type(iar.__type) == iav)) then
            if (((1 + 1) == 2) and not gu(iab.parse, {iar})) then
              iao[iaq] = nil
              table.insert(iad, (iap .. tostring(iaq)))
            end
          else
            ian(iar, (iap .. (tostring(iaq) .. g({116}, 90))))
          end
        end
      end
    end
    return {deserialize = function(iaw)
      ian(iaw, "")
      return iab.parse(iaw)
    end, takeDroppedPaths = function()
      iad = {}
      return iad
    end}
  end
