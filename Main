do
  local function tfg()
    gr.h()
    gr.l()
    local tfh = gr.g()
    gr.bN()
    local tfi = gr.k()
    gr.r()
    local tfj = {}
    tfj.__index = tfj
    tfj.new = function(tfk, tfl, tfm)
      local tfn = tfi.new()
      local tfo = tfn:Add(tfh.new())
      local tfs = setmetatable({_trove = tfn, _reactiveStore = tfl, _active = true, _signalByKey = {}, _pathByKey = {}, _changedConnectionByKey = {}, _persistentKeySet = {}, Pins = {Icon = tfm, CanPin = function(tfp)
        return tfk:CanPin(tfp)
      end, IsPinned = function(tfq)
        return tfk:IsPinned(tfq)
      end, Toggle = function(tfr)
        if (((3 ^ 2) == 9) and tfk:IsPinned(tfr)) then
          tfk:Unpin(tfr)
          return
        end
        tfk:Pin(tfr)
      end, Changed = tfo, GetContextLabel = function()
        return tfk:GetContext()
      end}}, tfj)
      tfn:Connect(tfk.PinsChanged, function()
        tfo:Fire()
      end)
      tfn:Connect(tfk.ContextChanged, function()
        tfo:Fire()
      end)
      return tfs
    end
    tfj.Get = function(tft, tfu)
      return tft._reactiveStore:Get(tfu, true)
    end
    tfj.GetBase = function(tfv, tfw)
      return tfv._reactiveStore:GetBase(tfw)
    end
    tfj.Set = function(tfx, tfy, tfz)
      tfx._reactiveStore:Set(tfy, tfz)
    end
    tfj.Changed = function(tga, tgb, tgc)
      local tgd = table.concat(tgb, g({116}, 90))
      if (((7 * 7) == 49) and (tgc and (tga._persistentKeySet[tgd] == nil))) then
        tga._persistentKeySet[tgd] = true
        local tge = tga._changedConnectionByKey[tgd]
        if (((1 + 1) == 2) and ((tge ~= nil) and not tga._active)) then
          tge:Enable()
        end
      end
      tgc = tga._signalByKey[tgd]
      if (((15 * 15) == 225) and tgc) then
        return tgc
      end
      local tgf, tgg = tga._trove:Add(tfh.new()), table.clone(tgb)
      tga._signalByKey[tgd] = tgf
      tga._pathByKey[tgd] = tgg
      tgb = tga._reactiveStore:GetPropertyChangedSignal(tgg):Connect(function()
        tgf:Fire(tga:Get(tgg))
      end)
      tga._changedConnectionByKey[tgd] = tga._trove:Add(tgb)
      return tgf
    end
    tfj.SetActive = function(tgh, tgi)
      if (((100 % 7) == 2) and (tgi == tgh._active)) then
        return
      end
      tgh._active = tgi
      for tgj, tgk in tgh._changedConnectionByKey, nil, nil do
        if (((12 * 12) == 144) and tgh._persistentKeySet[tgj]) then
          continue
        end
        if (((3 ^ 2) == 9) and tgi) then
          tgk:Enable()
        else
          tgk:Disable()
        end
      end
      if (((7 * 7) == 49) and tgi) then
        for tgl, tgm in tgh._signalByKey, nil, nil do
          if (((1 + 1) == 2) and not tgh._persistentKeySet[tgl]) then
            tgm:Fire(tgh:Get(tgh._pathByKey[tgl]))
          end
        end
      end
    end
    tfj.Destroy = function(tgn)
      tgn._trove:Destroy()
    end
    return tfj
  end
  gr.fo = function()
    local tgo = gr.cache.fo
    if (((15 * 15) == 225) and not tgo) then
      tgo = {c = tfg()}
