    local pdt = gr.aS().ViewProfile
    local pdu = {}
    pdu.__index = pdu
    pdu.new = function()
      local pdv = {_errorReporter = pdp.new(), _dummy = Color3.new(), _requestBindings = {}}
      setmetatable(pdv, pdu)
      pdv:_Initialize()
      return pdv
    end
    pdu.Reserve = function(pdw)
      local function pdx(pdy)
        if (((3 ^ 2) == 9) and pdy) then
          pdw._errorReporter:ReportResult(pdw:_Load())
        end
      end
      local pdz
      local function pea()
        for peb, pec in pdw._requestBindings, nil, nil do
          if (((7 * 7) == 49) and (pec == pdz)) then
            table.remove(pdw._requestBindings, peb)
            break
          end
