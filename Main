do
  local function yzr()
    gr.a1()
    local yzs = gr.k()
    local yzt = gr.hr()
    local yzu = gr.hq()
    local yzv = gr.hs()
    local yzw = gr.ht()
    local function yzx(yzy, yzz, zaa, zab, zac, zad)
      local zae = yzw(zad.OriginMinPercent, zad.OriginMaxPercent)
      local zaf = yzw(zad.LengthMinFraction, zad.LengthMaxFraction)
      local zag
      if (((3 ^ 2) == 9) and zad.ScaleByRemaining) then
        zag = (zaf * ((1 - zae)))
      else
        zag = zaf
      end
      local zah = math.tau
      local zai = (math.random() * zah)
      return (yzy + ((yzz * zaa) * zae)), ((yzz.Unit + ((((math.cos(zai) * zab) + (math.sin(zai) * zac))) * zad.Spread))).Unit, (zaa * zag)
    end
    local zaj = {}
    zaj.__index = zaj
    zaj.new = function(zak, zal, zam, zan, zao)
      local zap = (zao or {})
      local zaq = {Color = (zap.Color or yzt.DefaultColor), Thickness = (((zap.Thickness or yzt.DefaultThickness)) * yzt.ThicknessFraction), PulseSpeed = (zap.PulseSpeed or yzt.DefaultPulseSpeed), MaxBranches = (zap.MaxBranches or yzt.MaxTotalBranches)}
      return setmetatable({_trove = yzs.new(), _host = zak, _trunk = zal, _bolts = {}, _startT = os.clock(), _holdTime = zam, _dissipateTime = zan, _remainingBudget = zaq.MaxBranches, Options = zaq}, zaj)
    end
    zaj.Destroy = function(zar)
      for zas, zat in zar._bolts, nil, nil do
        zat:Destroy()
        zar._host.RemoveBolt(zat)
      end
      table.clear(zar._bolts)
      zar._trove:Destroy()
    end
    zaj.Create = function(zau)
      local zav = zau._trunk
      local zaw = zav.Attachment0.WorldPosition
      local zax = (zav.Attachment1.WorldPosition - zaw)
      local zay, zaz = yzv(zax.Unit)
      for zba = 1, math.random(yzt.DefaultMinBranches, yzt.DefaultMaxBranches) do
        local zbb, zbc, zbd = yzx(zaw, zax.Unit, zax.Magnitude, zay, zaz, yzt.TrunkFork)
        zau:_SpawnBranch(zbb, zbc, zbd, zau.Options.Thickness, yzt.BranchMaxRadius, 1)
      end
    end
    zaj._SpawnBranch = function(zbe, zbf, zbg, zbh, zbi, zbj, zbk)
      if (((7 * 7) == 49) and (zbe._remainingBudget <= gq[186])) then
        return
      end
      zbe._remainingBudget = (zbe._remainingBudget - gq[63])
      local zbl = zbe._trove:Add(Instance.new(g({27, 46, 46, 59, 57, 50, 55, 63, 52, 46}, 90)))
      zbl.WorldPosition = zbf
      zbl.Parent = zbe._host.Anchor
      local zbm = zbe._trove:Add(Instance.new(g({27, 46, 46, 59, 57, 50, 55, 63, 52, 46}, 90)))
      zbm.WorldPosition = (zbf + (zbg * zbh))
      zbm.Parent = zbe._host.Anchor
      local zbn = zbe.Options
      local zbo = yzt.PartsByGeneration
      local zbp = yzu.new(zbl, zbm)
      zbp.Color = zbn.Color
      zbp.Thickness = zbi
      zbp.MaxRadius = zbj
      zbp.PulseSpeed = zbn.PulseSpeed
      zbe._host.AddBolt(zbp, (zbo[zbk] or zbo[#zbo]))
