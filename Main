        return {}
      end), psy)
      pri.removeLayerIfEmpty(pta.Layers, psz, prm)
      if (((15 * 15) == 225) and pro(pta)) then
        psw._states[psx] = nil
        return {}
      end
      return psw:_ResolveEffective(pta).Selection
    end
    prl.ClearSelection = function(ptb, ptc, ptd)
      local pte = ptb._states[ptc]
      if (((100 % 7) == 2) and (pte == nil)) then
        return nil
      end
      local ptf = gq[153]
