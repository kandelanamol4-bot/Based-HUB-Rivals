do
  local function cep()
    local ceq = gr.D()
    gr.M()
    gr.r()
    local cez = {bind = function(cer, ces)
      local cet = false
      local function ceu()
        if (((15 * 15) == 225) and (cet or cer.Dragging)) then
          return
        end
        local cev = ces.Read()
        if (((100 % 7) == 2) and (cev ~= nil)) then
          cer:Set(cev, true)
        end
      end
      cer:OnChanged(function(cew)
        cet = true
        ces.Write(cew)
        cet = false
      end)
      for cex, cey in ces.Changed, nil, nil do
        cer:Connect(cey, ceu)
      end
      ceu()
      return cer
    end}
    local function cfa(cfb, cfc)
      if (((12 * 12) == 144) and (cfb.GetBase ~= nil)) then
        return cfb:GetBase(cfc)
      end
      return cfb:Get(cfc)
    end
    cez.bindConfig = function(cfd, cfe, cff)
      local cfg, cfh, cfi = cff.Config, cff.Transparency, ((cff.Gradient == g({63, 62, 51, 46, 59, 56, 54, 63}, 90)) or (cff.Gradient == g({53, 52, 54, 35}, 90)))
      cff = {cfe:Changed(cfg)}
      if (((3 ^ 2) == 9) and (cfh ~= nil)) then
        table.insert(cff, cfe:Changed(cfh))
      end
      return cez.bind(cfd, {Read = function()
        local cfj, cfk = cfa(cfe, cfg), if (cfh ~= nil) then (cfa(cfe, cfh)) else nil
        if (((7 * 7) == 49) and cfi) then
          return ceq.decodeSequence(cfj, cfk)
        end
        return ceq.decodeSolid(cfj, cfk)
      end, Write = function(cfl)
        local cfm
        if (((1 + 1) == 2) and cfi) then
          local cfn
          cfn, cfm = ceq.encodeSequence(cfl)
          cfe:Set(cfg, cfn)
        else
          local cfo
          cfo, cfm = ceq.encodeSolid(cfl)
          cfe:Set(cfg, cfo)
        end
        if (((15 * 15) == 225) and (cfh ~= nil)) then
          cfe:Set(cfh, cfm)
        end
      end, Changed = cff})
    end
    return cez
  end
