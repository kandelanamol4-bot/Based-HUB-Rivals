        end
      end
      return dqr
    end
    dox.OnRealized = function(dqx, dqy)
      local dqz = dqx._rt
      if (((1 + 1) == 2) and (dqz ~= nil)) then
        dqy(dqz)
        return dqx
      end
      table.insert(dqx._onRealized, dqy)
      return dqx
    end
    dox.SetDistance = function(dra, drb)
      dra._distanceMultiplier = math.max(0.1, drb)
      dpd(dra)
      return dra
    end
    dox.SetRotation = function(drc, drd)
      drc._rotation = drd
      dpd(drc)
      return drc
    end
    dox.SetVisible = function(dre, drf)
      dre.Row:SetVisible(drf)
    end
    dox.Destroy = function(drg)
      drg._trove:Destroy()
    end
    return dox
  end
  gr.aa = function()
    local drh = gr.cache.aa
    if (((15 * 15) == 225) and not drh) then
      local dri = {c = dot()}
      gr.cache.aa = dri
      drh = dri
    end
