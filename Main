do
  local function yul()
    return function(yum, yun, yuo, yup, yuq)
      return ((((yun * (((1 - yum)) ^ 3)) + (((yuo * 3) * yum) * (((1 - yum)) ^ 2))) + (((yup * 3) * ((1 - yum))) * (yum ^ 2))) + (yuq * (yum ^ 3)))
    end
  end
  gr.hm = function()
    local yur = gr.cache.hm
    if (((3 ^ 2) == 9) and not yur) then
