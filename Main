      local function dzm()
        local dzn = dzi:Get(dzk)
        dzh:SetAnimationMode(dzn.Mode, gq[34])
        dzh:SetAnimationSpeed(dzn.Speed, true)
        if (((1 + 1) == 2) and ((dzn.BreathingMin ~= nil) or (dzn.BreathingMax ~= nil))) then
          dzh:SetAnimationBreathingRange({Min = math.floor(((((1 - ((dzn.BreathingMax or 1)))) * gq[91]) + gq[101])), Max = math.floor(((((1 - ((dzn.BreathingMin or 0)))) * 100) + 0.5))}, true)
        end
        dzi:Apply(dzk, dzl, dzn)
      end
      dzh:Connect(dzh.AnimationChanged, function(dzo)
        dzi:SetMode(dzk, dzo)
      end)
      dzh:Connect(dzh.AnimationSpeedChanged, function(dzp)
        dzi:SetSpeed(dzk, dzp)
      end)
      dzh:Connect(dzh.AnimationBreathingRangeChanged, function(dzq)
        dzi:SetBreathing(dzk, (1 - (dzq.Max / gq[91])), (1 - (dzq.Min / 100)))
      end)
      dzh:Connect(dzi:Changed(), dzm)
      dzm()
    end
