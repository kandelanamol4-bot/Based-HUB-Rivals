          suo:_PreloadBakedAngle(sup.Rotation.Angle)
        end
      end
      stm._PreloadBakedAngle = function(sux, suy)
        local suz = (suy % 180)
        sux._isWarmedByAngle[suz] = false
        local sva = sux._bakeSignature
        local svb, svc, svd = stn(stj.Data.CustomCrosshair)
