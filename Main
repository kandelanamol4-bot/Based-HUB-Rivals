      itx:Connect(itu.PlayerRemoved, itw)
      return itx
    end
    itm.GetPlayers = function(itz)
      local iua = {}
      for iub in itz._playerSet, nil, nil do
        table.insert(iua, iub)
      end
      return iua
    end
