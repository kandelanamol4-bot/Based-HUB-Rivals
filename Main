        ywt.CFrame = (CFrame.lookAt((ywx + (((ywy - ywx)) * ((math.max(0, yww) + (0.5 * ((1 - math.abs(yww)))))))), ywy) * yvn.XInverse)
        ywt.Transparency = (1 - yxc)
        return true
      end
