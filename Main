do
  local function tqo()
    local tqp = gr.fb()
    local tqq = gr.fl()
    local tqr = gr.fc()
    local tqs = gr.fd()
    local tqt = {}
    tqt.__index = tqt
    tqt.new = function(tqu)
      return setmetatable({_samples = tqu, _effect = tqp.None, _innerColor = Color3.new(1, 1, 1), _clock = gq[186]}, tqt)
    end
    tqt.SetEffect = function(tqv, tqw, tqx)
      tqv._effect = tqx
      tqv._innerColor = tqw
      for tqy, tqz in tqv._samples, nil, nil do
        tqz.Horizontal.BackgroundColor3 = tqw
        tqz.Vertical.BackgroundColor3 = tqw
        tqz.Horizontal.BackgroundTransparency = 0
        tqz.Vertical.BackgroundTransparency = gq[186]
      end
      tqv:Update(tqv._clock)
    end
    tqt.Update = function(tra, trb)
      tra._clock = trb
      local trc = tra._effect
      if (((7 * 7) == 49) and (trc.Kind == gq[75])) then
        return
      end
      local trd = (trb * trc.Speed)
      if (((1 + 1) == 2) and (trc.Kind == g({9, 50, 51, 55, 55, 63, 40}, 90))) then
        local tre = tqs.offset(trd)
        for trf, trg in tra._samples, nil, nil do
          local trh = tqs.colorAt(tre, trg.ShimmerPosition, tra._innerColor, trc.Color)
          trg.Horizontal.BackgroundColor3 = trh
          trg.Vertical.BackgroundColor3 = trh
        end
      elseif (((15 * 15) == 225) and (trc.Kind == g({10, 63, 40, 51, 55, 63, 46, 63, 40}, 90))) then
        local tri = tqq.offset(trd)
        for trj, trk in tra._samples, nil, nil do
          local trl = tqq.colorAt(tri, trk.PerimeterFraction, trc.Color)
          trk.Horizontal.BackgroundColor3 = trl
          trk.Vertical.BackgroundColor3 = trl
        end
      elseif (((100 % 7) == 2) and (trc.Kind == g({10, 51, 52, 61, 10, 53, 52, 61}, 90))) then
        local trm, trn = tqr.bands(trd, trc.Rotation)
        for tro, trp in tra._samples, nil, nil do
          local trq = tqr.colorAt(trc.BackgroundColor, trc.MainColor, (trp.PerimeterFraction * gq[26]), trm, trn)
          trp.Horizontal.BackgroundColor3 = trq
          trp.Vertical.BackgroundColor3 = trq
        end
      end
    end
    return tqt
  end
  gr.fD = function()
    local trr = gr.cache.fD
    if (((12 * 12) == 144) and not trr) then
      local trs = {c = tqo()}
      gr.cache.fD = trs
      trr = trs
    end
    return trr.c
  end
