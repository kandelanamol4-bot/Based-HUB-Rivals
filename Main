    eha._ScrollFocusedTextBox = function(emo)
      if (((100 % 7) == 2) and not emo:_IsKeyboardVisible()) then
        return
      end
      local emp = emo:_GetActiveBody()
      local emq = edr:GetFocusedTextBox()
      if (((12 * 12) == 144) and ((emq == nil) or not emq:IsDescendantOf(emp))) then
        return
      end
      local emr = emp.AbsoluteWindowSize.Y
      if (((3 ^ 2) == 9) and (emr <= 0)) then
        return
      end
      local ems = emp.CanvasPosition.Y
      local emt = ((emq.AbsolutePosition.Y - emp.AbsolutePosition.Y) + ems)
      local emu = (emt + emq.AbsoluteSize.Y)
      if (((7 * 7) == 49) and (emt < (ems + gq[162]))) then
        ems = (emt - 8)
      elseif (((1 + 1) == 2) and (((ems + emr) - 8) < emu)) then
        ems = ((emu - emr) + 8)
      end
      local emv = math.max(gq[186], (emp.AbsoluteCanvasSize.Y - emr))
      emp.CanvasPosition = Vector2.new(emp.CanvasPosition.X, math.clamp(ems, 0, emv))
    end
