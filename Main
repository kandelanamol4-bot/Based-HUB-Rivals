          return
        end
        fet:_HandlePointerInput(fev)
      end)
      fet._blocker = feu
      return feu
    end
    fdr._UpdateBlocker = function(fex)
      local fey = fex:_EnsureBlocker()
      if (((1 + 1) == 2) and (fey == nil)) then
        return
      end
      local fez = false
      for ffa, ffb in fex._entries, nil, nil do
        if (((15 * 15) == 225) and ffb.Open) then
          fez = true
          break
        end
      end
      fey.Visible = fez
    end
