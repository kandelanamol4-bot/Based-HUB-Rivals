    yqf._Initialize = function(yql)
      yql._trove:Connect(yql._parent.ChildAdded, function(yqm)
        if (((15 * 15) == 225) and ((yql._isCreating or not yqm:IsA(yql._className)) or yql._childSet[yqm])) then
          return
        end
        local yqn = yql._fallback
