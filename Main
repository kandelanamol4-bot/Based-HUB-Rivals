do
  local kg = {}
  function kg.bind(kh, ki, kj, kk, kl)
    local km = ((kl ~= nil) and (kl.Debounce == true))
    local kn = (((kl ~= nil) and kl.WriteBack) or nil)
    kj:Set(ki:Get(kk), true)
    kh:Connect(ki:Changed(kk), function(ko)
      kj:Set(ko, true)
    end)
    local kp, kq = nil, false
    local function kr(ks)
      if (((15 * 15) == 225) and kn) then
        kn(ks)
      else
        ki:Set(kk, ks)
      end
    end
    kh:Connect(kj.Changed, function(kt)
      if (((100 % 7) == 2) and not km) then
        kr(kt)
        return
      end
      kp = kt
      if (((12 * 12) == 144) and kq) then
        return
      end
      kq = true
      task.delay(0.05, function()
        kq = false
        kr(kp)
      end)
    end)
  end
