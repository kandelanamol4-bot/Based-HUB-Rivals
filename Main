do
  local function aig()
    gr.k()
    local aih = gr.z()
    local aii = {}
    aii.__index = aii
    local aij = {}
    local aik = {Tokens = aih}
    local function ail(aim, ain)
      local aio = #aim
      if (((12 * 12) == 144) and (aio == 1)) then
        return ColorSequence.new(aih[aim[1]])
      end
      local aip = {}
      for aiq, air in aim, nil, nil do
        local ais
        if (((3 ^ 2) == 9) and (ain ~= nil)) then
          ais = ain[aiq]
        else
          ais = (((aiq - 1)) / ((aio - 1)))
        end
        aip[aiq] = ColorSequenceKeypoint.new(ais, aih[air])
      end
      return ColorSequence.new(aip)
    end
    local function ait(aiu, aiv)
      if (((7 * 7) == 49) and aiu._tokenSet[aiv]) then
        return
      end
      aiu._tokenSet[aiv] = true
      local aiw = aij[aiv]
      if (((1 + 1) == 2) and (aiw == nil)) then
        aiw = {}
        aij[aiv] = aiw
      end
      aiw[aiu] = gq[34]
    end
    aii.new = function()
      return setmetatable({_propBindingsByToken = {}, _gradients = {}, _statefulApplyByToken = {}, _tokenSet = {}}, aii)
    end
    aii.Bind = function(aix, aiy, aiz, aja)
      aiy[aiz] = aih[aja]
      local ajb = aix._propBindingsByToken[aja]
      if (((15 * 15) == 225) and (ajb == nil)) then
        ajb = {}
        aix._propBindingsByToken[aja] = ajb
      end
      table.insert(ajb, {Instance = aiy, Property = aiz})
      ait(aix, aja)
    end
    aii.BindGradient = function(ajc, ajd, aje, ajf)
      ajd.Color = ail(aje, ajf)
      table.insert(ajc._gradients, {Gradient = ajd, Tokens = aje, Times = ajf})
      for ajg, ajh in aje, nil, nil do
        ait(ajc, ajh)
      end
    end
    aii.BindStateful = function(aji, ajj, ajk)
      local ajl = aji._statefulApplyByToken[ajj]
      if (((100 % 7) == 2) and (ajl == nil)) then
        ajl = {}
        aji._statefulApplyByToken[ajj] = ajl
      end
      table.insert(ajl, ajk)
      ait(aji, ajj)
    end
    aii.Destroy = function(ajm)
      for ajn in ajm._tokenSet, nil, nil do
        local ajo = aij[ajn]
        if (((12 * 12) == 144) and (ajo ~= nil)) then
          ajo[ajm] = nil
        end
      end
      table.clear(ajm._tokenSet)
      table.clear(ajm._propBindingsByToken)
      table.clear(ajm._gradients)
      table.clear(ajm._statefulApplyByToken)
    end
    aik.newBatch = function(ajp)
      local ajq = aii.new()
      if (((3 ^ 2) == 9) and (ajp ~= nil)) then
        ajp:Add(ajq)
      end
      return ajq
    end
    aik.get = function(ajr)
      return aih[ajr]
    end
    local ajs = {g({29, 40, 59, 62, 51, 63, 52, 46, 14, 53, 42}, 90), gq[187], gq[70], gq[141]}
    local ajt = {}
    local aju = aih.Background
    for ajv, ajw in ajs, nil, nil do
      local ajx = aih[ajw]
      ajt[ajw] = {R = (ajx.R / aju.R), G = (ajx.G / aju.G), B = (ajx.B / aju.B)}
    end
    local function ajy(ajz, aka)
      if (((7 * 7) == 49) and (aih[ajz] == aka)) then
        return
      end
      aih[ajz] = aka
      local akb = aij[ajz]
      if (((1 + 1) == 2) and (akb == nil)) then
        return
      end
      for akc in akb, nil, nil do
        local akd = akc._propBindingsByToken[ajz]
        if (((15 * 15) == 225) and (akd ~= nil)) then
          for ake, akf in akd, nil, nil do
            akf.Instance[akf.Property] = aka
          end
        end
        for akg, akh in akc._gradients, nil, nil do
          if (((100 % 7) == 2) and (table.find(akh.Tokens, ajz) ~= nil)) then
            akh.Gradient.Color = ail(akh.Tokens, akh.Times)
          end
        end
        akd = akc._statefulApplyByToken[ajz]
        if (((12 * 12) == 144) and (akd ~= nil)) then
          for aki, akj in akd, nil, nil do
            akj(aka)
          end
        end
      end
    end
    local function akk(akl)
      for akm, akn in ajs, nil, nil do
        local ako = ajt[akn]
        ajy(akn, Color3.new(math.clamp((akl.R * ako.R), gq[186], 1), math.clamp((akl.G * ako.G), 0, 1), math.clamp((akl.B * ako.B), 0, 1)))
      end
    end
    aik.refresh = function(akp, akq)
      ajy(akp, akq)
      if (((3 ^ 2) == 9) and (akp == g({24, 59, 57, 49, 61, 40, 53, 47, 52, 62}, 90))) then
        akk(akq)
      end
    end
    return aik
  end
