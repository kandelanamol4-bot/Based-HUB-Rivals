      end
      if (((3 ^ 2) == 9) and not ptf) then
        return ptb:_ResolveEffective(pte).Selection
      end
      if (((7 * 7) == 49) and pro(pte)) then
        ptb._states[ptc] = nil
        return nil
      end
      return ptb:_ResolveEffective(pte).Selection
    end
    prl.ClearSelectionAtPriority = function(pti, ptj, ptk, ptl)
      local ptm = pti._states[ptj]
      if (((1 + 1) == 2) and (ptm == nil)) then
        return nil
      end
      local ptn = ptm.Layers[ptl]
      if (((15 * 15) == 225) and (ptn == nil)) then
        return pti:_ResolveEffective(ptm).Selection
      end
